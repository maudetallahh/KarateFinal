@{
    Layout = null;
    var clubs = ViewBag.ArchivedClubs as List<KarateFinal.Models.Club>;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الأرشيف</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; font-family:'Segoe UI',Tahoma,sans-serif; }
        body { background:#0f1923; color:#f1f5f9; min-height:100vh; }
        nav { background:#1a2535; border-bottom:2px solid #3b82f6; padding:12px 20px; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:100; }
        .nav-title { font-size:16px; font-weight:700; }
        .back-btn { background:rgba(59,130,246,0.15); color:#3b82f6; border:1px solid rgba(59,130,246,0.3); padding:7px 16px; border-radius:8px; text-decoration:none; font-size:13px; font-weight:700; }
        .container { max-width:1100px; margin:24px auto; padding:0 20px; }
        .section-hd { display:flex; align-items:center; justify-content:space-between; margin-bottom:16px; }
        .table-wrap { background:#1a2535; border:1px solid #2d3f55; border-radius:12px; overflow:hidden; overflow-x:auto; }
        .tbl-toolbar { padding:12px 16px; border-bottom:1px solid #2d3f55; display:flex; gap:8px; align-items:center; }
        .tbl-toolbar input { padding:6px 10px; border-radius:6px; border:1px solid #2d3f55; background:#0f1923; color:#f1f5f9; font-family:inherit; font-size:12px; width:220px; }
        table { width:100%; border-collapse:collapse; min-width:500px; }
        thead th { padding:10px 14px; font-size:11px; font-weight:700; color:#94a3b8; text-align:right; background:#223044; border-bottom:1px solid #2d3f55; }
        tbody tr { border-bottom:1px solid #2d3f55; }
        tbody tr:hover { background:rgba(255,255,255,0.03); }
        tbody td { padding:10px 14px; font-size:12px; }
        .empty { text-align:center; color:#94a3b8; padding:40px; font-size:13px; }
    </style>
<link rel="stylesheet" href="/css/dark.css"><script>function applyTheme(t){const l=t==='light';document.body.style.setProperty('background',l?'#f0f4f8':'#0f1923','important');document.body.style.setProperty('color',l?'#1e2a38':'#f1f5f9','important');document.querySelectorAll('.').forEach(b=>b.textContent=l?'☀️':'🌙');localStorage.setItem('theme',t);}function toggleTheme(){applyTheme(localStorage.getItem('theme')==='light'?'dark':'light');}document.addEventListener('DOMContentLoaded',()=>applyTheme(localStorage.getItem('theme')||'dark'));</script></head>
<body>
    <nav>
        <div class="nav-title">🗃️ أرشيف الأندية المحذوفة</div>
        <a href="/Admin/Index" class="back-btn">← الرئيسية</a>
    </nav>
    <div class="container">
        <div class="section-hd">
            <h3>الأندية المحذوفة</h3>
        </div>
        <div class="table-wrap">
            <div class="tbl-toolbar">
                <input type="text" id="search" placeholder="ابحث..." oninput="filter()">
                <span id="count" style="font-size:11px;color:#94a3b8;"></span>
            </div>
            <table>
                <thead><tr><th>#</th><th>اسم النادي</th><th>المسؤول</th><th>المدينة</th><th>التصنيف</th><th>تاريخ الحذف</th><th>بواسطة</th></tr></thead>
                <tbody id="body">
                    @if (clubs != null && clubs.Any())
                    {
                        int i = 1;
                        foreach (var c in clubs)
                        {
                            <tr>
                                <td>@i</td>
                                <td>@c.Name</td>
                                <td>@c.ManagerName</td>
                                <td>@c.City</td>
                                <td>@c.Category</td>
                                <td>@(c.DeletedAt?.ToString("yyyy/MM/dd") ?? "—")</td>
                                <td>@(c.DeletedByAdmin ?? "—")</td>
                            </tr>
                            i++;
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="empty">لا توجد أندية محذوفة</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <script>
        function filter() {
            const q = document.getElementById('search').value.toLowerCase();
            const rows = document.querySelectorAll('#body tr');
            let count = 0;
            rows.forEach(row => { const show = row.textContent.toLowerCase().includes(q); row.style.display = show ? '' : 'none'; if(show) count++; });
            document.getElementById('count').textContent = count + ' نادٍ';
        }
        filter();
    </script>
@await Html.PartialAsync("_Footer")</body>
</html>