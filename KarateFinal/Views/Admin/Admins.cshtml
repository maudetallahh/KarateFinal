@{
    Layout = null;
    var admins = ViewBag.Admins as List<KarateFinal.Models.User>;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>المشرفون</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; font-family:'Segoe UI',Tahoma,sans-serif; }
        body { background:#0f1923; color:#f1f5f9; min-height:100vh; }
        nav { background:#1a2535; border-bottom:2px solid #3b82f6; padding:12px 20px; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:100; }
        .nav-title { font-size:16px; font-weight:700; }
        .back-btn { background:rgba(59,130,246,0.15); color:#3b82f6; border:1px solid rgba(59,130,246,0.3); padding:7px 16px; border-radius:8px; text-decoration:none; font-size:13px; font-weight:700; }
        .container { max-width:800px; margin:24px auto; padding:0 20px; }
        .section-hd { display:flex; align-items:center; justify-content:space-between; margin-bottom:16px; }
        .btn { display:inline-flex; align-items:center; gap:6px; padding:8px 14px; border-radius:8px; border:none; font-family:inherit; font-size:12px; font-weight:700; cursor:pointer; }
        .btn-primary { background:#3b82f6; color:#fff; }
        .btn-danger { background:#ef4444; color:#fff; }
        .btn-sm { padding:5px 10px; font-size:11px; border-radius:6px; }
        .table-wrap { background:#1a2535; border:1px solid #2d3f55; border-radius:12px; overflow:hidden; }
        table { width:100%; border-collapse:collapse; }
        thead th { padding:10px 16px; font-size:11px; font-weight:700; color:#94a3b8; text-align:right; background:#223044; border-bottom:1px solid #2d3f55; }
        tbody tr { border-bottom:1px solid #2d3f55; }
        tbody tr:hover { background:rgba(255,255,255,0.03); }
        tbody td { padding:10px 16px; font-size:12px; }
        .modal-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.7); z-index:1000; align-items:center; justify-content:center; }
        .modal-overlay.show { display:flex; }
        .modal { background:#1a2535; border:1px solid #2d3f55; border-radius:16px; width:400px; max-width:95%; padding:24px; }
        .form-group { display:flex; flex-direction:column; gap:5px; margin-bottom:14px; }
        .form-group label { font-size:11px; font-weight:700; color:#94a3b8; }
        .form-group input { padding:8px 10px; border-radius:8px; border:1px solid #2d3f55; background:#0f1923; color:#f1f5f9; font-family:inherit; font-size:12px; }
        .badge-main { background:rgba(245,158,11,0.15); color:#f59e0b; border:1px solid rgba(245,158,11,0.3); padding:2px 8px; border-radius:20px; font-size:10px; font-weight:700; }
    </style>
<link rel="stylesheet" href="/css/dark.css"><link rel="stylesheet" href="/css/dark.css"></head>
<body>
    <nav>
        <div class="nav-title">👑 المشرفون</div>
        <a href="/Admin/Index" class="back-btn">← الرئيسية</a>
    </nav>
    <div class="container">
        <div class="section-hd">
            <h3 style="font-size:16px;font-weight:700;">إدارة المشرفين</h3>
            <button class="btn btn-primary" onclick="document.getElementById('addModal').classList.add('show')">➕ إضافة مشرف</button>
        </div>
        <div class="table-wrap">
            <table>
                <thead><tr><th>#</th><th>اسم المستخدم</th><th>آخر دخول</th><th>النوع</th><th>إجراءات</th></tr></thead>
                <tbody>
                    @if (admins != null)
                    {
                        int i = 1;
                        foreach (var a in admins)
                        {
                            var isMain = a.Username == "AdminKarate2";
                            <tr>
                                <td>@i</td>
                                <td><strong>@a.Username</strong></td>
                                <td>@(a.LastLogin?.ToString("yyyy/MM/dd HH:mm") ?? "—")</td>
                                <td>@(isMain ? "<span class='badge-main'>رئيسي</span>" : "مشرف")</td>
                                <td>
                                    @if (!isMain)
                                    {
                                        <button class="btn btn-danger btn-sm" onclick="deleteAdmin(@a.Id)">🗑️ حذف</button>
                                    }
                                </td>
                            </tr>
                            i++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="modal-overlay" id="addModal">
        <div class="modal">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
                <h3 style="font-size:15px;font-weight:700;">➕ إضافة مشرف جديد</h3>
                <button onclick="document.getElementById('addModal').classList.remove('show')" style="background:none;border:none;color:#94a3b8;cursor:pointer;font-size:20px;">×</button>
            </div>
            <div class="form-group"><label>اسم المستخدم *</label><input type="text" id="newUsername" placeholder="admin2"></div>
            <div class="form-group"><label>كلمة المرور *</label><input type="password" id="newPassword" placeholder="كلمة المرور"></div>
            <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:16px;">
                <button onclick="document.getElementById('addModal').classList.remove('show')" style="background:#2d3f55;color:#94a3b8;border:none;padding:8px 16px;border-radius:8px;cursor:pointer;">إلغاء</button>
                <button onclick="addAdmin()" style="background:#10b981;color:white;border:none;padding:8px 16px;border-radius:8px;cursor:pointer;font-weight:700;">💾 إضافة</button>
            </div>
        </div>
    </div>
    <script>
        function addAdmin() {
            const username = document.getElementById('newUsername').value.trim();
            const password = document.getElementById('newPassword').value.trim();
            if (!username || !password) { alert('يرجى تعبئة جميع الحقول'); return; }
            fetch('/Admin/AddAdmin', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ username, password }) })
                .then(r => r.json()).then(data => {
                    if (data.success) { alert('✅ تم إضافة المشرف'); location.reload(); }
                    else alert('⚠️ ' + data.message);
                });
        }
        function deleteAdmin(id) {
            if (!confirm('هل أنت متأكد من حذف هذا المشرف؟')) return;
            fetch('/Admin/DeleteAdmin', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id }) })
                .then(r => r.json()).then(data => {
                    if (data.success) location.reload();
                    else alert('⚠️ ' + data.message);
                });
        }
        document.getElementById('addModal').addEventListener('click', function(e) { if (e.target === this) this.classList.remove('show'); });
    </script>
</body>
</html>