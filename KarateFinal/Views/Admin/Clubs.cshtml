@{
    Layout = null;
    var clubs = ViewBag.Clubs as List<KarateFinal.Models.Club>;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الأندية</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; font-family:'Segoe UI',Tahoma,sans-serif; }
        body { background:#0f1923; color:#f1f5f9; min-height:100vh; }
        nav { background:#1a2535; border-bottom:2px solid #3b82f6; padding:12px 20px; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:100; }
        .nav-title { font-size:16px; font-weight:700; }
        .back-btn { background:rgba(59,130,246,0.15); color:#3b82f6; border:1px solid rgba(59,130,246,0.3); padding:7px 16px; border-radius:8px; text-decoration:none; font-size:13px; font-weight:700; }
        .container { max-width:1100px; margin:24px auto; padding:0 20px; }
        .section-hd { display:flex; align-items:center; justify-content:space-between; margin-bottom:16px; flex-wrap:wrap; gap:8px; }
        .btn { display:inline-flex; align-items:center; gap:6px; padding:8px 14px; border-radius:8px; border:none; font-family:inherit; font-size:12px; font-weight:700; cursor:pointer; text-decoration:none; }
        .btn-primary { background:#3b82f6; color:#fff; }
        .btn-success { background:#10b981; color:#fff; }
        .btn-danger { background:#ef4444; color:#fff; }
        .btn-info { background:rgba(59,130,246,0.15); color:#3b82f6; border:1px solid rgba(59,130,246,0.3); }
        .btn-sm { padding:5px 10px; font-size:11px; border-radius:6px; }
        .table-wrap { background:#1a2535; border:1px solid #2d3f55; border-radius:12px; overflow:hidden; overflow-x:auto; }
        .tbl-toolbar { padding:12px 16px; border-bottom:1px solid #2d3f55; display:flex; gap:8px; align-items:center; }
        .tbl-toolbar input { padding:6px 10px; border-radius:6px; border:1px solid #2d3f55; background:#0f1923; color:#f1f5f9; font-family:inherit; font-size:12px; width:220px; }
        table { width:100%; border-collapse:collapse; min-width:500px; }
        thead th { padding:10px 14px; font-size:11px; font-weight:700; color:#94a3b8; text-align:right; background:#223044; border-bottom:1px solid #2d3f55; }
        tbody tr { border-bottom:1px solid #2d3f55; }
        tbody tr:hover { background:rgba(255,255,255,0.03); }
        tbody td { padding:10px 14px; font-size:12px; }
        .modal-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.7); z-index:1000; align-items:center; justify-content:center; padding:16px; }
        .modal-overlay.show { display:flex; }
        .modal { background:#1a2535; border:1px solid #2d3f55; border-radius:16px; width:520px; max-width:100%; max-height:90vh; overflow-y:auto; padding:24px; }
        .form-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
        .form-grid .full { grid-column:1/-1; }
        .form-group { display:flex; flex-direction:column; gap:5px; }
        .form-group label { font-size:11px; font-weight:700; color:#94a3b8; }
        .form-group input, .form-group select { padding:8px 10px; border-radius:8px; border:1px solid #2d3f55; background:#0f1923; color:#f1f5f9; font-family:inherit; font-size:12px; }
    </style>
<link rel="stylesheet" href="/css/dark.css"><link rel="stylesheet" href="/css/dark.css"><script src="/js/theme.js"></script><script src="/js/theme.js"></script><script src="/js/theme.js"></script></head>
<body>
    <nav>
        <div class="nav-title">🏟️ إدارة الأندية</div>
        <a href="/Admin/Index" class="back-btn">← الرئيسية</a>
    </nav>
    <div class="container">
        <div class="section-hd">
            <h3>الأندية المسجّلة</h3>
            <div style="display:flex;gap:8px;">
                <a href="/Admin/ExportClubsExcel" class="btn btn-success">📊 Excel</a>
                <button class="btn btn-primary" onclick="document.getElementById('clubModal').classList.add('show')">➕ إضافة نادي</button>
            </div>
        </div>
        <div class="table-wrap">
            <div class="tbl-toolbar">
                <input type="text" id="clubSearch" placeholder="ابحث..." oninput="filterClubs()">
                <span id="clubsCount" style="font-size:11px;color:#94a3b8;margin-right:8px;"></span>
            </div>
            <table>
                <thead><tr><th>#</th><th>اسم النادي</th><th>المسؤول</th><th>المدينة</th><th>التصنيف</th><th>إجراءات</th></tr></thead>
                <tbody id="clubsBody">
                    @if (clubs != null)
                    {
                        int i = 1;
                        foreach (var c in clubs)
                        {
                            <tr>
                                <td>@i</td>
                                <td>@c.Name</td>
                                <td>@c.ManagerName</td>
                                <td>@c.City</td>
                                <td>@c.Category</td>
                                <td style="display:flex;gap:4px;">
                                    <button class="btn btn-info btn-sm" onclick="showClubDetails(@c.Id,'@c.Name','@c.ManagerName')">📋</button>
                                    <a href="/Admin/ClubMessages?clubId=@c.Id" class="btn btn-info btn-sm">💬</a>
                                    <a href="/Admin/DeleteClub/@c.Id" class="btn btn-danger btn-sm" onclick="return confirm('هل أنت متأكد؟')">🗑️</a>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="modal-overlay" id="clubModal">
        <div class="modal">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
                <h3 style="font-size:15px;font-weight:700;">➕ إضافة نادي</h3>
                <button onclick="document.getElementById('clubModal').classList.remove('show')" style="background:none;border:none;color:#94a3b8;cursor:pointer;font-size:20px;">×</button>
            </div>
            <form method="post" action="/Admin/AddClub">
                <div class="form-grid">
                    <div class="form-group full"><label>اسم النادي *</label><input type="text" name="Name" required></div>
                    <div class="form-group full"><label>اسم المسؤول *</label><input type="text" name="ManagerName" required></div>
                    <div class="form-group"><label>المدينة *</label><select name="City" required><option value="">-- اختر --</option><option>نابلس</option><option>رام الله</option><option>القدس</option><option>الخليل</option><option>جنين</option><option>طولكرم</option><option>بيت لحم</option><option>غزة</option><option>أريحا</option></select></div>
                    <div class="form-group"><label>التصنيف *</label><select name="Category" required><option value="">-- اختر --</option><option value="A">A</option><option value="B">B</option><option value="C">C</option></select></div>
                    <div class="form-group full"><label>البريد الإلكتروني *</label><input type="email" name="Email" required></div>
                    <div class="form-group full"><label>رقم الهاتف *</label><input type="tel" name="Phone" required></div>
                    <div class="form-group"><label>سنة التأسيس</label><input type="number" name="FoundedYear" min="1900" max="2026"></div>
                </div>
                <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:16px;">
                    <button type="button" onclick="document.getElementById('clubModal').classList.remove('show')" style="background:#2d3f55;color:#94a3b8;border:none;padding:8px 16px;border-radius:8px;cursor:pointer;">إلغاء</button>
                    <button type="submit" class="btn btn-success">💾 حفظ</button>
                </div>
            </form>
        </div>
    </div>
    <div class="modal-overlay" id="clubDetailsModal">
        <div class="modal">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
                <h3 style="font-size:15px;font-weight:700;">📋 تفاصيل النادي</h3>
                <button onclick="document.getElementById('clubDetailsModal').classList.remove('show')" style="background:none;border:none;color:#94a3b8;cursor:pointer;font-size:20px;">×</button>
            </div>
            <div class="form-group" style="margin-bottom:12px;"><label>اسم النادي</label><input type="text" id="detailName" readonly style="background:#223044;"></div>
            <div class="form-group" style="margin-bottom:16px;"><label>اسم المسؤول</label><input type="text" id="detailManager" readonly style="background:#223044;"></div>
            <div class="form-group">
                <label>🔑 إعادة تعيين كلمة المرور</label>
                <div style="display:flex;gap:8px;margin-top:6px;">
                    <input type="text" id="newPasswordInput" placeholder="كلمة مرور جديدة" style="flex:1;">
                    <button class="btn btn-primary" onclick="resetClubPassword()">تغيير</button>
                </div>
            </div>
            <div style="display:flex;justify-content:flex-end;margin-top:16px;">
                <button onclick="document.getElementById('clubDetailsModal').classList.remove('show')" style="background:#2d3f55;color:#94a3b8;border:none;padding:8px 16px;border-radius:8px;cursor:pointer;">إغلاق</button>
            </div>
        </div>
    </div>
    <script>
        let currentClubId = null;
        function filterClubs() {
            const q = document.getElementById('clubSearch').value.toLowerCase();
            const rows = document.querySelectorAll('#clubsBody tr');
            let count = 0;
            rows.forEach(row => { const show = row.textContent.toLowerCase().includes(q); row.style.display = show ? '' : 'none'; if(show) count++; });
            document.getElementById('clubsCount').textContent = count + ' نادٍ';
        }
        function showClubDetails(id, name, manager) {
            currentClubId = id;
            document.getElementById('detailName').value = name;
            document.getElementById('detailManager').value = manager;
            document.getElementById('newPasswordInput').value = '';
            document.getElementById('clubDetailsModal').classList.add('show');
        }
        function resetClubPassword() {
            const newPass = document.getElementById('newPasswordInput').value.trim();
            if (!newPass) { alert('أدخل كلمة مرور جديدة'); return; }
            fetch('/Admin/ResetClubPassword', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ clubId: currentClubId, newPassword: newPass }) })
                .then(r => r.json()).then(data => { if (data.success) alert('✅ تم تغيير كلمة المرور'); });
        }
        document.querySelectorAll('.modal-overlay').forEach(o => o.addEventListener('click', function(e) { if (e.target === this) this.classList.remove('show'); }));
        filterClubs();
    </script>
</body>
</html>