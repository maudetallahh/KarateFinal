                <div class="table-wrap">
                    <div class="tbl-toolbar"><input type="text" id="clubSearch" placeholder="ابحث عن نادٍ..." oninput="filterClubs()"><span class="tbl-count" id="clubsCount"></span></div>
                    <table>
                        <thead><tr><th>#</th><th>اسم النادي</th><th>المسؤول</th><th>المدينة</th><th>التصنيف</th><th>إجراءات</th></tr></thead>
                        <tbody id="clubsTableBody">
                            @if (ViewBag.Clubs != null)
                            {
                                int i = 1; foreach (var c in ViewBag.Clubs)
                                {
                                    <tr><td>@i</td><td>@c.Name</td><td>@c.ManagerName</td><td>@c.City</td><td>@c.Category</td><td style="display:flex;gap:4px;flex-wrap:wrap;"><button class="btn btn-info btn-sm" onclick="showClubDetails(@c.Id,'@c.Name','@c.ManagerName')">📋</button><a href="/Admin/DeleteClub/@c.Id" class="btn btn-danger btn-sm" onclick="return confirm('هل أنت متأكد؟')">🗑️</a></td></tr>
                                    i++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- PLAYERS -->
            <div class="page @(activePage=="players"?"active":"")" id="page-players">
                <div class="section-hd"><h3>اللاعبون</h3><a href="/Admin/ExportPlayersExcel" class="btn btn-success">📊 تصدير Excel</a></div>
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>#</th><th>الاسم</th><th>النادي</th><th>الحزام</th><th>العمر</th><th>إجراءات</th></tr></thead>
                        <tbody>
                            @if (ViewBag.Players != null)
                            {
                                int i = 1; foreach (var p in ViewBag.Players)
                                {
                                    <tr><td>@i</td><td>@p.Name</td><td>@(ViewBag.Clubs != null ? ((IEnumerable<dynamic>)ViewBag.Clubs).FirstOrDefault(c => c.Id == p.ClubId)?.Name ?? "—" : "—")</td><td>@p.Belt</td><td>@p.Age</td><td><a href="/Club/PlayerCard?id=@p.Id" class="btn btn-info btn-sm">🪪</a></td></tr>
                                    i++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- TOURNAMENTS -->
            <div class="page @(activePage=="tournaments"?"active":"")" id="page-tournaments">
                <div class="section-hd"><h3>البطولات</h3><button class="btn btn-primary" onclick="document.getElementById('tournamentModal').classList.add('show')">➕ إضافة بطولة</button></div>
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>#</th><th>اسم البطولة</th><th>التاريخ</th><th>المدينة</th><th>إجراءات</th></tr></thead>
                        <tbody>
                            @if (ViewBag.Tournaments != null)
                            {
                                int i = 1; foreach (var t in ViewBag.Tournaments)
                                {
                                    <tr><td>@i</td><td>@t.Title</td><td>@t.Date.ToString("yyyy-MM-dd")</td><td>@t.City</td><td style="display:flex;gap:4px;flex-wrap:wrap;"><button class="btn btn-info btn-sm" onclick="showTournamentDetails(@t.Id)">📋</button><button class="btn btn-sm @(t.RegistrationClosed?"btn-success":"btn-danger")" onclick="toggleTournamentReg(@t.Id)">@(t.RegistrationClosed ? "🔓" : "🔒")</button><button class="btn btn-info btn-sm" onclick="showEditTournament(@t.Id,'@t.Title','@t.Date.ToString("yyyy-MM-dd")','@t.City','@(t.Location??"")','@(t.Description??"")' ,@t.RegistrationFee,@t.MaxPlayersPerClub,'@(t.Categories??"")')">✏️</button><a href="/Admin/DeleteTournament/@t.Id" class="btn btn-danger btn-sm" onclick="return confirm('هل أنت متأكد؟')">🗑️</a></td></tr>
                                    i++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- PARTICIPATIONS -->
            <div class="page @(activePage=="participations"?"active":"")" id="page-participations">
                <div class="section-hd">
                    <h3>المشاركات</h3><div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
                        <select id="yearFilter" onchange="filterByYear()" style="padding:6px 12px;border-radius:6px;border:1px solid var(--border);background:var(--bg);color:var(--text);font-family:'Cairo',sans-serif;font-size:12px;">
                            @for (int y = DateTime.Now.Year; y >= 2020; y--)
                            {
                                <option value="@y">@y</option>
                            }<option value="0">كل السنوات</option></select><a href="/Admin/AddParticipation" class="btn btn-primary">➕ إضافة نتيجة</a></div></div>
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>#</th><th>النادي</th><th>البطولة</th><th>المركز</th><th>النقاط</th><th>السنة</th><th>إجراءات</th></tr></thead>
                        <tbody id="participationsBody">
                            @if (ViewBag.Participations != null)
                            {
                                int i = 1; foreach (var p in ViewBag.Participations)
                                {
                                    var medal = p.Rank == 1 ? "🥇" : p.Rank == 2 ? "🥈" : p.Rank == 3 ? "🥉" : ""; var year = p.GetType().GetProperty("Year") != null ? (int)p.Year : DateTime.Now.Year;
                                    <tr data-year="@year"><td>@i</td><td>@(ViewBag.Clubs != null ? ((IEnumerable<dynamic>)ViewBag.Clubs).FirstOrDefault(c => c.Id == p.ClubId)?.Name ?? "—" : "—")</td><td>@(ViewBag.Tournaments != null ? ((IEnumerable<dynamic>)ViewBag.Tournaments).FirstOrDefault(t => t.Id == p.TournamentId)?.Title ?? "—" : "—")</td><td>@medal @p.Rank</td><td>@p.Points ⭐</td><td>@year</td><td><a href="/Admin/DeleteParticipation/@p.Id" class="btn btn-danger btn-sm" onclick="return confirm('هل أنت متأكد؟')">🗑️</a></td></tr>
                                    i++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- MEMBERSHIPS -->
            <div class="page @(activePage=="memberships"?"active":"")" id="page-memberships">
                <div class="section-hd"><h3>العضويات</h3><div style="display:flex;gap:8px;flex-wrap:wrap;"><button class="btn btn-info" onclick="openFeeModal()">⚙️ تعديل رسوم العضوية</button><button class="btn btn-danger" onclick="resetAllMemberships()">🔄 سنة جديدة</button></div></div>
                <div class="mem-summary">
                    <div class="mem-card"><div class="mc-label">إجمالي الأندية</div><div class="mc-value">@ViewBag.ClubsCount</div></div>
                    <div class="mem-card"><div class="mc-label">مدفوعة</div><div class="mc-value" style="color:var(--green)">@ViewBag.PaidCount</div></div>
                    <div class="mem-card"><div class="mc-label">غير مدفوعة</div><div class="mc-value" style="color:var(--amber)">@ViewBag.UnpaidCount</div></div>
                </div>
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>#</th><th>النادي</th><th>السنة</th><th>الرسوم</th><th>الحالة</th><th>إجراءات</th></tr></thead>
                        <tbody>
                            @if (ViewBag.Memberships != null)
                            {
                                int i = 1; foreach (var m in ViewBag.Memberships)
                                {
                                    var isPaid = m.Status == "مدفوع";
                                    <tr id="mem-row-@m.Id" style="@(isPaid?"background:rgba(46,160,67,0.08);":"")"><td>@i</td><td>@(ViewBag.Clubs != null ? ((IEnumerable<dynamic>)ViewBag.Clubs).FirstOrDefault(c => c.Id == m.ClubId)?.Name ?? "—" : "—")</td><td>@m.Year</td><td>@m.Fee ₪</td><td><span class="badge @(isPaid?"badge-active":"badge-inactive")" id="mem-badge-@m.Id">@m.Status</span></td><td><div style="display:flex;gap:4px;flex-wrap:wrap;"><button class="btn btn-sm btn-success" id="mem-btn-@m.Id" style="@(isPaid?"display:none;":"")" onclick="toggleMembership(@m.Id)">✅</button><button class="btn btn-sm btn-info" onclick="openClubFeeModal(@m.Id,@m.Fee)">💰</button></div></td></tr>
                                    i++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- ARCHIVE -->
            <div class="page @(activePage=="archive"?"active":"")" id="page-archive">
                <div class="section-hd"><h3>🗃️ أرشيف الأندية المحذوفة</h3></div>
