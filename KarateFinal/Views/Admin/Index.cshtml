                    <table>
                        <thead><tr><th>#</th><th>اسم النادي</th><th>المسؤول</th><th>المدينة</th><th>التصنيف</th><th>تاريخ الحذف</th></tr></thead>
                        <tbody>
                            @if (ViewBag.ArchivedClubs != null)
                            {
                                int i = 1; foreach (var c in ViewBag.ArchivedClubs)
                                {
                                    <tr><td>@i</td><td>@c.Name</td><td>@c.ManagerName</td><td>@c.City</td><td>@c.Category</td><td>@(c.DeletedAt != null ? ((DateTime)c.DeletedAt).ToString("yyyy/MM/dd") : "—")</td></tr>
                                    i++;
                                }
                            }
                            else
                            {
                                <tr><td colspan="6" style="text-align:center;color:var(--muted);">لا توجد أندية محذوفة</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
    <!-- MODALS -->
    <div class="modal-overlay" id="clubModal"><div class="modal"><div class="modal-header"><h3>🏟️ إضافة نادي جديد</h3><button class="modal-close" onclick="document.getElementById('clubModal').classList.remove('show')">×</button></div><form method="post" action="/Admin/AddClub"><div class="modal-body"><div class="form-grid"><div class="form-group full"><label>اسم النادي *</label><input type="text" name="Name" placeholder="أدخل اسم النادي" required oninput="checkName(this)"><span class="name-error"></span></div><div class="form-group full"><label>اسم المسؤول *</label><input type="text" name="ManagerName" placeholder="اسم مدير النادي" required oninput="checkName(this)"><span class="name-error"></span></div><div class="form-group"><label>المدينة *</label><select name="City" required><option value="">-- اختر المدينة --</option><option>نابلس</option><option>رام الله</option><option>القدس</option><option>الخليل</option><option>جنين</option><option>طولكرم</option><option>قلقيلية</option><option>بيت لحم</option><option>أريحا</option><option>سلفيت</option><option>طوباس</option><option>غزة</option></select></div><div class="form-group"><label>التصنيف *</label><select name="Category" required><option value="">-- اختر --</option><option value="A">A — الدرجة الأولى</option><option value="B">B — الدرجة الثانية</option><option value="C">C — الدرجة الثالثة</option></select></div><div class="form-group full"><label>الوصف</label><input type="text" name="Description" placeholder="وصف مختصر للنادي"></div><div class="form-group"><label>البريد الإلكتروني *</label><input type="email" name="Email" id="clubEmail" placeholder="example@email.com" required><span id="emailError" style="color:#f85149;font-size:11px;display:none;">⚠️ هذا الإيميل مسجّل مسبقاً</span></div><div class="form-group"><label>رقم الهاتف *</label><input type="tel" name="Phone" id="clubPhone" placeholder="+970 5X XXX XXXX" required onblur="checkPhone(this.value)"><span id="phoneError" style="color:#f85149;font-size:11px;display:none;">⚠️ هذا الرقم مسجّل مسبقاً</span></div><div class="form-group"><label>سنة التأسيس</label><input type="number" name="FoundedYear" min="1900" max="2025" placeholder="2010"></div></div><div class="creds-box"><div class="creds-title">🔐 سيتم توليد بيانات الدخول تلقائياً</div></div></div><div class="modal-footer"><button type="button" class="btn btn-ghost" onclick="document.getElementById('clubModal').classList.remove('show')">إلغاء</button><button type="submit" class="btn btn-success">💾 حفظ</button></div></form></div></div>
    <div class="modal-overlay" id="clubDetailsModal"><div class="modal"><div class="modal-header"><h3>📋 تفاصيل النادي</h3><button class="modal-close" onclick="document.getElementById('clubDetailsModal').classList.remove('show')">×</button></div><div class="modal-body"><div class="form-grid"><div class="form-group full"><label>اسم النادي</label><input type="text" id="detailName" readonly style="background:var(--surface2);"></div><div class="form-group full"><label>اسم المسؤول</label><input type="text" id="detailManager" readonly style="background:var(--surface2);"></div></div><hr style="border-color:var(--border);margin:14px 0;"><div class="form-group"><label>🔑 إعادة تعيين كلمة المرور</label><div style="display:flex;gap:8px;margin-top:6px;"><input type="text" id="newPasswordInput" placeholder="كلمة مرور جديدة" style="flex:1;"><button class="btn btn-primary" onclick="resetClubPassword()">تغيير</button></div></div></div><div class="modal-footer"><button class="btn btn-ghost" onclick="document.getElementById('clubDetailsModal').classList.remove('show')">إغلاق</button></div></div></div>
    <div class="modal-overlay" id="tournamentModal"><div class="modal"><div class="modal-header"><h3>🏆 إضافة بطولة جديدة</h3><button class="modal-close" onclick="document.getElementById('tournamentModal').classList.remove('show')">×</button></div><form method="post" action="/Admin/AddTournament"><div class="modal-body"><div class="form-grid"><div class="form-group full"><label>اسم البطولة *</label><input type="text" name="Title" placeholder="أدخل اسم البطولة" required></div><div class="form-group"><label>التاريخ *</label><input type="date" name="Date" required></div><div class="form-group"><label>المدينة *</label><select name="City" required><option value="">-- اختر --</option><option>نابلس</option><option>رام الله</option><option>القدس</option><option>الخليل</option><option>جنين</option><option>طولكرم</option><option>بيت لحم</option><option>غزة</option><option>أريحا</option></select></div><div class="form-group full"><label>الوصف</label><textarea name="Description" rows="2" placeholder="وصف مختصر"></textarea></div><div class="form-group full"><label>مكان البطولة *</label><input type="text" name="Location" placeholder="اسم القاعة أو الملعب" required></div><div class="form-group"><label>الجنس</label><select name="Gender"><option value="الكل">الكل</option><option value="ذكور">ذكور</option><option value="إناث">إناث</option></select></div><div class="form-group"><label>رسوم الاشتراك (₪)</label><input type="number" name="RegistrationFee" min="0" placeholder="0"></div><div class="form-group"><label>آخر موعد للتسجيل *</label><input type="date" name="RegistrationDeadline" required></div><div class="form-group"><label>الحد الأقصى من كل نادي</label><input type="number" name="MaxPlayersPerClub" min="1" placeholder="5"></div><div class="form-group"><label>الحد الأدنى للعمر</label><input type="number" name="MinAge" min="5" max="99" placeholder="10"></div><div class="form-group"><label>الحد الأقصى للعمر</label><input type="number" name="MaxAge" min="5" max="99" placeholder="18"></div><div class="form-group full"><label>الفئات</label><input type="text" name="Categories" placeholder="مثال: أشبال، ناشئين، شباب"></div></div></div><div class="modal-footer"><button type="button" class="btn btn-ghost" onclick="document.getElementById('tournamentModal').classList.remove('show')">إلغاء</button><button type="submit" class="btn btn-success">💾 حفظ</button></div></form></div></div>
    <div class="modal-overlay" id="tournamentDetailsModal"><div class="modal"><div class="modal-header"><h3>📋 تفاصيل البطولة</h3><button class="modal-close" onclick="document.getElementById('tournamentDetailsModal').classList.remove('show')">×</button></div><div class="modal-body"><div id="tournamentDetailsContent"><p style="color:var(--muted);text-align:center;">جاري التحميل...</p></div></div><div class="modal-footer"><button class="btn btn-ghost" onclick="document.getElementById('tournamentDetailsModal').classList.remove('show')">إغلاق</button></div></div></div>
    <div class="modal-overlay" id="editTournamentModal"><div class="modal"><div class="modal-header"><h3>✏️ تعديل البطولة</h3><button class="modal-close" onclick="document.getElementById('editTournamentModal').classList.remove('show')">×</button></div><div class="modal-body"><input type="hidden" id="editTId"><div class="form-grid"><div class="form-group full"><label>اسم البطولة</label><input type="text" id="editTTitle"></div><div class="form-group"><label>التاريخ</label><input type="date" id="editTDate"></div><div class="form-group"><label>المدينة</label><select id="editTCity"><option>نابلس</option><option>رام الله</option><option>القدس</option><option>الخليل</option><option>جنين</option><option>طولكرم</option><option>بيت لحم</option><option>غزة</option><option>أريحا</option></select></div><div class="form-group full"><label>المكان</label><input type="text" id="editTLocation"></div><div class="form-group"><label>رسوم التسجيل (₪)</label><input type="number" id="editTFee" min="0"></div><div class="form-group"><label>الحد الأقصى</label><input type="number" id="editTMax" min="1"></div><div class="form-group full"><label>الفئات</label><input type="text" id="editTCategories"></div><div class="form-group full"><label>الوصف</label><input type="text" id="editTDesc"></div></div></div><div class="modal-footer"><button class="btn btn-ghost" onclick="document.getElementById('editTournamentModal').classList.remove('show')">إلغاء</button><button class="btn btn-success" onclick="saveEditTournament()">💾 حفظ</button></div></div></div>
    <div class="modal-overlay" id="feeModal"><div class="modal"><div class="modal-header"><h3>⚙️ تعديل رسوم العضوية</h3><button class="modal-close" onclick="document.getElementById('feeModal').classList.remove('show')">×</button></div><div class="modal-body"><div class="form-group"><label>الرسوم (₪)</label><input type="number" id="feeInput" min="0" placeholder="600"></div><p style="font-size:11px;color:var(--muted);margin-top:8px;">⚠️ ستُطبَّق على الأندية الجديدة فقط</p></div><div class="modal-footer"><button class="btn btn-ghost" onclick="document.getElementById('feeModal').classList.remove('show')">إلغاء</button><button class="btn btn-success" onclick="saveFee()">💾 حفظ</button></div></div></div>
    <div class="modal-overlay" id="clubFeeModal"><div class="modal"><div class="modal-header"><h3>💰 تعديل رسوم النادي</h3><button class="modal-close" onclick="document.getElementById('clubFeeModal').classList.remove('show')">×</button></div><div class="modal-body"><input type="hidden" id="clubFeeId"><div class="form-group"><label>الرسوم الجديدة (₪)</label><input type="number" id="clubFeeInput" min="0" placeholder="600"></div><p style="font-size:11px;color:var(--muted);margin-top:8px;">⚠️ لهذا النادي فقط</p></div><div class="modal-footer"><button class="btn btn-ghost" onclick="document.getElementById('clubFeeModal').classList.remove('show')">إلغاء</button><button class="btn btn-success" onclick="saveClubFee()">💾 حفظ</button></div></div></div>
    <script>
        function openSidebar() { document.getElementById('sidebar').classList.add('open'); document.getElementById('sidebarOverlay').classList.add('show'); }
        function closeSidebar() { document.getElementById('sidebar').classList.remove('open'); document.getElementById('sidebarOverlay').classList.remove('show'); }
        document.getElementById('dateLabel').textContent = new Date().toLocaleDateString('ar-SA', { year: 'numeric', month: 'long', day: 'numeric' });
        const pageTitles = { dashboard: 'لوحة التحكم', clubs: 'الأندية', players: 'اللاعبون', tournaments: 'البطولات', participations: 'المشاركات', memberships: 'العضويات' };
        function showPage(id, navEl) { document.querySelectorAll('.page').forEach(p => p.classList.remove('active')); document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active')); document.getElementById('page-' + id).classList.add('active'); if (navEl) navEl.classList.add('active'); document.getElementById('pageTitle').textContent = pageTitles[id] || id; }
        function filterByYear() { const year = document.getElementById('yearFilter').value; document.querySelectorAll('#participationsBody tr').forEach(row => { row.style.display = year === '0' || row.dataset.year === year ? '' : ' none'; }); }
        function filterClubs() { const q = document.getElementById('clubSearch').value.toLowerCase(); const rows = document.querySelectorAll('#clubsTableBody tr'); let count = 0; rows.forEach(row => { const text = row.textContent.toLowerCase(); if (text.includes(q)) { row.style.display = ''; count++; } else row.style.display = 'none'; }); document.getElementById('clubsCount').textContent = count + ' نادٍ'; }
        let currentClubId = null;
        function showClubDetails(id, name, manager) { currentClubId = id; document.getElementById('detailName').value = name; document.getElementById('detailManager').value = manager; document.getElementById('newPasswordInput').value = ''; document.getElementById('clubDetailsModal').classList.add('show'); }
        function resetClubPassword() { const newPass = document.getElementById('newPasswordInput').value.trim(); if (!newPass) { toast('أدخل كلمة مرور جديدة', 'error'); return; } fetch('/Admin/ResetClubPassword', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ clubId: currentClubId, newPassword: newPass }) }).then(r => r.json()).then(data => { if (data.success) { toast('✅ تم تغيير كلمة المرور', 'success'); } }); }
        function toggleMembership(id) { fetch('/Admin/ToggleMembership', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ membershipId: id }) }).then(r => r.json()).then(data => { if (data.success) { const isPaid = data.status === 'مدفوع'; const badge = document.getElementById('mem-badge-' + id); const btn = document.getElementById('mem-btn-' + id); const row = document.getElementById('mem-row-' + id); badge.textContent = data.status; badge.className = 'badge ' + (isPaid ? 'badge-active' : 'badge-inactive'); btn.style.display = isPaid ? 'none' : ''; row.style.background = isPaid ? 'rgba(46,160,67,0.08)' : ''; toast(isPaid ? '✅ تم تحديد العضوية كمدفوعة' : '⚠️ تم تغيير الحالة', isPaid ? 'success' : 'info'); } }); }
        function showTournamentDetails(id) { document.getElementById('tournamentDetailsContent').innerHTML = '<p style="color:var(--muted);text-align:center;">جاري التحميل...</p>'; document.getElementById('tournamentDetailsModal').classList.add('show'); fetch('/Admin/TournamentDetails?id=' + id).then(r => r.json()).then(data => { if (data.length === 0) { document.getElementById('tournamentDetailsContent').innerHTML = '<p style="color:var(--muted);text-align:center;">لا يوجد أندية مسجّلة</p>'; return; } let html = '<div style="overflow-x:auto;"><table style="width:100%;border-collapse:collapse;min-width:400px;"><thead><tr><th style="padding:8px;background:var(--surface2);text-align:right;">النادي</th><th style="padding:8px;background:var(--surface2);text-align:right;">اللاعبين</th><th style="padding:8px;background:var(--surface2);text-align:right;">الحالة</th><th style="padding:8px;background:var(--surface2);text-align:right;">إجراءات</th></tr></thead><tbody>'; data.forEach(r => { const statusColor = r.status === 'موافق' ? '#3fb950' : r.status === 'مرفوض' ? '#f85149' : '#e3b341'; html += `<tr><td style="padding:8px;border-bottom:1px solid var(--border);">${r.clubName}</td><td style="padding:8px;border-bottom:1px solid var(--border);">${r.approvedPlayers && r.approvedPlayers.length > 0 ? r.approvedPlayers.join(' — ') : r.playersCount + ' لاعب'}</td><td style="padding:8px;border-bottom:1px solid var(--border);color:${statusColor};font-weight:bold;">${r.status}</td><td style="padding:8px;border-bottom:1px solid var(--border);">${r.status === 'بانتظار الموافقة' ? `<div style="display:flex;gap:4px;"><button class="btn btn-success btn-sm" onclick="approveReg(${r.id})">✅</button><button class="btn btn-danger btn-sm" onclick="openRejectModal(${r.id})">❌</button></div>` : r.status === 'مرفوض' && r.adminNote ? `<span style="font-size:11px;color:var(--muted);">📋 ${r.adminNote}</span>` : '—'}</td></tr>`; }); html += '</tbody></table></div>'; document.getElementById('tournamentDetailsContent').innerHTML = html; }); }
        function approveReg(id) { fetch('/Admin/ApproveTournamentRegistration', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ registrationId: id }) }).then(r => r.json()).then(data => { if (data.success) { toast('✅ تم قبول التسجيل', 'success'); location.reload(); } }); }
        function openRejectModal(id) { const note = prompt('أدخل سبب الرفض:'); if (note === null) return; fetch('/Admin/RejectTournamentRegistration', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ registrationId: id, note: note }) }).then(r => r.json()).then(data => { if (data.success) { toast('تم رفض التسجيل', 'info'); location.reload(); } }); }
        document.querySelectorAll('.modal-overlay').forEach(overlay => { overlay.addEventListener('click', function (e) { if (e.target === this) this.classList.remove('show'); }); });
        function toast(msg, type = 'info') { const icons = { success: '✅', error: '❌', info: 'ℹ️', warning: '⚠️' }; const colors = { success: { bg: '#f0fdf4', border: '#2ea043', text: '#166534' }, error: { bg: '#fef2f2', border: '#da3633', text: '#991b1b' }, info: { bg: '#eff6ff', border: '#4a90e2', text: '#1e40af' }, warning: { bg: '#fffbeb', border: '#d29922', text: '#92400e' } }; const c = colors[type] || colors.info; const el = document.createElement('div'); el.style.cssText = `position:fixed;top:24px;left:50%;transform:translateX(-50%);background:${c.bg};border:2px solid ${c.border};color:${c.text};border-radius:12px;padding:14px 20px;font-size:13px;font-weight:700;display:flex;align-items:center;gap:10px;z-index:99999;box-shadow:0 8px 30px rgba(0,0,0,0.15);min-width:260px;max-width:90vw;font-family:'Cairo',sans-serif;direction:rtl;animation:slideDown 0.3s ease;`; el.innerHTML = `<span style="font-size:20px;">${icons[type] || 'ℹ️'}</span><span style="flex:1;">${msg}</span><button onclick="this.parentElement.remove()" style="background:none;border:none;cursor:pointer;font-size:16px;color:${c.text};">×</button>`; document.body.appendChild(el); setTimeout(() => { el.style.opacity = '0'; el.style.transition = 'opacity 0.3s'; setTimeout(() => el.remove(), 300); }, 4000); }
        function toggleTournamentReg(id) { fetch('/Admin/ToggleTournamentRegistration', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ tournamentId: id }) }).then(r => r.json()).then(data => { if (data.success) location.reload(); }); }
        function showEditTournament(id, title, date, city, location, desc, fee, max, categories) { document.getElementById('editTId').value = id; document.getElementById('editTTitle').value = title; document.getElementById('editTDate').value = date; document.getElementById('editTCity').value = city; document.getElementById('editTLocation').value = location; document.getElementById('editTDesc').value = desc; document.getElementById('editTFee').value = fee; document.getElementById('editTMax').value = max; document.getElementById('editTCategories').value = categories; document.getElementById('editTournamentModal').classList.add('show'); }
        function saveEditTournament() { fetch('/Admin/UpdateTournament', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: parseInt(document.getElementById('editTId').value), title: document.getElementById('editTTitle').value, date: document.getElementById('editTDate').value, city: document.getElementById('editTCity').value, location: document.getElementById('editTLocation').value, description: document.getElementById('editTDesc').value, registrationFee: parseFloat(document.getElementById('editTFee').value) || 0, maxPlayersPerClub: parseInt(document.getElementById('editTMax').value) || 0, categories: document.getElementById('editTCategories').value }) }).then(r => r.json()).then(data => { if (data.success) { document.getElementById('editTournamentModal').classList.remove('show'); location.reload(); toast('✅ تم تعديل البطولة', 'success'); } }); }
        function openClubFeeModal(membershipId, currentFee) { document.getElementById('clubFeeInput').value = currentFee; document.getElementById('clubFeeId').value = membershipId; document.getElementById('clubFeeModal').classList.add('show'); }
        function saveClubFee() { const id = parseInt(document.getElementById('clubFeeId').value); const fee = parseFloat(document.getElementById('clubFeeInput').value); if (!fee || fee <= 0) { toast('أدخل قيمة صحيحة', 'error'); return; } fetch('/Admin/UpdateClubMembershipFee', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ membershipId: id, fee: fee }) }).then(r => r.json()).then(data => { if (data.success) { document.getElementById('clubFeeModal').classList.remove('show'); toast('✅ تم تحديث الرسوم', 'success'); location.reload(); } }); }
        function openFeeModal() { fetch('/Admin/GetMembershipFee').then(r => r.json()).then(data => { document.getElementById('feeInput').value = data.fee; document.getElementById('feeModal').classList.add('show'); }); }
        function saveFee() { const fee = parseFloat(document.getElementById('feeInput').value); if (!fee || fee <= 0) { toast('أدخل قيمة صحيحة', 'error'); return; } fetch('/Admin/UpdateMembershipFee', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ fee: fee }) }).then(r => r.json()).then(data => { if (data.success) { document.getElementById('feeModal').classList.remove('show'); toast('✅ تم تحديث الرسوم إلى ' + fee + '₪', 'success'); } }); }
        function resetAllMemberships() { if (!confirm('هل أنت متأكد؟')) return; fetch('/Admin/ResetAllMemberships', { method: 'POST', headers: { 'Content-Type': 'application/json' } }).then(r => r.json()).then(data => { if (data.success) { toast('✅ تم تصفير جميع العضويات', 'success'); setTimeout(() => location.reload(), 1500); } }); }
        function checkEmail(email) { if (!email) return; fetch('/Admin/CheckClubEmail', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: email }) }).then(r => r.json()).then(data => { document.getElementById('emailError').style.display = data.exists ? 'block' : 'none'; }); }
        function checkPhone(phone) { if (!phone) return; fetch('/Admin/CheckClubPhone', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ phone: phone }) }).then(r => r.json()).then(data => { document.getElementById('phoneError').style.display = data.exists ? 'block' : 'none'; }); }
        function validateName(name) { const parts = name.trim().split(/\s+/); if (parts.length < 3) return "يجب إدخال الاسم الأول واسم الأب واسم العائلة"; const valid = /^[\u0600-\u06FF a-zA-Z\s]+$/; if (!valid.test(name)) return "الاسم يجب أن يحتوي على أحرف فقط"; return null; }
        function checkName(input) {
            const error = validateName(input.value); const span = input.nextElementSibling; if (span && span.classList.contains('name-error')) {
                span.textContent = error || ''; span.style.display = error ? 'block' : 'none'; input.style.borderColor = error ? '#e74c3c'';'';}}
                function loadNotifications() { fetch('/Admin/GetNotifications').then(r => r.json()).then(data => { const badge = document.getElementById('bellBadge'); const list = document.getElementById('notifList'); badge.textContent = data.unread; badge.style.display = data.unread > 0 ? 'flex' : 'none'; if (data.notifications.length === 0) { list.innerHTML = '<div style="padding:20px;text-align:center;color:#8b949e;font-size:13px;">لا توجد إشعارات</div>'; return; } list.innerHTML = data.notifications.map(n => `<div onclick="markRead(${n.id})" style="padding:12px 16px;border-bottom:1px solid #2d3f55;cursor:pointer;background:${n.isRead ? 'transparent' : 'rgba(74,144,226,0.08)'};"><div style="font-size:13px;font-weight:${n.isRead ? '400' : '700'};color:#f1f5f9;">${n.title}</div><div style="font-size:11px;color:#94a3b8;margin-top:3px;">${n.message}</div></div>`).join(''); }); }
                function toggleNotifications() { const panel = document.getElementById('notifPanel'); panel.style.display = panel.style.display === 'none' ? 'block' : 'none'; if (panel.style.display === 'block') loadNotifications(); }
                function markRead(id) { fetch('/Admin/MarkNotificationRead', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id }) }).then(() => loadNotifications()); }
                function markAllRead() { fetch('/Admin/MarkAllRead', { method: 'POST' }).then(() => loadNotifications()); }
                document.addEventListener('click', e => { if (!document.getElementById('bellBtn')?.contains(e.target) && !document.getElementById('notifPanel')?.contains(e.target)) { const panel = document.getElementById('notifPanel'); if (panel) panel.style.display = 'none'; } });
                const translations = { ar: { sidebar_sub: "لوحة الإدارة", logout: "🚪 خروج", last_login: "🕐 آخر تسجيل دخول", stat1: "إجمالي الأندية", stat1s: "نادي مسجّل", stat2: "البطولات", stat3s: "بطولة مسجّلة", stat4: "عضويات غير مدفوعة", stat4s: "بانتظار الدفع", mem_total: "إجمالي الأندية", mem_paid: "مدفوعة", mem_unpaid: "غير مدفوعة" }, en: { sidebar_sub: "Admin Panel", logout: "🚪 Logout", last_login: "🕐 Last Login", stat1: "Total Clubs", stat1s: "registered clubs", stat2: "Tournaments", stat3s: "tournaments", stat4: "Unpaid Memberships", stat4s: "pending", mem_total: "Total Clubs", mem_paid: "Paid", mem_unpaid: "Unpaid" } };
                let currentLang = localStorage.getItem("lang") || "ar";
                function applyLang(lang) { const t = translations[lang]; const isAr = lang === "ar"; document.documentElement.lang = lang; document.documentElement.dir = isAr ? "rtl" : "ltr"; document.getElementById("langBtn").textContent = isAr ? "EN" : "عر"; document.querySelector(".sidebar-logo h2").textContent = isAr ? "منصة الكاراتيه الفلسطينية" : "Palestinian Karate Platform"; document.querySelector(".sidebar-logo span").textContent = t.sidebar_sub; document.querySelector(".logout-btn").textContent = t.logout; document.querySelector(".ll-title").textContent = t.last_login; localStorage.setItem("lang", lang); }
                function toggleLang() { currentLang = currentLang === "ar" ? "en" : "ar"; applyLang(currentLang); }
                document.addEventListener("DOMContentLoaded", () => { loadNotifications(); setInterval(loadNotifications, 60000); });
                (function () { const s = document.createElement('script'); s.src = 'https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js'; s.onload = function () { const topClubs = [@if (ViewBag.TopClubs != null)
        {
            bool first = true; foreach (var c in ViewBag.TopClubs)
            {
                if (!first)
                {
                    <text>,</text>
                }
                <text>{name:"@c.ClubName",points:@c.TotalPoints}</text>
                first = false;
            }
        }]; if (document.getElementById('clubsChart') && topClubs.length > 0) { new Chart(document.getElementById('clubsChart'), { type: 'bar', data: { labels: topClubs.map(c => c.name), datasets: [{ label: 'النقاط', data: topClubs.map(c => c.points), backgroundColor: 'rgba(59,130,246,0.7)', borderColor: '#3b82f6', borderWidth: 1, borderRadius: 6 }] }, options: { plugins: { legend: { display: false } }, scales: { x: { ticks: { color: '#94a3b8' }, grid: { color: '#2d3f55' } }, y: { ticks: { color: '#94a3b8' }, grid: { color: '#2d3f55' } } } } }); } if (document.getElementById('membershipChart')) { new Chart(document.getElementById('membershipChart'), { type: 'pie', data: { labels: ['مدفوع', 'غير مدفوع'], datasets: [{ data: [@ViewBag.PaidCount, @ViewBag.UnpaidCount], backgroundColor: ['rgba(16,185,129,0.8)', 'rgba(239,68,68,0.8)'], borderColor: ['#10b981', '#ef4444'], borderWidth: 2 }] }, options: { plugins: { legend: { labels: { color: '#94a3b8' } } } } }); } document.head.appendChild(s); }; document.head.appendChild(s); })();
    </script>
