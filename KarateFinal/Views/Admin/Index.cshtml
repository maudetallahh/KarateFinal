                        <tbody>
                            @if (ViewBag.Clubs != null)
                            {
                                foreach (var c in ViewBag.Clubs)
                                {
                                    <tr><td>@c.Name</td><td>@c.ManagerName</td><td>@c.City</td><td>@c.Category</td><td><span class="badge badge-active">نشط</span></td></tr>
