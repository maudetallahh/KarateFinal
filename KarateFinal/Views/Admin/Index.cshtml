    <div id="toast-container"></div>

    <script>
        document.getElementById('dateLabel').textContent = new Date().toLocaleDateString('ar-SA', { year: 'numeric', month: 'long', day: 'numeric' });

        const pageTitles = { dashboard: 'لوحة التحكم', clubs: 'الأندية', players: 'اللاعبون', tournaments: 'البطولات', participations: 'المشاركات', memberships: 'العضويات' };
        function showPage(id, navEl) {
            document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
            document.getElementById('page-' + id).classList.add('active');
            if (navEl) navEl.classList.add('active');
            document.getElementById('pageTitle').textContent = pageTitles[id] || id;
        }

        function filterClubs() {
            const q = document.getElementById('clubSearch').value.toLowerCase();
            const rows = document.querySelectorAll('#clubsTableBody tr');
            let count = 0;
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                if (text.includes(q)) { row.style.display = ''; count++; }
                else row.style.display = 'none';
            });
            document.getElementById('clubsCount').textContent = count + ' نادٍ';
        }

        let currentClubId = null;
        function showClubDetails(id, name, manager, username, password) {
            currentClubId = id;
            document.getElementById('detailName').value = name;
            document.getElementById('detailManager').value = manager;
            document.getElementById('detailUsername').value = username;
            document.getElementById('detailPassword').value = password;
            document.getElementById('newPasswordInput').value = '';
            document.getElementById('clubDetailsModal').classList.add('show');
        }

        function resetClubPassword() {
            const newPass = document.getElementById('newPasswordInput').value.trim();
            if (!newPass) { toast('أدخل كلمة مرور جديدة', 'error'); return; }
            fetch('/Admin/ResetClubPassword', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ clubId: currentClubId, newPassword: newPass })
            }).then(r => r.json()).then(data => {
                if (data.success) {
                    document.getElementById('detailPassword').value = newPass;
                    toast('✅ تم تغيير كلمة المرور بنجاح', 'success');
                }
            }).catch(() => toast('حدث خطأ', 'error'));
        }

        function toggleMembership(id, currentStatus) {
            if (currentStatus === 'مدفوع') {
                if (!confirm('هل أنت متأكد من تغيير الحالة إلى غير مدفوع؟')) return;
            }
            fetch('/Admin/ToggleMembership', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ membershipId: id })
            }).then(r => r.json()).then(data => {
                if (data.success) {
                    const isPaid = data.status === 'مدفوع';
                    const badge = document.getElementById('mem-badge-' + id);
                    const btn = document.getElementById('mem-btn-' + id);
                    const row = document.getElementById('mem-row-' + id);
                    badge.textContent = data.status;
                    badge.className = 'badge ' + (isPaid ? 'badge-active' : 'badge-inactive');
                    btn.textContent = isPaid ? '↩️ إلغاء الدفع' : '✅ تحديد كمدفوع';
                    btn.className = 'btn btn-sm ' + (isPaid ? 'btn-ghost' : 'btn-success');
                    btn.setAttribute('onclick', `toggleMembership(${id}, '${data.status}')`);
                    row.style.background = isPaid ? 'rgba(46,160,67,0.08)' : '';
                    toast(isPaid ? '✅ تم تحديد العضوية كمدفوعة' : '⚠️ تم تغيير العضوية لغير مدفوعة', isPaid ? 'success' : 'info');
                }
            });
        }

        function showTournamentDetails(id) {
            document.getElementById('tournamentDetailsContent').innerHTML = '<p style="color:var(--muted);text-align:center;">جاري التحميل...</p>';
            document.getElementById('tournamentDetailsModal').classList.add('show');

            fetch('/Admin/TournamentDetails?id=' + id)
                .then(r => r.json())
                .then(data => {
                    if (data.length === 0) {
                        document.getElementById('tournamentDetailsContent').innerHTML = '<p style="color:var(--muted);text-align:center;">لا يوجد أندية مسجّلة في هذه البطولة</p>';
                        return;
                    }
                    let html = '<table style="width:100%;border-collapse:collapse;">';
                    html += '<thead><tr>';
                    html += '<th style="padding:10px;background:var(--surface2);text-align:right;">النادي</th>';
                    html += '<th style="padding:10px;background:var(--surface2);text-align:right;">اللاعبين</th>';
                    html += '<th style="padding:10px;background:var(--surface2);text-align:right;">الحالة</th>';
                    html += '<th style="padding:10px;background:var(--surface2);text-align:right;">إجراءات</th>';
                    html += '</tr></thead><tbody>';

                    data.forEach(r => {
                        const statusColor = r.status === 'موافق' ? '#3fb950' : r.status === 'مرفوض' ? '#f85149' : '#e3b341';
                        html += `<tr>
                            <td style="padding:10px;border-bottom:1px solid var(--border);">${r.clubName}</td>
                                    <td style="padding:10px;border-bottom:1px solid var(--border);">
            ${r.approvedPlayers && r.approvedPlayers.length > 0
                                ? r.approvedPlayers.join(' — ')
                                : r.playersCount + ' لاعب'}
        </td>
                            <td style="padding:10px;border-bottom:1px solid var(--border);color:${statusColor};font-weight:bold;">${r.status}</td>
                            <td style="padding:10px;border-bottom:1px solid var(--border);">
                                ${r.status === 'بانتظار الموافقة' ? `
                                    <div style="display:flex;gap:6px;flex-wrap:wrap;">
                                        <button class="btn btn-success btn-sm" onclick="approveReg(${r.id})">✅ موافقة</button>
                                        <button class="btn btn-danger btn-sm" onclick="openRejectModal(${r.id})">❌ رفض</button>
                                    </div>
                                ` : r.status === 'مرفوض' && r.adminNote ? `<span style="font-size:11px;color:var(--muted);">📋 ${r.adminNote}</span>` : '—'}
                            </td>
                        </tr>`;
                    });

                    html += '</tbody></table>';
                    document.getElementById('tournamentDetailsContent').innerHTML = html;
                });
        }

        function approveReg(id) {
            fetch('/Admin/ApproveTournamentRegistration', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ registrationId: id })
            }).then(r => r.json()).then(data => {
                if (data.success) {
                    toast('✅ تم قبول التسجيل', 'success');
                    // إعادة تحميل التفاصيل
                    document.querySelector('[onclick*="showTournamentDetails"]')?.click();
                    location.reload();
                }
            });
        }

        function openRejectModal(id) {
            const note = prompt('أدخل سبب الرفض (اختياري):');
            if (note === null) return;

            fetch('/Admin/RejectTournamentRegistration', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ registrationId: id, note: note })
            }).then(r => r.json()).then(data => {
                if (data.success) {
                    toast('تم رفض التسجيل', 'info');
                    location.reload();
                }
            });
        }

        document.querySelectorAll('.modal-overlay').forEach(overlay => {
            overlay.addEventListener('click', function (e) {
                if (e.target === this) this.classList.remove('show');
            });
        });

        function toast(msg, type = 'info') {
            const el = document.createElement('div');
            el.className = `toast ${type}`;
            el.innerHTML = `<span>${msg}</span>`;
            document.getElementById('toast-container').appendChild(el);
            setTimeout(() => el.remove(), 3500);
        }
        function toggleTournamentReg(id) {
            fetch('/Admin/ToggleTournamentRegistration', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ tournamentId: id })
            }).then(r => r.json()).then(data => {
                if (data.success) location.reload();
            });
        }
        function showEditTournament(id, title, date, city, location, desc, fee, max, categories) {
            document.getElementById('editTId').value = id;
            document.getElementById('editTTitle').value = title;
            document.getElementById('editTDate').value = date;
            document.getElementById('editTCity').value = city;
            document.getElementById('editTLocation').value = location;
            document.getElementById('editTDesc').value = desc;
            document.getElementById('editTFee').value = fee;
            document.getElementById('editTMax').value = max;
            document.getElementById('editTCategories').value = categories;
            document.getElementById('editTournamentModal').classList.add('show');
        }

        function saveEditTournament() {
            const id = parseInt(document.getElementById('editTId').value);
            fetch('/Admin/UpdateTournament', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    id: id,
                    title: document.getElementById('editTTitle').value,
                    date: document.getElementById('editTDate').value,
                    city: document.getElementById('editTCity').value,
                    location: document.getElementById('editTLocation').value,
                    description: document.getElementById('editTDesc').value,
                    registrationFee: parseFloat(document.getElementById('editTFee').value) || 0,
                    maxPlayersPerClub: parseInt(document.getElementById('editTMax').value) || 0,
                    categories: document.getElementById('editTCategories').value
                })
            }).then(r => r.json()).then(data => {
                if (data.success) {
                    document.getElementById('editTournamentModal').classList.remove('show');
                    location.reload();
                    toast('✅ تم تعديل البطولة بنجاح', 'success');
                }
            });
        }
        const translations = {
            ar: {
                sidebar_title: "منصة الكاراتيه\nالفلسطينية", sidebar_sub: "لوحة الإدارة",
                nav_dashboard: "لوحة التحكم", nav_profile: "معلوماتي", nav_clubs: "الأندية",
                nav_players: "اللاعبون", nav_tournaments: "البطولات",
                nav_participations: "المشاركات", nav_memberships: "العضويات",
                logout: "🚪 خروج", last_login: "🕐 آخر تسجيل دخول",
                stat1: "إجمالي الأندية", stat1s: "نادي مسجّل",
                stat2: "إجمالي اللاعبين", stat2s: "في جميع الأندية",
                stat3: "البطولات", stat3s: "بطولة مسجّلة",
                stat4: "عضويات غير مدفوعة", stat4s: "بانتظار الدفع",
                recent_clubs: "آخر الأندية المضافة",
                th_club: "اسم النادي", th_manager: "المسؤول", th_city: "المدينة",
                th_category: "التصنيف", th_status: "الحالة",
                add_club: "➕ إضافة نادي", add_tournament: "➕ إضافة بطولة",
                add_result: "➕ إضافة نتيجة",
                mem_total: "إجمالي الأندية", mem_paid: "مدفوعة", mem_unpaid: "غير مدفوعة",
                page_titles: { dashboard: "لوحة التحكم", clubs: "الأندية", players: "اللاعبون", tournaments: "البطولات", participations: "المشاركات", memberships: "العضويات" },
                footer_title: "منصة الكاراتيه الفلسطينية",
                copyright: "© 2025 منصة الكاراتيه الفلسطينية"
            },
            en: {
                sidebar_title: "Palestinian\nKarate Platform", sidebar_sub: "Admin Panel",
                nav_dashboard: "Dashboard", nav_profile: "My Profile", nav_clubs: "Clubs",
                nav_players: "Players", nav_tournaments: "Tournaments",
                nav_participations: "Participations", nav_memberships: "Memberships",
                logout: "🚪 Logout", last_login: "🕐 Last Login",
                stat1: "Total Clubs", stat1s: "registered clubs",
                stat2: "Total Players", stat2s: "in all clubs",
                stat3: "Tournaments", stat3s: "registered tournaments",
                stat4: "Unpaid Memberships", stat4s: "pending payment",
                recent_clubs: "Recently Added Clubs",
                th_club: "Club Name", th_manager: "Manager", th_city: "City",
                th_category: "Category", th_status: "Status",
                add_club: "➕ Add Club", add_tournament: "➕ Add Tournament",
                add_result: "➕ Add Result",
                mem_total: "Total Clubs", mem_paid: "Paid", mem_unpaid: "Unpaid",
                page_titles: { dashboard: "Dashboard", clubs: "Clubs", players: "Players", tournaments: "Tournaments", participations: "Participations", memberships: "Memberships" },
                footer_title: "Palestinian Karate Platform",
                copyright: "© 2025 Palestinian Karate Platform"
            }
        };

        let currentLang = localStorage.getItem("lang") || "ar";

        function applyLang(lang) {
            const t = translations[lang];
            const isAr = lang === "ar";
            document.documentElement.lang = lang;
            document.documentElement.dir = isAr ? "rtl" : "ltr";
            document.getElementById("langBtn").textContent = isAr ? "EN" : "عر";

            // Sidebar
            document.querySelector(".sidebar-logo h2").textContent = isAr ? "منصة الكاراتيه الفلسطينية" : "Palestinian Karate Platform";
            document.querySelector(".sidebar-logo span").textContent = t.sidebar_sub;

            // Nav items
            const navItems = document.querySelectorAll(".nav-item");
            if (navItems[0]) navItems[0].innerHTML = `<span class="icon">⚙️</span> ${t.nav_profile}`;
            if (navItems[1]) navItems[1].innerHTML = `<span class="icon">🏟️</span> ${t.nav_clubs}`;
            if (navItems[2]) navItems[2].innerHTML = `<span class="icon">👥</span> ${t.nav_players}`;
            if (navItems[3]) navItems[3].innerHTML = `<span class="icon">🏆</span> ${t.nav_tournaments}`;
            if (navItems[4]) navItems[4].innerHTML = `<span class="icon">🏅</span> ${t.nav_participations}`;
            if (navItems[5]) navItems[5].innerHTML = `<span class="icon">🪪</span> ${t.nav_memberships}`;

            // Topbar
            document.querySelector(".logout-btn").textContent = t.logout;
            document.querySelector(".ll-title").textContent = t.last_login;

            // Stats
            const scLabels = document.querySelectorAll(".sc-label");
            const scChanges = document.querySelectorAll(".sc-change");
            if (scLabels[0]) scLabels[0].textContent = t.stat1;
            if (scLabels[1]) scLabels[1].textContent = t.stat2;
            if (scLabels[2]) scLabels[2].textContent = t.stat3;
            if (scLabels[3]) scLabels[3].textContent = t.stat4;
            if (scChanges[0]) scChanges[0].textContent = t.stat1s;
            if (scChanges[1]) scChanges[1].textContent = t.stat2s;
            if (scChanges[2]) scChanges[2].textContent = t.stat3s;
            if (scChanges[3]) scChanges[3].textContent = t.stat4s;

            // Section headers
            const sectionHds = document.querySelectorAll(".section-hd h3");
            if (sectionHds[0]) sectionHds[0].textContent = t.recent_clubs;

            // Buttons
            const btns = document.querySelectorAll(".btn-primary");
            if (btns[0]) btns[0].textContent = t.add_club;
            if (btns[1]) btns[1].textContent = t.add_tournament;

            // Page titles map
            pageTitles.dashboard = t.page_titles.dashboard;
            pageTitles.clubs = t.page_titles.clubs;
            pageTitles.players = t.page_titles.players;
            pageTitles.tournaments = t.page_titles.tournaments;
            pageTitles.participations = t.page_titles.participations;
            pageTitles.memberships = t.page_titles.memberships;

            // Mem cards
            const mcLabels = document.querySelectorAll(".mc-label");
            if (mcLabels[0]) mcLabels[0].textContent = t.mem_total;
            if (mcLabels[1]) mcLabels[1].textContent = t.mem_paid;
            if (mcLabels[2]) mcLabels[2].textContent = t.mem_unpaid;

            localStorage.setItem("lang", lang);
        }

        function toggleLang() {
            currentLang = currentLang === "ar" ? "en" : "ar";
            applyLang(currentLang);
        }

        document.addEventListener("DOMContentLoaded", () => applyLang(currentLang));
    </script>
</body>
</html>
