                            {
                                int r = 1; foreach (var p in ViewBag.TopPlayers)
                                {
                                    var medal = r == 1 ? "🥇" : r == 2 ? "🥈" : r == 3 ? "🥉" : "🏅";
                                    <tr><td>@medal @r</td><td>@p.PlayerName</td><td>@p.ClubName</td><td>@p.Belt</td><td><strong>@p.TotalPoints ⭐</strong></td></tr>
