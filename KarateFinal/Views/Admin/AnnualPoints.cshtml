@{
    Layout = null;
    var points = ViewBag.Points as IEnumerable<dynamic>;
    int year = ViewBag.Year;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>التنقيط السنوي @year</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; font-family:'Segoe UI',Tahoma,sans-serif; }
        body { background:#0f1923; color:#f1f5f9; min-height:100vh; }
        nav { background:#1a2535; border-bottom:2px solid #3b82f6; padding:12px 20px; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:100; }
        .nav-title { font-size:16px; font-weight:700; }
        .back-btn { background:rgba(59,130,246,0.15); color:#3b82f6; border:1px solid rgba(59,130,246,0.3); padding:7px 16px; border-radius:8px; text-decoration:none; font-size:13px; font-weight:700; }
        .container { max-width:900px; margin:24px auto; padding:0 20px; }
        .year-selector { display:flex; gap:8px; margin-bottom:20px; flex-wrap:wrap; align-items:center; }
        .year-selector label { font-size:13px; color:#94a3b8; }
        .year-selector select { padding:8px 12px; border-radius:8px; border:1px solid #2d3f55; background:#1a2535; color:#f1f5f9; font-family:inherit; font-size:13px; }
        .year-selector button { padding:8px 16px; background:#3b82f6; color:white; border:none; border-radius:8px; cursor:pointer; font-family:inherit; font-size:13px; font-weight:700; }
        .table-wrap { background:#1a2535; border:1px solid #2d3f55; border-radius:12px; overflow:hidden; overflow-x:auto; }
        table { width:100%; border-collapse:collapse; min-width:500px; }
        thead th { padding:12px 16px; font-size:11px; font-weight:700; color:#94a3b8; text-align:right; background:#223044; border-bottom:1px solid #2d3f55; }
        tbody tr { border-bottom:1px solid #2d3f55; transition:background 0.15s; }
        tbody tr:hover { background:rgba(255,255,255,0.03); }
        tbody td { padding:12px 16px; font-size:13px; }
        .rank-badge { display:inline-flex; align-items:center; justify-content:center; width:28px; height:28px; border-radius:50%; font-size:13px; font-weight:900; }
        .rank-1 { background:rgba(255,215,0,0.2); color:#FFD700; }
        .rank-2 { background:rgba(192,192,192,0.2); color:#C0C0C0; }
        .rank-3 { background:rgba(205,127,50,0.2); color:#CD7F32; }
        .rank-other { background:rgba(255,255,255,0.1); color:#94a3b8; }
        .points-val { font-size:16px; font-weight:900; color:#4a90e2; }
        .empty { text-align:center; color:#94a3b8; padding:40px; }
        @@media print { nav { display:none; } body { background:white; color:black; } .table-wrap { border:1px solid #ccc; } thead th { background:#f0f0f0; color:#333; } }
    </style>
<link rel="stylesheet" href="/css/dark.css"><script src="/js/theme.js"></script></head>
<body>
    <nav>
        <div class="nav-title">📊 التنقيط السنوي</div>
        <a href="/Admin/Index" class="back-btn">← الرئيسية</a>
    </nav>
    <div class="container">
        <div class="year-selector">
            <label>اختر السنة:</label>
            <select id="yearSelect">
                @for (int y = DateTime.Now.Year; y >= 2020; y--)
                {
                    @if (y == year)
                    {
                        <option value="@y" selected>@y</option>
                    }
                    else
                    {
                        <option value="@y">@y</option>
                    }                }
            </select>
            <button onclick="window.location='/Admin/AnnualPoints?year='+document.getElementById('yearSelect').value">عرض</button>
            <button onclick="window.print()" style="background:#10b981;">🖨️ طباعة</button>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>الترتيب</th>
                        <th>النادي</th>
                        <th>البطولات</th>
                        <th>🥇 ذهب</th>
                        <th>🥈 فضة</th>
                        <th>🥉 برونز</th>
                        <th>النقاط</th>
                    </tr>
                </thead>
                <tbody>
                    @if (points != null && points.Any())
                    {
                        int i = 1;
                        foreach (var p in points)
                        {
                            var rankClass = i == 1 ? "rank-1" : i == 2 ? "rank-2" : i == 3 ? "rank-3" : "rank-other";
                            var medal = i == 1 ? "🥇" : i == 2 ? "🥈" : i == 3 ? "🥉" : i.ToString();
                            <tr>
                                <td><span class="rank-badge @rankClass">@medal</span></td>
                                <td><strong>@p.ClubName</strong></td>
                                <td>@p.Tournaments</td>
                                <td>@p.Gold</td>
                                <td>@p.Silver</td>
                                <td>@p.Bronze</td>
                                <td><span class="points-val">@p.TotalPoints ⭐</span></td>
                            </tr>
                            i++;
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="empty">لا توجد بيانات لسنة @year</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>