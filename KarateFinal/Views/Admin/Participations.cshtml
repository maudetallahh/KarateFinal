@{
    Layout = null;
    var participations = ViewBag.Participations as List<KarateFinal.Models.Participation>;
    var clubs = ViewBag.Clubs as List<KarateFinal.Models.Club>;
    var tournaments = ViewBag.Tournaments as List<KarateFinal.Models.Tournament>;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>المشاركات</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; font-family:'Segoe UI',Tahoma,sans-serif; }
        body { background:#0f1923; color:#f1f5f9; min-height:100vh; }
        nav { background:#1a2535; border-bottom:2px solid #3b82f6; padding:12px 20px; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:100; }
        .nav-title { font-size:16px; font-weight:700; }
        .back-btn { background:rgba(59,130,246,0.15); color:#3b82f6; border:1px solid rgba(59,130,246,0.3); padding:7px 16px; border-radius:8px; text-decoration:none; font-size:13px; font-weight:700; }
        .container { max-width:1100px; margin:24px auto; padding:0 20px; }
        .section-hd { display:flex; align-items:center; justify-content:space-between; margin-bottom:16px; flex-wrap:wrap; gap:8px; }
        .btn { display:inline-flex; align-items:center; gap:6px; padding:8px 14px; border-radius:8px; border:none; font-family:inherit; font-size:12px; font-weight:700; cursor:pointer; text-decoration:none; }
        .btn-primary { background:#3b82f6; color:#fff; }
        .btn-danger { background:#ef4444; color:#fff; }
        .btn-sm { padding:5px 10px; font-size:11px; border-radius:6px; }
        .table-wrap { background:#1a2535; border:1px solid #2d3f55; border-radius:12px; overflow:hidden; overflow-x:auto; }
        .tbl-toolbar { padding:12px 16px; border-bottom:1px solid #2d3f55; display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
        .tbl-toolbar input, .tbl-toolbar select { padding:6px 10px; border-radius:6px; border:1px solid #2d3f55; background:#0f1923; color:#f1f5f9; font-family:inherit; font-size:12px; }
        table { width:100%; border-collapse:collapse; min-width:600px; }
        thead th { padding:10px 14px; font-size:11px; font-weight:700; color:#94a3b8; text-align:right; background:#223044; border-bottom:1px solid #2d3f55; }
        tbody tr { border-bottom:1px solid #2d3f55; }
        tbody tr:hover { background:rgba(255,255,255,0.03); }
        tbody td { padding:10px 14px; font-size:12px; }
    </style>
<link rel="stylesheet" href="/css/dark.css"><script>function applyTheme(t){const l=t==='light';document.body.style.setProperty('background',l?'#f0f4f8':'#0f1923','important');document.body.style.setProperty('color',l?'#1e2a38':'#f1f5f9','important');document.querySelectorAll('.theme-btn').forEach(b=>b.textContent=l?'☀️':'🌙');localStorage.setItem('theme',t);}function toggleTheme(){applyTheme(localStorage.getItem('theme')==='light'?'dark':'light');}document.addEventListener('DOMContentLoaded',()=>applyTheme(localStorage.getItem('theme')||'dark'));</script></head>
<body>
    <nav>
        <div class="nav-title">🏅 المشاركات</div>
        <a href="/Admin/Index" class="back-btn">← الرئيسية</a>
    </nav>
    <div class="container">
        <div class="section-hd">
            <h3>جميع المشاركات</h3>
            <a href="/Admin/AddParticipation" class="btn btn-primary">➕ إضافة نتيجة</a>
        </div>
        <div class="table-wrap">
            <div class="tbl-toolbar">
                <input type="text" id="search" placeholder="ابحث..." oninput="filter()">
                <select id="yearFilter" onchange="filter()">
                    <option value="">كل السنوات</option>
                    @for (int y = DateTime.Now.Year; y >= 2020; y--)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
                <span id="count" style="font-size:11px;color:#94a3b8;"></span>
            </div>
            <table>
                <thead><tr><th>#</th><th>النادي</th><th>البطولة</th><th>المركز</th><th>النقاط</th><th>إجراءات</th></tr></thead>
                <tbody id="body">
                    @if (participations != null)
                    {
                        int i = 1;
                        foreach (var p in participations)
                        {
                            var club = clubs?.FirstOrDefault(c => c.Id == p.ClubId);
                            var tournament = tournaments?.FirstOrDefault(t => t.Id == p.TournamentId);
                            var medal = p.Rank == 1 ? "🥇" : p.Rank == 2 ? "🥈" : p.Rank == 3 ? "🥉" : "";
                            <tr data-year="@(tournament?.Date.Year ?? DateTime.Now.Year)">
                                <td>@i</td>
                                <td>@(club?.Name ?? "—")</td>
                                <td>@(tournament?.Title ?? "—")</td>
                                <td>@medal @p.Rank</td>
                                <td>@p.Points ⭐</td>
                                <td><a href="/Admin/DeleteParticipation/@p.Id" class="btn btn-danger btn-sm" onclick="return confirm('هل أنت متأكد؟')">🗑️</a></td>
                            </tr>
                            i++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    <script>
        function filter() {
            const q = document.getElementById('search').value.toLowerCase();
            const year = document.getElementById('yearFilter').value;
            const rows = document.querySelectorAll('#body tr');
            let count = 0;
            rows.forEach(row => {
                const matchText = row.textContent.toLowerCase().includes(q);
                const matchYear = !year || row.dataset.year === year;
                const show = matchText && matchYear;
                row.style.display = show ? '' : 'none';
                if (show) count++;
            });
            document.getElementById('count').textContent = count + ' مشاركة';
        }
        filter();
    </script>
@await Html.PartialAsync("_Footer")</body>
</html>