@{
    Layout = null;
    var role = Context.Session.GetString("Role");
    var sessionUsername = Context.Session.GetString("Username");
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/png" href="/image/www.png">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>البطولات — منصة الكاراتيه الفلسطينية</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; font-family:'Segoe UI',Tahoma,sans-serif; }
        body { background:#f5f5f5; }
        nav { background-color:#1e2a38; color:white; padding:20px 50px; display:flex; justify-content:center; align-items:center; border-bottom:4px solid #4a90e2; position:sticky; top:0; z-index:1000; }
        .nav-header { text-align:center; }
        .nav-header h1 { font-size:26px; color:#ffffff; letter-spacing:1px; }
        .nav-header h2 { font-size:14px; color:#d1d5db; font-weight:normal; margin-top:5px; }
        nav ul { position:absolute; left:50px; display:flex; list-style:none; align-items:center; }
        nav ul li { margin-left:25px; }
        nav ul li a { text-decoration:none; color:white; font-weight:bold; transition:0.3s; font-size:15px; }
        nav ul li a:hover { color:#81b3f7; }
        .login-btn { background-color:#2c3e50; padding:8px 25px; border-radius:5px; border:2px solid transparent; transition:0.3s ease; }
        .login-btn:hover { background-color:transparent; color:#ffffff; border:2px solid #4a90e2; }
        .hamburger { display:none; flex-direction:column; gap:5px; cursor:pointer; position:absolute; right:20px; }
        .hamburger span { width:25px; height:2px; background:white; border-radius:2px; transition:0.3s; }
        .hamburger.open span:nth-child(1) { transform:rotate(45deg) translate(5px,5px); }
        .hamburger.open span:nth-child(2) { opacity:0; }
        .hamburger.open span:nth-child(3) { transform:rotate(-45deg) translate(5px,-5px); }
        .mobile-menu { display:none; flex-direction:column; background:#1e2a38; padding:10px 20px; gap:10px; }
        .mobile-menu a { color:white; text-decoration:none; font-size:15px; padding:8px 0; border-bottom:1px solid #2c3e50; }
        .mobile-menu.show { display:flex; }
        #upcoming-tournaments { padding:60px 10%; background:#f5f5f5; }
        .section-title { text-align:center; font-size:32px; margin-bottom:40px; color:#222; }
        .cards { display:flex; gap:25px; flex-wrap:wrap; justify-content:center; }
        .card { width:23%; min-width:200px; background:white; border-radius:10px; overflow:hidden; box-shadow:0 5px 15px rgba(0,0,0,0.1); transition:0.3s; }
        .card:hover { transform:translateY(-8px); box-shadow:0 10px 25px rgba(0,0,0,0.2); }
        .card-content { padding:20px; }
        .card-content h3 { font-size:20px; margin-bottom:10px; color:#111; }
        .card-content p { font-size:15px; color:#555; margin-bottom:5px; }
        .card-badge { display:inline-block; font-size:11px; padding:3px 10px; border-radius:100px; font-weight:600; margin-top:8px; background:#E1F5EE; color:#0F6E56; }
        .empty-msg { text-align:center; padding:3rem; color:#888; font-size:16px; width:100%; }
        footer { background:#1e2a38; color:white; padding:50px 40px 0; direction:rtl; margin-top:40px; }
        .footer-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(180px,1fr)); gap:32px; padding-bottom:40px; border-bottom:1px solid rgba(255,255,255,0.1); }
        .footer-col h3 { font-size:15px; font-weight:500; color:#e2e8f0; margin-bottom:14px; }
        .footer-col.brand h3 { font-size:16px; color:#81b3f7; border-right:3px solid #4a90e2; padding-right:10px; }
        .footer-col p { font-size:13px; color:#94a3b8; line-height:1.8; margin:0; }
        .footer-col ul { list-style:none; display:flex; flex-direction:column; gap:10px; }
        .footer-col ul li a { color:#94a3b8; text-decoration:none; font-size:13px; transition:0.3s; }
        .footer-col ul li a:hover { color:#81b3f7; }
        .social-links { display:flex; gap:10px; margin-top:16px; }
        .social-links a { width:34px; height:34px; border-radius:50%; background:rgba(74,144,226,0.15); border:1px solid rgba(74,144,226,0.3); display:flex; align-items:center; justify-content:center; text-decoration:none; color:#81b3f7; font-size:14px; }
        .contact-item { display:flex; align-items:center; gap:10px; margin-bottom:12px; }
        .contact-icon { width:28px; height:28px; border-radius:6px; background:rgba(74,144,226,0.15); display:flex; align-items:center; justify-content:center; font-size:13px; }
        .contact-item span { color:#94a3b8; font-size:13px; }
        .footer-bottom { display:flex; justify-content:center; align-items:center; padding:20px 0; }
        .footer-bottom p { color:#475569; font-size:12px; margin:0; }
        @@media(max-width:1200px) { .card { width:31%; } }
        @@media(max-width:992px) { .card { width:48%; } }
        @@media(max-width:768px) { nav ul { display:none; } .hamburger { display:flex; } .cards { flex-direction:column; } .card { width:90%; margin:0 auto; } }
    </style>
<link rel="stylesheet" href="/css/dark.css"><script>function applyTheme(t){const l=t==='light';document.body.style.setProperty('background',l?'#f0f4f8':'#0f1923','important');document.body.style.setProperty('color',l?'#1e2a38':'#f1f5f9','important');document.querySelectorAll('.theme-btn').forEach(b=>b.textContent=l?'☀️':'🌙');localStorage.setItem('theme',t);}<script>
<body>
    <nav>
        <div class="nav-header">
            <h1>منصة الكاراتيه الفلسطينية</h1>
            <h2>اصنع تاريخك ...وكن بطلاً</h2>
        </div>
        <a href="/Home/Index">
            @await Html.PartialAsync("_NavLogo")
        </a>
        <ul>
            <li><a href="/Home/Index">الرئيسية</a></li>
            <li><a href="/Tour/Index">الاندية</a></li>
            <li><a href="/Tournament/Index">البطولات</a></li>
            @if (sessionUsername != null)
            {
                if (role == "Club")
                {
                    <li><a href="/Club/Dashboard" class="login-btn">لوحة النادي</a></li>
                }
                else if (role == "Player")
                {
                    <li><a href="/Player/Dashboard" class="login-btn">بطاقتي</a></li>
                }
                else if (role == "Admin")
                {
                    <li><a href="/Admin/Index" class="login-btn">لوحة التحكم</a></li>
                }
                <li><a href="/Account/Logout" style="color:#f85149;font-size:13px;">خروج</a></li>
            }
            else
            {
                <li><a href="/Account/Login" class="login-btn">تسجيل دخول</a></li>
            }
        </ul>
        <div class="hamburger" id="hamburger">
            <span></span><span></span><span></span>
        </div>
    </nav>
    <div class="mobile-menu" id="mobileMenu">
        <a href="/Home/Index">الرئيسية</a>
        <a href="/Tour/Index">الاندية</a>
        <a href="/Tournament/Index">البطولات</a>
        <a href="/Account/Login">تسجيل دخول</a>
    </div>

    <section id="upcoming-tournaments">
        <h2 class="section-title">جدول البطولات المقبلة 🏆</h2>
        <div class="cards">
            @if (ViewBag.Tournaments != null && ((IEnumerable<KarateFinal.Models.Tournament>)ViewBag.Tournaments).Any())
            {
                foreach (var t in (IEnumerable<KarateFinal.Models.Tournament>)ViewBag.Tournaments)
                {
                    <div class="card">
                        <div class="card-content">
                            <h3>@t.Title</h3>
                            <p>📅 @t.Date.ToString("dd/MM/yyyy")</p>
                            <p>📍 @t.City</p>
                            @if (!string.IsNullOrEmpty(t.Description))
                            {
                                <p>@t.Description</p>
                            }
                            <span class="card-badge">قادمة</span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-msg">لا توجد بطولات حالياً</div>
            }
        </div>
    </section>

    <footer>
        <div class="footer-grid">
            <div class="footer-col brand">
                <h3>منصة الكاراتيه الفلسطينية</h3>
                <p>بناء أبطال المستقبل وتطوير رياضة الكاراتيه في فلسطين من خلال التدريب والمنافسة.</p>
                <div class="social-links">
                    <a href="#">f</a><a href="#">in</a><a href="#">ig</a>
                </div>
            </div>
            <div class="footer-col">
                <h3>روابط سريعة</h3>
                <ul>
                    <li><a href="/Home/Index">← الرئيسية</a></li>
                    <li><a href="/Tour/Index">← الأندية</a></li>
                    <li><a href="/Tournament/Index">← البطولات</a></li>
                    <li><a href="/Account/Login">← تسجيل دخول</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h3>خدماتنا</h3>
                <ul>
                    <li><a href="#">تسجيل اللاعبين</a></li>
                    <li><a href="#">إدارة البطولات</a></li>
                    <li><a href="#">متابعة النتائج</a></li>
                    <li><a href="#">الاستحقاقات</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h3>تواصل معنا</h3>
                <div class="contact-item">
                    <div class="contact-icon">📍</div>
                    <span>فلسطين، الضفة الغربية</span>
                </div>
                <div class="contact-item">
                    <div class="contact-icon">📞</div>
                    <span style="direction:ltr;">+970 59X XXX XXXX</span>
                </div>
                <div class="contact-item">
                    <div class="contact-icon">✉️</div>
                    <span>info@karate-ps.com</span>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>© 2025 منصة الكاراتيه الفلسطينية — جميع الحقوق محفوظة</p>
        </div>
    </footer>

    <script>
        document.getElementById('hamburger').addEventListener('click', function(){
            this.classList.toggle('open');
            document.getElementById('mobileMenu').classList.toggle('show');
        });
    </script>
</body>
</html>