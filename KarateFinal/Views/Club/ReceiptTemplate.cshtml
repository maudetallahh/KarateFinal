@{
    Layout = null;
    var club = ViewBag.Club as KarateFinal.Models.Club;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تعديل قالب الوصل</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI',Tahoma,sans-serif;
        }

        body {
            background: #eef3f8;
            min-height: 100vh;
        }

        nav {
            background: #1e2a38;
            color: white;
            padding: 14px 24px;
            display: flex;
            justify-content: center;
            align-items: center;
            border-bottom: 4px solid #4a90e2;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .nav-header {
            text-align: center;
        }

            .nav-header h1 {
                font-size: 20px;
                color: #fff;
            }

        nav ul {
            position: absolute;
            left: 24px;
            display: flex;
            list-style: none;
            gap: 16px;
        }

            nav ul li a {
                color: white;
                text-decoration: none;
                font-size: 13px;
                font-weight: bold;
            }

        .logout-btn {
            background: #2c3e50;
            padding: 7px 18px;
            border-radius: 5px;
        }

        .container {
            max-width: 1000px;
            margin: 30px auto;
            padding: 0 20px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
        }

        .card {
            background: white;
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        }

        .card-title {
            font-size: 16px;
            font-weight: 800;
            color: #1e2a38;
            margin-bottom: 16px;
        }

        .editor {
            width: 100%;
            height: 400px;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-family: 'Segoe UI',sans-serif;
            font-size: 13px;
            resize: vertical;
            direction: rtl;
        }

        .save-btn {
            width: 100%;
            padding: 12px;
            background: #27ae60;
            color: white;
            border: none;
            border-radius: 10px;
            font-family: inherit;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            margin-top: 12px;
        }

            .save-btn:hover {
                background: #219a52;
            }

        .preview-box {
            border: 2px solid #1e2a38;
            border-radius: 12px;
            padding: 24px;
            min-height: 400px;
            font-family: 'Segoe UI',sans-serif;
        }

        .variables {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 16px;
            margin-bottom: 16px;
        }

            .variables h4 {
                font-size: 12px;
                font-weight: 700;
                color: #666;
                margin-bottom: 8px;
            }

        .var-item {
            display: inline-block;
            background: #e8f4fd;
            color: #4a90e2;
            border: 1px solid #bee3f8;
            padding: 3px 8px;
            border-radius: 6px;
            font-size: 11px;
            font-family: monospace;
            margin: 3px;
            cursor: pointer;
        }

            .var-item:hover {
                background: #4a90e2;
                color: white;
            }
    </style>
<link rel="stylesheet" href="/css/dark.css"><script src="/js/site.js"></script></head>
<body>
    <nav>
        <div class="nav-header"><h1>منصة الكاراتيه الفلسطينية</h1></div>
        <ul>
            <li><a href="/Club/Dashboard">← الرئيسية</a></li>
            <button onclick="toggleTheme()" class="theme-btn" style="background:rgba(255,255,255,0.1);border:none;color:white;padding:6px 12px;border-radius:8px;cursor:pointer;font-size:16px;">🌙</button>
            <li><a href="/Account/Logout" class="logout-btn">تسجيل خروج</a></li>
        </ul>
    </nav>
    <div style="max-width:1000px;margin:24px auto;padding:0 20px;">
        <h2 style="font-size:20px;font-weight:800;color:#1e2a38;margin-bottom:20px;">🧾 تعديل قالب الوصل</h2>
        <div class="variables">
            <h4>المتغيرات المتاحة — اضغط للإدراج:</h4>
            <span class="var-item" onclick="insertVar('{{اسم_اللاعب}}')">{{اسم_اللاعب}}</span>
            <span class="var-item" onclick="insertVar('{{اسم_النادي}}')">{{اسم_النادي}}</span>
            <span class="var-item" onclick="insertVar('{{الشهر}}')">{{الشهر}}</span>
            <span class="var-item" onclick="insertVar('{{السنة}}')">{{السنة}}</span>
            <span class="var-item" onclick="insertVar('{{المبلغ}}')">{{المبلغ}}</span>
            <span class="var-item" onclick="insertVar('{{التاريخ}}')">{{التاريخ}}</span>
            <span class="var-item" onclick="insertVar('{{رقم_الوصل}}')">{{رقم_الوصل}}</span>
        </div>
        <div class="container" style="margin:0;padding:0;">
            <div class="card">
                <div class="card-title">✏️ تعديل القالب</div>
                <textarea class="editor" id="templateEditor" oninput="updatePreview()">@(club?.ReceiptTemplate ?? "")</textarea>
                <button class="save-btn" onclick="saveTemplate()">💾 حفظ القالب</button>
            </div>
            <div class="card">
                <div class="card-title">👁️ معاينة</div>
                <div class="preview-box" id="previewBox"></div>
            </div>
        </div>
    </div>
    <script>
        function defaultTemplate() {
            return `<div style="text-align:center;padding:20px;">
        <h2 style="color:#1e2a38;">🥋 وصل دفع اشتراك</h2>
        <h3 style="color:#4a90e2;">{{اسم_النادي}}</h3>
        <hr style="margin:16px 0;">
        <table style="width:100%;font-size:14px;">
        <tr><td>اسم اللاعب:</td><td><strong>{{اسم_اللاعب}}</strong></td></tr>
        <tr><td>الشهر:</td><td>{{الشهر}} {{السنة}}</td></tr>
        <tr><td>رقم الوصل:</td><td>{{رقم_الوصل}}</td></tr>
        <tr><td>التاريخ:</td><td>{{التاريخ}}</td></tr>
        <tr><td style="color:#27ae60;font-size:16px;">المبلغ:</td><td><strong style="color:#27ae60;font-size:16px;">{{المبلغ}} ₪</strong></td></tr>
        </table>
        <hr style="margin:16px 0;">
        <p style="font-size:12px;color:#888;">شكراً لدفعكم في الوقت المحدد 🏅</p>
        </div>`;
        }
        function updatePreview() {
            const template = document.getElementById('templateEditor').value;
            const preview = template
                .replace(/{{اسم_اللاعب}}/g, 'محمد أحمد')
                .replace(/{{اسم_النادي}}/g, '@(club?.Name ?? "نادي الكاراتيه")')
                .replace(/{{الشهر}}/g, 'يناير')
                .replace(/{{السنة}}/g, '2026')
                .replace(/{{المبلغ}}/g, '150')
                .replace(/{{التاريخ}}/g, new Date().toLocaleDateString('ar-SA'))
                .replace(/{{رقم_الوصل}}/g, '1001');
            document.getElementById('previewBox').innerHTML = preview;
        }
        function insertVar(variable) {
            const editor = document.getElementById('templateEditor');
            const start = editor.selectionStart;
            const end = editor.selectionEnd;
            editor.value = editor.value.substring(0, start) + variable + editor.value.substring(end);
            editor.selectionStart = editor.selectionEnd = start + variable.length;
            editor.focus();
            updatePreview();
        }
        function saveTemplate() {
            const template = document.getElementById('templateEditor').value;
            fetch('/Club/SaveReceiptTemplate', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ template }) })
                .then(r => r.json()).then(data => {
                    if (data.success) alert('✅ تم حفظ القالب بنجاح');
                });
        }
        document.addEventListener('DOMContentLoaded', () => {
            const editor = document.getElementById('templateEditor');
            if (!editor.value.trim()) editor.value = defaultTemplate();
            updatePreview();
        });
    </script>
</body>
</html>