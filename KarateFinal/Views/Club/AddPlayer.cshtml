@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/png" href="/image/www.png">
    <title>إضافة لاعب</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body { font-family:'Segoe UI',sans-serif; background:#0d1117; min-height:100vh; display:flex; align-items:center; justify-content:center; }
        .card { background:#161b22; border:1px solid #30363d; border-radius:16px; padding:36px 32px; width:100%; max-width:500px; }
        h2 { color:white; margin-bottom:24px; font-size:1.4rem; }
        .field { display:flex; flex-direction:column; gap:6px; margin-bottom:16px; }
        label { color:#8b949e; font-size:13px; font-weight:600; }
        input, select { padding:10px 14px; background:#0d1117; border:1.5px solid #30363d; border-radius:8px; color:white; font-size:14px; width:100%; }
        input:focus, select:focus { outline:none; border-color:#4a90e2; }
        .btn { width:100%; padding:12px; background:#4a90e2; color:white; border:none; border-radius:8px; font-size:15px; font-weight:700; cursor:pointer; margin-top:8px; }
        .btn:hover { background:#1e6fc4; }
        .back { display:block; text-align:center; margin-top:16px; color:#4a90e2; text-decoration:none; font-size:13px; }
    </style>
</head>
<body>
    <div class="card">
        <h2>🥋 تسجيل لاعب جديد</h2>
        <form method="post">
            <input type="hidden" name="ClubId" value="@ViewBag.ClubId">
            <div class="field">
                <label>اسم اللاعب *</label>
                <input type="text" name="Name" placeholder="أدخل اسم اللاعب" required>
            </div>
            <div class="field">
                <label>العمر *</label>
                <input type="date" name="BirthDate" required>
            </div>
            <div class="field">
                <label>الجنس</label>
                <select name="Gender">
                    <option value="ذكر">ذكر</option>
                    <option value="أنثى">أنثى</option>
                </select>
            </div>
            <div class="field">
                <label>الحزام</label>
                <select name="Belt">
                    <option>أبيض</option>
                    <option>أصفر</option>
                    <option>برتقالي</option>
                    <option>أخضر</option>
                    <option>أزرق</option>
                    <option>بني</option>
                    <option>أسود</option>
                </select>
            </div>
            <div class="field">
                <label>الوزن (كغ)</label>
                <input type="number" name="Weight" placeholder="الوزن" step="0.1">
            </div>
            <div class="field">
                <label>البريد الإلكتروني</label>
                <input type="email" name="Email" placeholder="example@email.com">
            </div>
            <button type="submit" class="btn">✅ تسجيل اللاعب</button>
        </form>
        <a href="/Club/Dashboard" class="back">← العودة للوحة النادي</a>
    </div>
</body>
</html>