@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إضافة لاعب</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI',sans-serif;
            background: #0d1117;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .card {
            background: #161b22;
            border: 1px solid #30363d;
            border-radius: 16px;
            padding: 36px 32px;
            width: 100%;
            max-width: 500px;
        }

        h2 {
            color: white;
            margin-bottom: 24px;
            font-size: 1.4rem;
        }

        .field {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 16px;
        }

        label {
            color: #8b949e;
            font-size: 13px;
            font-weight: 600;
        }

        input, select {
            padding: 10px 14px;
            background: #0d1117;
            border: 1.5px solid #30363d;
            border-radius: 8px;
            color: white;
            font-size: 14px;
            width: 100%;
            font-family: inherit;
            transition: border-color 0.2s;
        }

            input:focus, select:focus {
                outline: none;
                border-color: #4a90e2;
            }

        .name-error {
            color: #e74c3c;
            font-size: 11px;
            margin-top: 2px;
            display: none;
        }

        .btn {
            width: 100%;
            padding: 12px;
            background: #4a90e2;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            margin-top: 8px;
            font-family: inherit;
            transition: 0.2s;
        }

            .btn:hover {
                background: #1e6fc4;
            }
    </style>
<link rel="stylesheet" href="/css/dark.css"><script>function applyTheme(t){const l=t==='light';document.body.style.setProperty('background',l?'#f0f4f8':'#0f1923','important');document.body.style.setProperty('color',l?'#1e2a38':'#f1f5f9','important');document.querySelectorAll('.theme-btn').forEach(b=>b.textContent=l?'☀️':'🌙');localStorage.setItem('theme',t);}function toggleTheme(){applyTheme(localStorage.getItem('theme')==='light'?'dark':'light');}document.addEventListener('DOMContentLoaded',()=>applyTheme(localStorage.getItem('theme')||'dark'));</script>
<body>
    <div class="card">
        <h2>🥋 تسجيل لاعب جديد</h2>
        <form method="post" onsubmit="return validateForm()">
            <input type="hidden" name="ClubId" value="@ViewBag.ClubId">
            <div class="field">
                <label>اسم اللاعب الكامل *</label>
                <input type="text" name="Name" id="playerName"
                       placeholder="الاسم الأول واسم الأب واسم العائلة" required
                       oninput="checkName(this)">
                <span class="name-error" id="nameError"></span>
            </div>
            <div class="field">
                <label>تاريخ الميلاد *</label>
                <input type="date" name="BirthDate" required>
            </div>
            <div class="field">
                <label>الجنس</label>
                <select name="Gender">
                    <option value="ذكر">ذكر</option>
                    <option value="أنثى">أنثى</option>
                </select>
            </div>
            <div class="field">
                <label>الحزام</label>
                <select name="Belt">
                    <option>أبيض</option>
                    <option>أصفر</option>
                    <option>برتقالي</option>
                    <option>أخضر</option>
                    <option>أزرق</option>
                    <option>بني</option>
                    <option>أسود</option>
                </select>
            </div>
            <div class="field">
                <label>الوزن (كغ)</label>
                <input type="number" name="Weight" placeholder="الوزن" step="0.1" min="0">
            </div>
            <div class="field">
                <label>البريد الإلكتروني</label>
                <input type="email" name="Email" id="playerEmail"
                       placeholder="example@email.com"
                       onblur="checkEmail(this.value)">
                <span class="name-error" id="emailError"></span>
            </div>
            <button type="submit" class="btn">✅ تسجيل اللاعب</button>
        </form>
    </div>
    <script>
        function validateName(name) {
            const parts = name.trim().split(/\s+/);
            if (parts.length < 3) return "يجب إدخال الاسم الأول واسم الأب واسم العائلة";
            const valid = /^[\u0600-\u06FF a-zA-Z\s]+$/;
            if (!valid.test(name)) return "الاسم يجب أن يحتوي على أحرف فقط بدون أرقام أو رموز";
            return null;
        }
        function checkName(input) {
            const error = validateName(input.value);
            const span = document.getElementById('nameError');
            span.textContent = error || '';
            span.style.display = error ? 'block' : 'none';
            input.style.borderColor = error ? '#e74c3c' : '';
        }
        function checkEmail(email) {
            if (!email) return;
            fetch('/Club/CheckPlayerEmail', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: email })
            }).then(r => r.json()).then(data => {
                const span = document.getElementById('emailError');
                span.textContent = data.exists ? '⚠️ هذا الإيميل مسجّل مسبقاً' : '';
                span.style.display = data.exists ? 'block' : 'none';
                document.getElementById('playerEmail').style.borderColor = data.exists ? '#e74c3c' : '';
            }).catch(() => { });
        }
        function validateForm() {
            const name = document.getElementById('playerName').value;
            const nameError = validateName(name);
            if (nameError) {
                const span = document.getElementById('nameError');
                span.textContent = nameError;
                span.style.display = 'block';
                document.getElementById('playerName').style.borderColor = '#e74c3c';
                return false;
            }
            const emailSpan = document.getElementById('emailError');
            if (emailSpan.style.display === 'block' && emailSpan.textContent) {
                return false;
            }
            return true;
        }
    </script>
</body>
</html>
