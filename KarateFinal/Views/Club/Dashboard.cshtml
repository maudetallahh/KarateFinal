@{
    Layout = null;
    var username = Context.Session.GetString("Username");
}
<!DOCTYPE html>
<html lang="ar" dir="rtl" id="htmlRoot">
<head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/png" href="/images/test.jpg">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة تحكم النادي</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI',Tahoma,sans-serif;
        }

        body {
            background-color: #eef3f8;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        nav {
            background-color: #1e2a38;
            color: white;
            padding: 14px 24px;
            display: flex;
            justify-content: center;
            align-items: center;
            border-bottom: 4px solid #4a90e2;
            position: sticky;
            top: 0;
            z-index: 1000;
            min-height: 70px;
        }

        .nav-header {
            text-align: center;
        }

            .nav-header h1 {
                font-size: 22px;
                color: #ffffff;
                letter-spacing: 1px;
            }

            .nav-header h2 {
                font-size: 13px;
                color: #d1d5db;
                font-weight: normal;
                margin-top: 4px;
            }

        nav ul {
            position: absolute;
            left: 24px;
            display: flex;
            list-style: none;
            align-items: center;
            gap: 16px;
            overflow: visible;
        }

            nav ul li a {
                text-decoration: none;
                color: white;
                font-weight: bold;
                transition: 0.3s;
                font-size: 14px;
            }

                nav ul li a:hover {
                    color: #81b3f7;
                }

        .login-btn {
            background-color: #2c3e50;
            padding: 7px 18px;
            border-radius: 5px;
            border: 2px solid transparent;
            transition: 0.3s ease;
            font-size: 13px;
        }

            .login-btn:hover {
                background-color: transparent;
                color: #ffffff;
                border: 2px solid #4a90e2;
            }

        .nav-logo {
            position: absolute;
            right: 24px;
            height: 50px;
            object-fit: contain;
        }

        .hamburger {
            display: none;
            flex-direction: column;
            gap: 5px;
            cursor: pointer;
            position: absolute;
            left: 16px;
            z-index: 10;
        }

        [data-theme="light"] {
            --bg: #f0f4f8;
            --nav-bg: #1e2a38;
            --card-bg: #ffffff;
            --text: #1e2a38;
            --muted: #666;
            --border: #e0e6ed;
        }

        [data-theme="dark"] {
            --bg: #0f1923;
            --nav-bg: #1a2535;
            --card-bg: #1a2535;
            --text: #f1f5f9;
            --muted: #94a3b8;
            --border: #2d3f55;
        }

        body {
            background: var(--bg);
            color: var(--text);
        }
            .hamburger span {
                width: 25px;
                height: 2px;
                background: white;
                border-radius: 2px;
                transition: 0.3s;
            }

            .hamburger.open span:nth-child(1) {
                transform: rotate(45deg) translate(5px,5px);
            }

            .hamburger.open span:nth-child(2) {
                opacity: 0;
            }

            .hamburger.open span:nth-child(3) {
                transform: rotate(-45deg) translate(5px,-5px);
            }

        .mobile-menu {
            display: none;
            flex-direction: column;
            background: #1e2a38;
            padding: 10px 20px;
            gap: 8px;
            border-bottom: 2px solid #4a90e2;
        }

            .mobile-menu a {
                color: white;
                text-decoration: none;
                font-size: 14px;
                padding: 10px 0;
                border-bottom: 1px solid #2c3e50;
            }

            .mobile-menu.show {
                display: flex;
            }

        .lang-btn {
            background: rgba(74,144,226,0.2);
            border: 1px solid rgba(74,144,226,0.4);
            color: #81b3f7;
            padding: 6px 14px;
            border-radius: 20px;
            cursor: pointer;
            font-size: 12px;
            font-weight: bold;
            font-family: inherit;
            white-space: nowrap;
        }

        .main-header {
            position: relative;
            background-color: #fff;
            padding: 50px 20px 40px;
            text-align: center;
            border-bottom: 5px solid #323232;
            overflow: hidden;
        }

            .main-header::before {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(135deg,#1e2a38,#2c3e50);
                z-index: 0;
                opacity: 0.9;
            }

        .titles {
            position: relative;
            z-index: 2;
            margin-bottom: 32px;
        }

            .titles h1 {
                font-size: 36px;
                color: #4a90e2;
                margin-bottom: 10px;
                text-shadow: 2px 2px 8px rgba(0,0,0,0.5);
            }

            .titles .slogan {
                font-size: 17px;
                color: #e2e8f0;
                margin-bottom: 14px;
            }

        .welcome-badge {
            display: inline-block;
            background: rgba(74,144,226,0.2);
            border: 1px solid rgba(74,144,226,0.4);
            color: #81b3f7;
            padding: 7px 18px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
        }

        .hero-circles {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 40px;
            position: relative;
            z-index: 2;
            flex-wrap: wrap;
        }

        .player-wrapper, .player-wrapper-bottom {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
        }

        .circle {
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #fdfdfd;
            border: 4px solid #4a90e2;
            box-shadow: 0 8px 25px rgba(0,0,0,0.3);
            overflow: hidden;
            transition: all 0.3s ease;
            position: relative;
            cursor: pointer;
        }

            .circle:hover {
                transform: scale(1.07);
                box-shadow: 0 12px 35px rgba(74,144,226,0.5);
                border-color: #81b3f7;
            }

        .main-circle {
            width: 180px;
            height: 180px;
        }

        .side-circle {
            width: 120px;
            height: 120px;
        }

        .circle img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
            display: block;
        }

        .circle-inner {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg,#1e2a38,#34495e);
            color: white;
        }

        .main-circle .circle-inner {
            font-size: 55px;
        }

        .side-circle .circle-inner {
            font-size: 38px;
        }

        .change-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(0,0,0,0.75);
            color: white;
            font-size: 11px;
            font-weight: bold;
            padding: 7px;
            text-align: center;
            opacity: 0;
            transition: 0.3s;
        }

        .circle:hover .change-overlay {
            opacity: 1;
        }

        .player-label {
            font-size: 13px;
            font-weight: bold;
            color: #fff;
            background: rgba(74,144,226,0.3);
            border: 1px solid rgba(74,144,226,0.5);
            padding: 5px 14px;
            border-radius: 20px;
            backdrop-filter: blur(4px);
        }

        .cards-section {
            margin-top: 40px;
            flex-grow: 1;
            padding: 16px;
        }

        .cards-container {
            max-width: 1100px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .cards-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .cards-row-3 {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 20px;
        }

        .info-card {
            background: white;
            padding: 26px 22px;
            border-radius: 15px;
            text-align: center;
            border: 2px solid #e1e8ed;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

            .info-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: linear-gradient(90deg,#34495e,#4a90e2);
                transform: scaleX(0);
                transition: transform 0.3s ease;
            }

            .info-card:hover::before {
                transform: scaleX(1);
            }

            .info-card:hover {
                border-color: #4a90e2;
                transform: translateY(-6px);
                box-shadow: 0 12px 30px rgba(0,0,0,0.1);
            }

            .info-card .icon {
                font-size: 38px;
                margin-bottom: 12px;
            }

            .info-card h3 {
                margin-bottom: 10px;
                font-size: 20px;
                color: #2c3e50;
            }

            .info-card p {
                color: #666;
                font-size: 14px;
                margin-bottom: 18px;
                line-height: 1.6;
            }

        .card-btn {
            display: inline-block;
            padding: 10px 24px;
            background: linear-gradient(135deg,#34495e,#2c3e50);
            color: white;
            text-decoration: none;
            border-radius: 25px;
            font-size: 13px;
            font-weight: bold;
            transition: all 0.3s ease;
        }

            .card-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(74,144,226,0.4);
                background: linear-gradient(135deg,#4a90e2,#1e6fc4);
            }

        footer {
            background: #1e2a38;
            color: white;
            padding: 40px 24px 0;
            direction: rtl;
            margin-top: 40px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit,minmax(160px,1fr));
            gap: 24px;
            padding-bottom: 32px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .footer-col h3 {
            font-size: 14px;
            font-weight: 600;
            color: #e2e8f0;
            margin-bottom: 12px;
        }

        .footer-col.brand h3 {
            font-size: 15px;
            color: #81b3f7;
            border-right: 3px solid #4a90e2;
            padding-right: 10px;
        }

        .footer-col p {
            font-size: 12px;
            color: #94a3b8;
            line-height: 1.8;
        }

        .footer-col ul {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

            .footer-col ul li a {
                color: #94a3b8;
                text-decoration: none;
                font-size: 12px;
            }

                .footer-col ul li a:hover {
                    color: #81b3f7;
                }

        .social-links {
            display: flex;
            gap: 8px;
            margin-top: 14px;
        }

            .social-links a {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                background: rgba(74,144,226,0.15);
                border: 1px solid rgba(74,144,226,0.3);
                display: flex;
                align-items: center;
                justify-content: center;
                text-decoration: none;
                color: #81b3f7;
                font-size: 13px;
            }

        .contact-item {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 10px;
        }

        .contact-icon {
            width: 26px;
            height: 26px;
            border-radius: 6px;
            background: rgba(74,144,226,0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
        }

        .contact-item span {
            color: #94a3b8;
            font-size: 12px;
        }

        .footer-bottom {
            display: flex;
            justify-content: center;
            padding: 16px 0;
        }

            .footer-bottom p {
                color: #475569;
                font-size: 11px;
            }

        @@media(max-width:1024px) {
            .cards-row-3 {
                grid-template-columns: 1fr 1fr;
            }

            .main-circle {
                width: 160px;
                height: 160px;
            }

            .side-circle {
                width: 110px;
                height: 110px;
            }
        }

        @@media(max-width:768px) {
            nav ul {
                display: none;
            }

            .nav-logo {
                display: none;
            }

            .hamburger {
                display: flex;
            }

            .lang-btn {
                position: absolute;
                left: 56px;
                top: 50%;
                transform: translateY(-50%);
            }

            .cards-row {
                grid-template-columns: 1fr;
            }

            .cards-row-3 {
                grid-template-columns: 1fr;
            }

            .hero-circles {
                gap: 20px;
            }

            .titles h1 {
                font-size: 24px;
            }

            .titles .slogan {
                font-size: 14px;
            }

            .main-circle {
                width: 150px;
                height: 150px;
            }

            .side-circle {
                width: 100px;
                height: 100px;
            }

            .main-circle .circle-inner {
                font-size: 45px;
            }

            .side-circle .circle-inner {
                font-size: 32px;
            }

            .main-header {
                padding: 36px 16px 30px;
            }

            .cards-section {
                padding: 12px;
                margin-top: 24px;
            }

            .info-card {
                padding: 20px 16px;
            }

            footer {
                padding: 30px 16px 0;
            }

            .footer-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media(max-width:480px) {
            .nav-header h1 {
                font-size: 17px;
            }

            .nav-header h2 {
                font-size: 11px;
            }

            .titles h1 {
                font-size: 20px;
            }

            .hero-circles {
                flex-direction: column;
                gap: 16px;
            }

            .player-wrapper, .player-wrapper-bottom {
                flex-direction: row;
                gap: 16px;
                align-items: center;
            }

            .footer-grid {
                grid-template-columns: 1fr;
            }

            .welcome-badge {
                font-size: 12px;
                padding: 6px 14px;
            }
        }

        .dropdown {
            position: relative;
        }

        .dropdown-menu {
            display: none;
            position: absolute;
            top: 40px;
            left: 0;
            background: #1e2a38;
            border: 1px solid #4a90e2;
            border-radius: 8px;
            min-width: 200px;
            z-index: 9999;
            flex-direction: column;
            box-shadow: 0 8px 20px rgba(0,0,0,0.3);
        }

            .dropdown-menu.open {
                display: flex;
            }

        .dropdown-menu a {
            padding: 12px 16px;
            color: #f1f5f9;
            text-decoration: none;
            font-size: 13px;
            border-bottom: 1px solid #2d3f55;
            display: block;
            white-space: nowrap;
        }

            .dropdown-menu a:hover {
                background: rgba(74,144,226,0.15);
                color: #81b3f7;
            }

            .dropdown-menu a:last-child {
                border-bottom: none;
                border-radius: 0 0 8px 8px;
            }

        footer, footer * {
            color: #ffffff !important;
        }

            footer a {
                color: #8b949e !important;
            }

                footer a:hover {
                    color: #4a90e2 !important;
                }
    </style>
<link rel="stylesheet" href="/css/dark.css"><script>function applyTheme(t){const l=t==='light';document.body.style.setProperty('background',l?'#f0f4f8':'#0f1923','important');document.body.style.setProperty('color',l?'#1e2a38':'#f1f5f9','important');document.querySelectorAll('.theme-btn').forEach(b=>b.textContent=l?'☀️':'🌙');localStorage.setItem('theme',t);}function toggleTheme(){applyTheme(localStorage.getItem('theme')==='light'?'dark':'light');}document.addEventListener('DOMContentLoaded',()=>applyTheme(localStorage.getItem('theme')||'dark'));</script>
</head>
<body>
    <nav>
        <div class="nav-header">
            <h1>منصة الكاراتيه الفلسطينية</h1>
            <h2>اصنع تاريخك ...وكن بطلاً</h2>
        </div>
        <a href="/Home/Index">
            @await Html.PartialAsync("_NavLogo")
        </a>
        <div style="position:absolute;left:24px;display:flex;align-items:center;gap:16px;">
            <a href="/Club/Dashboard" style="color:white;text-decoration:none;font-size:14px;font-weight:bold;">الرئيسية</a>
            <a href="/Club/Tournaments" style="color:white;text-decoration:none;font-size:14px;font-weight:bold;">البطولات</a>
            <div class="dropdown">
                <a href="#" onclick="return false;" style="color:white;text-decoration:none;font-size:14px;font-weight:bold;">☰ القائمة</a>
                <div class="dropdown-menu">
                    <a href="/Club/Profile">⚙️ معلوماتي</a>
                    <a href="/Club/Messages">💬 المراسلات</a>
                    <a href="/Club/Payment">💳 دفع العضوية</a>
                    <a href="/Club/PrintPlayers">🖨️ طباعة اللاعبين</a>
                    <a href="/Account/Logout">🚪 تسجيل خروج</a>
                </div>
            </div>
        </div>
        <div class="hamburger" id="hamburger"><span></span><span></span><span></span></div>
        <button onclick="toggleTheme()" id="themeBtn" style="background:rgba(255,255,255,0.1);border:none;color:white;padding:6px 12px;border-radius:8px;cursor:pointer;font-size:16px;">🌙</button>
        <button onclick="toggleLang()" id="langBtn" class="lang-btn">EN</button>
    </nav>
    <div class="mobile-menu" id="mobileMenu">
        <a href="/Club/Dashboard">🏠 الرئيسية</a>
        <a href="/Club/Tournaments">🏆 البطولات</a>
        <a href="/Club/Profile">⚙️ معلوماتي</a>
        <a href="/Club/Messages">💬 المراسلات</a>
        <a href="/Club/Payment">💳 دفع العضوية</a>
        <a href="/Club/PrintPlayers">🖨️ طباعة اللاعبين</a>
        <a href="/Account/Logout" style="color:#f85149;">🚪 تسجيل خروج</a>
    </div>
    <header class="main-header">
        <div class="titles">
            <h1>🥋 منصة الكاراتيه الفلسطينية</h1>
            <p class="slogan">اصنع تاريخك ...وكن بطلاً</p>
            <span class="welcome-badge">👋 @username</span>
            <div style="color:#81b3f7;font-size:12px;margin-top:8px;">🕐 آخر تسجيل دخول: @ViewBag.LastLogin</div>
        </div>
        <div class="hero-circles">
            <div class="player-wrapper-bottom">
                <div class="circle side-circle" onclick="document.getElementById('femaleInput').click()">
                    <img id="femaleImg" src="@(ViewBag.FemaleImage ?? "")" alt="" style="@(ViewBag.FemaleImage != null ? "display:block;" : "display:none;")">
                    <div class="circle-inner" id="femaleIcon" style="@(ViewBag.FemaleImage != null ? "display:none;" : "")">👩</div>
                    <div class="change-overlay">📷 تغيير</div>
                </div>
                <input type="file" id="femaleInput" accept="image/*" hidden onchange="changeImage('femaleImg','femaleIcon',this,'female')">
                <span class="player-label">اللاعبة المميزة</span>
            </div>
            <div class="player-wrapper" style="align-items:center;">
                <div class="circle main-circle" onclick="document.getElementById('logoInput').click()">
                    <img id="logoImg" src="@(ViewBag.LogoImage ?? "")" alt="" style="@(ViewBag.LogoImage != null ? "display:block;" : "display:none;")">
                    <div class="circle-inner" id="logoIcon" style="@(ViewBag.LogoImage != null ? "display:none;" : "")">🏆</div>
                    <div class="change-overlay">📷 تغيير الشعار</div>
                </div>
                <input type="file" id="logoInput" accept="image/*" hidden onchange="changeImage('logoImg','logoIcon',this,'logo')">
                <span class="player-label" style="margin-top:8px;">شعار النادي</span>
            </div>
            <div class="player-wrapper">
                <div class="circle side-circle" onclick="document.getElementById('maleInput').click()">
                    <img id="maleImg" src="@(ViewBag.MaleImage ?? "")" alt="" style="@(ViewBag.MaleImage != null ? "display:block;" : "display:none;")">
                    <div class="circle-inner" id="maleIcon" style="@(ViewBag.MaleImage != null ? "display:none;" : "")">👨</div>
                    <div class="change-overlay">📷 تغيير</div>
                </div>
                <input type="file" id="maleInput" accept="image/*" hidden onchange="changeImage('maleImg','maleIcon',this,'male')">
                <span class="player-label">لاعب مميز</span>
            </div>
        </div>
    </header>
    <section class="cards-section">
        <div class="cards-container">
            <div class="cards-row-3">
                <div class="info-card">
                    <div class="icon">➕</div>
                    <h3>تسجيل لاعب/ة</h3>
                    <p>يمكنك تسجيل لاعب/ة جديد في ناديك من هنا!</p>
                    <a href="/Club/AddPlayer" class="card-btn">تسجيل الآن</a>
                </div>
                <div class="info-card">
                    <div class="icon">📋</div>
                    <h3>الاستحقاقات</h3>
                    <p>استحقاقاتك تعكس جهودك وتحدد مسارك نحو التميز.</p>
                    <a href="/Club/Entitlements" class="card-btn">عرض الاستحقاقات</a>
                </div>
                <div class="info-card">
                    <div class="icon">👤</div>
                    <h3>المسؤولون</h3>
                    <p>إضافة وإدارة الحكام والمدربين والإداريين في ناديك.</p>
                    <a href="/Official/Index" class="card-btn">إدارة المسؤولين</a>
                </div>
            </div>
            <div class="cards-row-3">
                <div class="info-card">
                    <div class="icon">⭐</div>
                    <h3>اللاعبين</h3>
                    <p>تعرف على لاعبين ولاعبات النادي لديك ونقاطهم في البطولات.</p>
                    <a href="/Club/Best" class="card-btn">عرض التفاصيل</a>
                </div>
                <div class="info-card">
                    <div class="icon">🏅</div>
                    <h3>مشاركاتي</h3>
                    <p>عرض البطولات التي شاركت بها والنتائج الخاصة بك ومجموع النقاط.</p>
                    <a href="/Club/Participation" class="card-btn">عرض التفاصيل</a>
                </div>
                <div class="info-card">
                    <div class="icon">🏆</div>
                    <h3>البطولات</h3>
                    <p>سجّل ناديك في البطولات المتاحة واختر لاعبيك للمشاركة.</p>
                    <a href="/Club/Tournaments" class="card-btn">عرض البطولات</a>
                </div>
           
            </div>
        </div>
    </section>

    <script>
        function toggleMenu() {
            document.getElementById('hamburger').classList.toggle('open');
            document.getElementById('mobileMenu').classList.toggle('show');
        }
        function changeImage(imgId, iconId, input, type) {
            const file = input.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function (e) {
                const img = document.getElementById(imgId);
                const icon = document.getElementById(iconId);
                img.src = e.target.result;
                img.style.display = 'block';
                icon.style.display = 'none';
                fetch('/Club/SaveImages', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        logoImage: type === 'logo' ? e.target.result : null,
                        maleImage: type === 'male' ? e.target.result : null,
                        femaleImage: type === 'female' ? e.target.result : null
                    })
                });
            };
            reader.readAsDataURL(file);
        }
        const translations = {
            ar: {
                nav_home: "الرئيسية", nav_tournaments: "البطولات", nav_profile: "⚙️ معلوماتي", nav_logout: "تسجيل خروج",
                title: "منصة الكاراتيه الفلسطينية", slogan: "اصنع تاريخك ...وكن بطلاً",
                card1_title: "مشاركاتي", card1_desc: "عرض البطولات التي شاركت بها والنتائج الخاصة بك.", card1_btn: "عرض التفاصيل",
                card2_title: "اللاعبين", card2_desc: "تعرف على لاعبين ولاعبات النادي لديك.", card2_btn: "عرض التفاصيل",
                card3_title: "تسجيل لاعب/ة", card3_desc: "يمكنك تسجيل لاعب/ة جديد في ناديك من هنا!", card3_btn: "تسجيل الآن",
                card4_title: "الاستحقاقات", card4_desc: "استحقاقاتك تعكس جهودك وتحدد مسارك.", card4_btn: "عرض الاستحقاقات",
                card5_title: "البطولات", card5_desc: "سجّل ناديك في البطولات المتاحة واختر لاعبيك.", card5_btn: "عرض البطولات",
                logo_label: "شعار النادي", male_label: "لاعب مميز", female_label: "اللاعبة المميزة",
                footer_title: "منصة الكاراتيه الفلسطينية", copyright: "© 2025 منصة الكاراتيه الفلسطينية — جميع الحقوق محفوظة"
            },
            en: {
                nav_home: "Home", nav_tournaments: "Tournaments", nav_profile: "⚙️ My Profile", nav_logout: "Logout",
                title: "Palestinian Karate Platform", slogan: "Make your history... Be a champion",
                card1_title: "My Participations", card1_desc: "View tournaments you participated in and your results.", card1_btn: "View Details",
                card2_title: "Players", card2_desc: "View your club players and their tournament points.", card2_btn: "View Details",
                card3_title: "Register Player", card3_desc: "You can register a new player in your club here!", card3_btn: "Register Now",
                card4_title: "Entitlements", card4_desc: "Your entitlements reflect your efforts and excellence.", card4_btn: "View Entitlements",
                card5_title: "Tournaments", card5_desc: "Register your club in available tournaments.", card5_btn: "View Tournaments",
                logo_label: "Club Logo", male_label: "Featured Male Player", female_label: "Featured Female Player",
                footer_title: "Palestinian Karate Platform", copyright: "© 2025 Palestinian Karate Platform — All Rights Reserved"
            }
        };
        let currentLang = localStorage.getItem("lang") || "ar";
        function applyLang(lang) {
            const t = translations[lang];
            const isAr = lang === "ar";
            document.documentElement.lang = lang;
            document.documentElement.dir = isAr ? "rtl" : "ltr";
            document.getElementById("langBtn").textContent = isAr ? "EN" : "عر";
            document.querySelector(".nav-header h1").textContent = t.title;
            document.querySelector(".nav-header h2").textContent = t.slogan;
            const navLinks = document.querySelectorAll("nav ul li a");
            if (navLinks[0]) navLinks[0].textContent = t.nav_home;
            if (navLinks[1]) navLinks[1].textContent = t.nav_tournaments;
            if (navLinks[2]) navLinks[2].textContent = t.nav_profile;
            if (navLinks[3]) navLinks[3].textContent = t.nav_logout;
            document.querySelector(".titles h1").textContent = "🥋 " + t.title;
            document.querySelector(".slogan").textContent = t.slogan;
            
            const labels = document.querySelectorAll(".player-label");
            if (labels[0]) labels[0].textContent = t.female_label;
            if (labels[1]) labels[1].textContent = t.logo_label;
            if (labels[2]) labels[2].textContent = t.male_label;
            document.querySelector(".footer-col.brand h3").textContent = t.footer_title;
            document.querySelector(".footer-bottom p").textContent = t.copyright;
            localStorage.setItem("lang", lang);
        }
        function toggleLang() { currentLang = currentLang === "ar" ? "en" : "ar"; applyLang(currentLang); }
        document.addEventListener("DOMContentLoaded", () => applyLang(currentLang));
        document.querySelector('.dropdown a').addEventListener('click', function (e) {
            e.preventDefault();
            document.querySelector('.dropdown-menu').classList.toggle('open');
        });

        document.addEventListener('click', function (e) {
            if (!e.target.closest('.dropdown')) {
                document.querySelector('.dropdown-menu')?.classList.remove('open');
            }
        });
        function toggleTheme() {
            const html = document.getElementById('htmlRoot');
            const current = html.getAttribute('data-theme') || 'dark';
            const next = current === 'dark' ? 'light' : 'dark';
            html.setAttribute('data-theme', next);
            document.getElementById('themeBtn').textContent = next === 'dark' ? '🌙' : '☀️';
            localStorage.setItem('theme', next);
        }

        document.addEventListener('DOMContentLoaded', () => {
            const saved = localStorage.getItem('theme') || 'dark';
            document.getElementById('htmlRoot').setAttribute('data-theme', saved);
            document.getElementById('themeBtn').textContent = saved === 'dark' ? '🌙' : '☀️';
        });
    </script>
    <script>
        function applyTheme(t) {
            const l = t === 'light';
            const bg = l ? '#f0f4f8' : '#0f1923';
            const text = l ? '#1e2a38' : '#f1f5f9';
            const cardBg = l ? '#ffffff' : '#1e2d3d';
            const border = l ? '#e0e6ed' : '#2d4a6b';

            document.body.style.setProperty('background', bg, 'important');
            document.body.style.setProperty('color', text, 'important');

            // تغيير الخطوط
            document.querySelectorAll('h1,h2,h3,h4,h5,p,span,td,th,label,div,a,li').forEach(el => {
                if (!el.closest('nav') && !el.closest('.btn') && !el.closest('.card-btn') && !el.closest('.login-btn')) {
                    el.style.setProperty('color', text, 'important');
                }
            });

            // تغيير البطاقات
            document.querySelectorAll('.info-card,.card,.stat-card,.year-section,.summary-card,.table-wrap,.payment-card').forEach(el => {
                el.style.setProperty('background', cardBg, 'important');
                el.style.setProperty('border-color', border, 'important');
            });

            // تغيير الـ inputs
            document.querySelectorAll('input,select,textarea').forEach(el => {
                el.style.setProperty('background', l ? '#fff' : '#0f1923', 'important');
                el.style.setProperty('color', text, 'important');
                el.style.setProperty('border-color', border, 'important');
            });

            document.querySelectorAll('.theme-btn').forEach(b => b.textContent = l ? '☀️' : '🌙');
            localStorage.setItem('theme', t);
        } function toggleTheme() { applyTheme(localStorage.getItem('theme') === 'light' ? 'dark' : 'light'); }
        document.addEventListener('DOMContentLoaded', () => applyTheme(localStorage.getItem('theme') || 'dark'));
    </script>
@await Html.PartialAsync("_Footer")</body>

</html>
