@{
    Layout = null;
    var username = Context.Session.GetString("Username");
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/png" href="/images/test.jpg">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة تحكم النادي</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; font-family:'Segoe UI',Tahoma,sans-serif; }
        body { background-color:#eef3f8; display:flex; flex-direction:column; min-height:100vh; }
        nav { background-color:#1e2a38; color:white; padding:20px 50px; display:flex; justify-content:center; align-items:center; border-bottom:4px solid #4a90e2; position:sticky; top:0; z-index:1000; }
        .nav-header { text-align:center; }
        .nav-header h1 { font-size:26px; color:#ffffff; letter-spacing:1px; }
        .nav-header h2 { font-size:14px; color:#d1d5db; font-weight:normal; margin-top:5px; }
        nav ul { position:absolute; left:50px; display:flex; list-style:none; align-items:center; }
        nav ul li { margin-left:25px; }
        nav ul li a { text-decoration:none; color:white; font-weight:bold; transition:0.3s; font-size:15px; }
        nav ul li a:hover { color:#81b3f7; }
        .login-btn { background-color:#2c3e50; padding:8px 25px; border-radius:5px; border:2px solid transparent; transition:0.3s ease; }
        .login-btn:hover { background-color:transparent; color:#ffffff; border:2px solid #4a90e2; }
        .hamburger { display:none; flex-direction:column; gap:5px; cursor:pointer; position:absolute; right:20px; }
        .hamburger span { width:25px; height:2px; background:white; border-radius:2px; transition:0.3s; }
        .hamburger.open span:nth-child(1) { transform:rotate(45deg) translate(5px,5px); }
        .hamburger.open span:nth-child(2) { opacity:0; }
        .hamburger.open span:nth-child(3) { transform:rotate(-45deg) translate(5px,-5px); }
        .mobile-menu { display:none; flex-direction:column; background:#1e2a38; padding:10px 20px; gap:10px; }
        .mobile-menu a { color:white; text-decoration:none; font-size:15px; padding:8px 0; border-bottom:1px solid #2c3e50; }
        .mobile-menu.show { display:flex; }
        .main-header { position:relative; background-color:#fff; padding:60px 20px 50px; text-align:center; border-bottom:5px solid #323232; overflow:hidden; }
        .main-header::before { content:''; position:absolute; inset:0; background:linear-gradient(135deg,#1e2a38,#2c3e50); z-index:0; opacity:0.9; }
        .titles { position:relative; z-index:2; margin-bottom:40px; }
        .titles h1 { font-size:46px; color:#4a90e2; margin-bottom:10px; text-shadow:2px 2px 8px rgba(0,0,0,0.5); }
        .titles .slogan { font-size:20px; color:#e2e8f0; margin-bottom:16px; }
        .welcome-badge { display:inline-block; background:rgba(74,144,226,0.2); border:1px solid rgba(74,144,226,0.4); color:#81b3f7; padding:8px 20px; border-radius:20px; font-size:14px; font-weight:600; }
        .hero-circles { display:flex; justify-content:center; align-items:center; gap:50px; position:relative; z-index:2; }
        .player-wrapper, .player-wrapper-bottom { display:flex; flex-direction:column; align-items:center; gap:10px; }
        .circle { border-radius:50%; display:flex; justify-content:center; align-items:center; background:#fdfdfd; border:4px solid #4a90e2; box-shadow:0 8px 25px rgba(0,0,0,0.3); overflow:hidden; transition:all 0.3s ease; position:relative; cursor:pointer; }
        .circle:hover { transform:scale(1.07); box-shadow:0 12px 35px rgba(74,144,226,0.5); border-color:#81b3f7; }
        .main-circle { width:210px; height:210px; }
        .side-circle { width:140px; height:140px; }
        .circle img { width:100%; height:100%; object-fit:cover; border-radius:50%; display:block; }
        .circle-inner { width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg,#1e2a38,#34495e); color:white; }
        .main-circle .circle-inner { font-size:65px; }
        .side-circle .circle-inner { font-size:45px; }
        .change-overlay { position:absolute; bottom:0; left:0; right:0; background:rgba(0,0,0,0.75); color:white; font-size:12px; font-weight:bold; padding:8px; text-align:center; opacity:0; transition:0.3s; }
        .circle:hover .change-overlay { opacity:1; }
        .player-label { font-size:14px; font-weight:bold; color:#fff; background:rgba(74,144,226,0.3); border:1px solid rgba(74,144,226,0.5); padding:6px 16px; border-radius:20px; backdrop-filter:blur(4px); }
        .cards-section { margin-top:50px; flex-grow:1; padding:20px; }
        .cards-container { max-width:1100px; margin:0 auto; display:flex; flex-direction:column; gap:30px; }
        .cards-row { display:grid; grid-template-columns:1fr 1fr; gap:25px; }
        .cards-row-3 { display:grid; grid-template-columns:1fr 1fr 1fr; gap:25px; }
        .info-card { background:white; padding:30px 25px; border-radius:15px; text-align:center; border:2px solid #e1e8ed; transition:all 0.3s ease; position:relative; overflow:hidden; }
        .info-card::before { content:''; position:absolute; top:0; left:0; right:0; height:4px; background:linear-gradient(90deg,#34495e,#4a90e2); transform:scaleX(0); transition:transform 0.3s ease; }
        .info-card:hover::before { transform:scaleX(1); }
        .info-card:hover { border-color:#4a90e2; transform:translateY(-8px); box-shadow:0 15px 35px rgba(0,0,0,0.12); }
        .info-card .icon { font-size:42px; margin-bottom:15px; }
        .info-card h3 { margin-bottom:12px; font-size:22px; color:#2c3e50; }
        .info-card p { color:#666; font-size:15px; margin-bottom:22px; line-height:1.6; }
        .card-btn { display:inline-block; padding:12px 28px; background:linear-gradient(135deg,#34495e,#2c3e50); color:white; text-decoration:none; border-radius:25px; font-size:14px; font-weight:bold; transition:all 0.3s ease; box-shadow:0 4px 15px rgba(52,73,94,0.3); }
        .card-btn:hover { transform:translateY(-3px); box-shadow:0 8px 25px rgba(74,144,226,0.4); background:linear-gradient(135deg,#4a90e2,#1e6fc4); }
        footer { background:#1e2a38; color:white; padding:50px 40px 0; direction:rtl; margin-top:40px; }
        .footer-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:32px; padding-bottom:40px; border-bottom:1px solid rgba(255,255,255,0.1); }
        .footer-col h3 { font-size:15px; font-weight:500; color:#e2e8f0; margin-bottom:14px; }
        .footer-col.brand h3 { font-size:16px; color:#81b3f7; border-right:3px solid #4a90e2; padding-right:10px; }
        .footer-col p { font-size:13px; color:#94a3b8; line-height:1.8; margin:0; }
        .footer-col ul { list-style:none; display:flex; flex-direction:column; gap:10px; }
        .footer-col ul li a { color:#94a3b8; text-decoration:none; font-size:13px; }
        .footer-col ul li a:hover { color:#81b3f7; }
        .social-links { display:flex; gap:10px; margin-top:16px; }
        .social-links a { width:34px; height:34px; border-radius:50%; background:rgba(74,144,226,0.15); border:1px solid rgba(74,144,226,0.3); display:flex; align-items:center; justify-content:center; text-decoration:none; color:#81b3f7; font-size:14px; }
        .contact-item { display:flex; align-items:center; gap:10px; margin-bottom:12px; }
        .contact-icon { width:28px; height:28px; border-radius:6px; background:rgba(74,144,226,0.15); display:flex; align-items:center; justify-content:center; font-size:13px; }
        .contact-item span { color:#94a3b8; font-size:13px; }
        .footer-bottom { display:flex; justify-content:center; align-items:center; padding:20px 0; }
        .footer-bottom p { color:#475569; font-size:12px; margin:0; }
        @@media(max-width:768px) {
            nav ul { display:none; }
            .hamburger { display:flex; }
            .cards-row, .cards-row-3 { grid-template-columns:1fr; }
            .hero-circles { flex-direction:column; gap:25px; }
            .titles h1 { font-size:28px; }
            .main-circle { width:170px; height:170px; }
            .side-circle { width:120px; height:120px; }
        }
    </style>
</head>
<body>
    <nav>
        <div class="nav-header">
            <h1>منصة الكاراتيه الفلسطينية</h1>
            <h2>اصنع تاريخك ...وكن بطلاً</h2>
        </div>
        <a href="/Home/Index">
            <img src="/images/test.jpg" alt="لوغو" style="position:absolute;right:260px;height:55px;">
        </a>
        <ul>
            <li><a href="/Club/Dashboard">الرئيسية</a></li>
            <li><a href="/Tour/Index">الاندية</a></li>
            <li><a href="/Tournament/Index">البطولات</a></li>
            <li><a href="/Club/Profile">⚙️ معلوماتي</a></li>
            <li><a href="/Account/Logout" class="login-btn">تسجيل خروج</a></li>
        </ul>
        <div class="hamburger" id="hamburger">
            <span></span><span></span><span></span>
        </div>
        <button onclick="toggleLang()" id="langBtn"
                style="position:absolute;left:20px;top:50%;transform:translateY(-50%);background:rgba(74,144,226,0.2);border:1px solid rgba(74,144,226,0.4);color:#81b3f7;padding:6px 16px;border-radius:20px;cursor:pointer;font-size:13px;font-weight:bold;font-family:inherit;">
            EN
        </button>
    </nav>

    <div class="mobile-menu" id="mobileMenu">
        <a href="/Club/Dashboard">الرئيسية</a>
        <a href="/Tour/Index">الاندية</a>
        <a href="/Tournament/Index">البطولات</a>
        <a href="/Club/Profile">⚙️ معلوماتي</a>
        <a href="/Account/Logout">تسجيل خروج</a>
    </div>

    <header class="main-header">
        <div class="titles">
            <h1>🥋 منصة الكاراتيه الفلسطينية</h1>
            <p class="slogan">اصنع تاريخك ...وكن بطلاً</p>
            <span class="welcome-badge"> @username 👋</span>
            <div style="color:#81b3f7;font-size:12px;margin-top:8px;">
                🕐 آخر تسجيل دخول: @ViewBag.LastLogin
            </div>
        </div>
        <div class="hero-circles">
            <div class="player-wrapper-bottom">
                <div class="circle side-circle" onclick="document.getElementById('femaleInput').click()">
                    <img id="femaleImg" src="@(ViewBag.FemaleImage ?? "")" alt="" style="@(ViewBag.FemaleImage != null ? "display:block;" : "display:none;")">
                    <div class="circle-inner" id="femaleIcon" style="@(ViewBag.FemaleImage != null ? "display:none;" : "")">👩</div>
                    <div class="change-overlay">📷 تغيير الصورة</div>
                </div>
                <input type="file" id="femaleInput" accept="image/*" hidden onchange="changeImage('femaleImg','femaleIcon',this,'female')">
                <span class="player-label">اللاعبة المميزة</span>
            </div>
            <div class="player-wrapper" style="align-items:center;">
                <div class="circle main-circle" onclick="document.getElementById('logoInput').click()">
                    <img id="logoImg" src="@(ViewBag.LogoImage ?? "")" alt="" style="@(ViewBag.LogoImage != null ? "display:block;" : "display:none;")">
                    <div class="circle-inner" id="logoIcon" style="@(ViewBag.LogoImage != null ? "display:none;" : "")">🏆</div>
                    <div class="change-overlay">📷 تغيير الشعار</div>
                </div>
                <input type="file" id="logoInput" accept="image/*" hidden onchange="changeImage('logoImg','logoIcon',this,'logo')">
                <span class="player-label" style="margin-top:8px;">شعار النادي</span>
            </div>
            <div class="player-wrapper">
                <div class="circle side-circle" onclick="document.getElementById('maleInput').click()">
                    <img id="maleImg" src="@(ViewBag.MaleImage ?? "")" alt="" style="@(ViewBag.MaleImage != null ? "display:block;" : "display:none;")">
                    <div class="circle-inner" id="maleIcon" style="@(ViewBag.MaleImage != null ? "display:none;" : "")">👨</div>
                    <div class="change-overlay">📷 تغيير الصورة</div>
                </div>
                <input type="file" id="maleInput" accept="image/*" hidden onchange="changeImage('maleImg','maleIcon',this,'male')">
                <span class="player-label">لاعب مميز</span>
            </div>
        </div>
    </header>

    <section class="cards-section">
        <div class="cards-container">
            <!-- صف 1: كرتين -->
            <div class="cards-row">
                <div class="info-card">
                    <div class="icon">🏅</div>
                    <h3>مشاركاتي</h3>
                    <p>عرض البطولات التي شاركت بها والنتائج الخاصة بك ومجموع النقاط.</p>
                    <a href="/Club/Participation" class="card-btn">عرض التفاصيل</a>
                </div>
                <div class="info-card">
                    <div class="icon">⭐</div>
                    <h3>اللاعبين</h3>
                    <p>تعرف على لاعبين ولاعبات النادي لديك ونقاطهم في البطولات.</p>
                    <a href="/Club/Best" class="card-btn">عرض التفاصيل</a>
                </div>
            </div>
            <!-- صف 2: 3 كروت -->
            <div class="cards-row-3">
                <div class="info-card">
                    <div class="icon">➕</div>
                    <h3>تسجيل لاعب/ة</h3>
                    <p>يمكنك تسجيل لاعب/ة جديد في ناديك من هنا!</p>
                    <a href="/Club/AddPlayer" class="card-btn">تسجيل الآن</a>
                </div>
                <div class="info-card">
                    <div class="icon">📋</div>
                    <h3>الاستحقاقات</h3>
                    <p>استحقاقاتك تعكس جهودك وتحدد مسارك نحو التميز.</p>
                    <a href="/Club/Entitlements" class="card-btn">عرض الاستحقاقات</a>
                </div>
                <div class="info-card">
                    <div class="icon">🏆</div>
                    <h3>البطولات</h3>
                    <p>سجّل ناديك في البطولات المتاحة واختر لاعبيك للمشاركة.</p>
                    <a href="/Club/Tournaments" class="card-btn">عرض البطولات</a>
                </div>
            </div>
        </div>
    </section>

    <footer>
        <div class="footer-grid">
            <div class="footer-col brand">
                <h3>منصة الكاراتيه الفلسطينية</h3>
                <p>بناء أبطال المستقبل وتطوير رياضة الكاراتيه في فلسطين من خلال التدريب والمنافسة.</p>
                <div class="social-links"><a href="#">f</a><a href="#">in</a><a href="#">ig</a></div>
            </div>
            <div class="footer-col">
                <h3>روابط سريعة</h3>
                <ul>
                    <li><a href="/Home/Index">← الرئيسية</a></li>
                    <li><a href="/Tour/Index">← الأندية</a></li>
                    <li><a href="/Tournament/Index">← البطولات</a></li>
                    <li><a href="/Club/Profile">← معلوماتي</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h3>خدماتنا</h3>
                <ul>
                    <li><a href="/Club/AddPlayer">تسجيل اللاعبين</a></li>
                    <li><a href="/Club/Tournaments">إدارة البطولات</a></li>
                    <li><a href="/Club/Participation">متابعة النتائج</a></li>
                    <li><a href="/Club/Entitlements">الاستحقاقات</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h3>تواصل معنا</h3>
                <div class="contact-item"><div class="contact-icon">📍</div><span>فلسطين، الضفة الغربية</span></div>
                <div class="contact-item"><div class="contact-icon">📞</div><span style="direction:ltr;">+970 59X XXX XXXX</span></div>
                <div class="contact-item"><div class="contact-icon">✉️</div><span>info@karate-ps.com</span></div>
            </div>
        </div>
        <div class="footer-bottom"><p>© 2025 منصة الكاراتيه الفلسطينية — جميع الحقوق محفوظة</p></div>
    </footer>

    <script>
        document.getElementById('hamburger').addEventListener('click', function () {
            this.classList.toggle('open');
            document.getElementById('mobileMenu').classList.toggle('show');
        });

        function changeImage(imgId, iconId, input, type) {
            const file = input.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function (e) {
                const img = document.getElementById(imgId);
                const icon = document.getElementById(iconId);
                img.src = e.target.result;
                img.style.display = 'block';
                icon.style.display = 'none';
                fetch('/Club/SaveImages', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        logoImage: type === 'logo' ? e.target.result : null,
                        maleImage: type === 'male' ? e.target.result : null,
                        femaleImage: type === 'female' ? e.target.result : null
                    })
                });
            };
            reader.readAsDataURL(file);
        }

        const translations = {
            ar: {
                nav_home: "الرئيسية", nav_clubs: "الاندية", nav_tournaments: "البطولات",
                nav_profile: "⚙️ معلوماتي", nav_logout: "تسجيل خروج",
                title: "منصة الكاراتيه الفلسطينية", slogan: "اصنع تاريخك ...وكن بطلاً",
                card1_title: "مشاركاتي", card1_desc: "عرض البطولات التي شاركت بها والنتائج الخاصة بك.", card1_btn: "عرض التفاصيل",
                card2_title: "اللاعبين", card2_desc: "تعرف على لاعبين ولاعبات النادي لديك.", card2_btn: "عرض التفاصيل",
                card3_title: "تسجيل لاعب/ة", card3_desc: "يمكنك تسجيل لاعب/ة جديد في ناديك من هنا!", card3_btn: "تسجيل الآن",
                card4_title: "الاستحقاقات", card4_desc: "استحقاقاتك تعكس جهودك وتحدد مسارك.", card4_btn: "عرض الاستحقاقات",
                card5_title: "البطولات", card5_desc: "سجّل ناديك في البطولات المتاحة واختر لاعبيك.", card5_btn: "عرض البطولات",
                logo_label: "شعار النادي", male_label: "لاعب مميز", female_label: "اللاعبة المميزة",
                footer_title: "منصة الكاراتيه الفلسطينية", copyright: "© 2025 منصة الكاراتيه الفلسطينية — جميع الحقوق محفوظة"
            },
            en: {
                nav_home: "Home", nav_clubs: "Clubs", nav_tournaments: "Tournaments",
                nav_profile: "⚙️ My Profile", nav_logout: "Logout",
                title: "Palestinian Karate Platform", slogan: "Make your history... Be a champion",
                card1_title: "My Participations", card1_desc: "View tournaments you participated in and your results.", card1_btn: "View Details",
                card2_title: "Players", card2_desc: "View your club players and their tournament points.", card2_btn: "View Details",
                card3_title: "Register Player", card3_desc: "You can register a new player in your club here!", card3_btn: "Register Now",
                card4_title: "Entitlements", card4_desc: "Your entitlements reflect your efforts and excellence.", card4_btn: "View Entitlements",
                card5_title: "Tournaments", card5_desc: "Register your club in available tournaments and select players.", card5_btn: "View Tournaments",
                logo_label: "Club Logo", male_label: "Featured Male Player", female_label: "Featured Female Player",
                footer_title: "Palestinian Karate Platform", copyright: "© 2025 Palestinian Karate Platform — All Rights Reserved"
            }
        };

        let currentLang = localStorage.getItem("lang") || "ar";

        function applyLang(lang) {
            const t = translations[lang];
            const isAr = lang === "ar";
            document.documentElement.lang = lang;
            document.documentElement.dir = isAr ? "rtl" : "ltr";
            document.getElementById("langBtn").textContent = isAr ? "EN" : "عر";
            document.querySelector(".nav-header h1").textContent = t.title;
            document.querySelector(".nav-header h2").textContent = t.slogan;
            const navLinks = document.querySelectorAll("nav ul li a");
            if (navLinks[0]) navLinks[0].textContent = t.nav_home;
            if (navLinks[1]) navLinks[1].textContent = t.nav_clubs;
            if (navLinks[2]) navLinks[2].textContent = t.nav_tournaments;
            if (navLinks[3]) navLinks[3].textContent = t.nav_profile;
            if (navLinks[4]) navLinks[4].textContent = t.nav_logout;
            document.querySelector(".titles h1").textContent = "🥋 " + t.title;
            document.querySelector(".slogan").textContent = t.slogan;
            const cards = document.querySelectorAll(".info-card");
            ["card1","card2","card3","card4","card5"].forEach((k, i) => {
                if (cards[i]) {
                    cards[i].querySelector("h3").textContent = t[k + "_title"];
                    cards[i].querySelector("p").textContent = t[k + "_desc"];
                    cards[i].querySelector(".card-btn").textContent = t[k + "_btn"];
                }
            });
            const labels = document.querySelectorAll(".player-label");
            if (labels[0]) labels[0].textContent = t.female_label;
            if (labels[1]) labels[1].textContent = t.logo_label;
            if (labels[2]) labels[2].textContent = t.male_label;
            document.querySelector(".footer-col.brand h3").textContent = t.footer_title;
            document.querySelector(".footer-bottom p").textContent = t.copyright;
            localStorage.setItem("lang", lang);
        }

        function toggleLang() {
            currentLang = currentLang === "ar" ? "en" : "ar";
            applyLang(currentLang);
        }

        document.addEventListener("DOMContentLoaded", () => applyLang(currentLang));
    </script>
</body>
</html>
