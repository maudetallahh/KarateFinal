@{
    Layout = null;
    var messages = ViewBag.Messages as List<KarateFinal.Models.Message>;
    var club = ViewBag.Club as KarateFinal.Models.Club;
    int clubId = ViewBag.ClubId;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>مراسلات @club?.Name</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; font-family:'Segoe UI',Tahoma,sans-serif; }
        body { background:#0f1923; color:#f1f5f9; min-height:100vh; display:flex; flex-direction:column; }
        nav { background:#1a2535; border-bottom:2px solid #3b82f6; padding:12px 20px; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:100; }
        .nav-title { font-size:16px; font-weight:700; }
        .back-btn { background:rgba(59,130,246,0.15); color:#3b82f6; border:1px solid rgba(59,130,246,0.3); padding:7px 16px; border-radius:8px; text-decoration:none; font-size:13px; font-weight:700; }
        .chat-container { max-width:700px; margin:24px auto; padding:0 20px; flex:1; display:flex; flex-direction:column; width:100%; }
        .chat-title { font-size:18px; font-weight:800; color:#4a90e2; margin-bottom:16px; }
        .messages-box { background:#1a2535; border:1px solid #2d3f55; border-radius:16px; padding:20px; flex:1; min-height:400px; max-height:500px; overflow-y:auto; margin-bottom:16px; display:flex; flex-direction:column; gap:12px; }
        .msg { max-width:75%; padding:12px 16px; border-radius:12px; font-size:13px; line-height:1.5; }
        .msg.admin { background:#3b82f6; color:white; align-self:flex-end; border-radius:12px 12px 4px 12px; }
        .msg.club { background:#223044; color:#f1f5f9; align-self:flex-start; border-radius:12px 12px 12px 4px; }
        .msg-time { font-size:10px; opacity:0.7; margin-top:4px; }
        .msg-sender { font-size:10px; font-weight:700; margin-bottom:4px; opacity:0.8; }
        .input-area { background:#1a2535; border:1px solid #2d3f55; border-radius:16px; padding:16px; display:flex; gap:10px; }
        .input-area textarea { flex:1; padding:10px; border:1px solid #2d3f55; border-radius:8px; font-family:inherit; font-size:13px; resize:none; height:60px; background:#0f1923; color:#f1f5f9; }
        .send-btn { padding:10px 20px; background:#3b82f6; color:white; border:none; border-radius:8px; cursor:pointer; font-family:inherit; font-size:13px; font-weight:700; }
        .empty { text-align:center; color:#94a3b8; padding:40px; }
    </style>
<link rel="stylesheet" href="/css/dark.css"><link rel="stylesheet" href="/css/dark.css"></head>
<body>
    <nav>
        <div class="nav-title">💬 مراسلات — @club?.Name</div>
        <a href="/Admin/Index" class="back-btn">← الرئيسية</a>
    </nav>
    <div class="chat-container">
        <div class="chat-title">💬 محادثة مع @club?.Name</div>
        <div class="messages-box" id="messagesBox">
            @if (messages != null && messages.Any())
            {
                foreach (var m in messages)
                {
                    var isAdmin = m.SenderRole == "Admin";
                    <div class="msg @(isAdmin ? "admin" : "club")">
                        <div class="msg-sender">@(isAdmin ? "الإدارة" : club?.Name)</div>
                        @m.Content
                        <div class="msg-time">@m.SentAt.ToString("yyyy/MM/dd HH:mm")</div>
                    </div>
                }
            }
            else
            {
                <div class="empty">لا توجد رسائل بعد</div>
            }
        </div>
        <div class="input-area">
            <textarea id="msgInput" placeholder="اكتب ردك هنا..."></textarea>
            <button class="send-btn" onclick="sendReply()">إرسال ✉️</button>
        </div>
    </div>
    <script>
        document.getElementById('messagesBox').scrollTop = document.getElementById('messagesBox').scrollHeight;
        function sendReply() {
            const content = document.getElementById('msgInput').value.trim();
            if (!content) return;
            fetch('/Admin/ReplyMessage', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ clubId: @clubId, content }) })
                .then(r => r.json()).then(data => { if (data.success) { document.getElementById('msgInput').value = ''; location.reload(); } });
        }
        document.getElementById('msgInput').addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendReply(); }
        });
    </script>
</body>
</html>