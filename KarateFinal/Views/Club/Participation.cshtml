@{
    Layout = null;
    var participations = ViewBag.Participations as IEnumerable<KarateFinal.Models.Participation>;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/png" href="/image/www.png">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>مشاركاتي</title>
    <style>
        * { box-sizing:border-box; margin:0; padding:0; font-family:'Segoe UI',Tahoma,sans-serif; }
        body { background:#f5f7fa; display:flex; flex-direction:column; min-height:100vh; }
        nav { background-color:#1e2a38; color:white; padding:20px 50px; display:flex; justify-content:center; align-items:center; border-bottom:4px solid #4a90e2; position:sticky; top:0; z-index:1000; }
        .nav-header { text-align:center; }
        .nav-header h1 { font-size:26px; color:#ffffff; letter-spacing:1px; }
        .nav-header h2 { font-size:14px; color:#d1d5db; font-weight:normal; margin-top:5px; }
        nav ul { position:absolute; left:50px; display:flex; list-style:none; align-items:center; }
        nav ul li { margin-left:25px; }
        nav ul li a { text-decoration:none; color:white; font-weight:bold; transition:0.3s; font-size:15px; }
        nav ul li a:hover { color:#81b3f7; }
        .login-btn { background-color:#2c3e50; padding:8px 25px; border-radius:5px; border:2px solid transparent; }
        .hamburger { display:none; flex-direction:column; gap:5px; cursor:pointer; position:absolute; right:20px; }
        .hamburger span { width:25px; height:2px; background:white; border-radius:2px; transition:0.3s; }
        .mobile-menu { display:none; flex-direction:column; background:#1e2a38; padding:10px 20px; gap:10px; }
        .mobile-menu a { color:white; text-decoration:none; font-size:15px; padding:8px 0; border-bottom:1px solid #2c3e50; }
        .mobile-menu.show { display:flex; }
        .content { padding:40px 20px; flex-grow:1; }
        .title { text-align:center; font-size:28px; margin-bottom:20px; color:#2c3e50; }
        .summary-bar { display:flex; gap:20px; justify-content:center; flex-wrap:wrap; margin-bottom:25px; }
        .summary-card { background:white; border-radius:8px; padding:12px 20px; text-align:center; box-shadow:0 3px 10px rgba(0,0,0,0.07); }
        .summary-card .num { font-size:22px; font-weight:bold; color:#2c3e50; }
        .summary-card .lbl { font-size:12px; color:#888; }
        .table-container { max-width:900px; margin:auto; background:white; padding:30px; border-radius:10px; box-shadow:0 5px 20px rgba(0,0,0,0.08); }
        table { width:100%; border-collapse:collapse; text-align:center; }
        th { background:#34495e; color:white; padding:12px; }
        td { padding:12px; border-bottom:1px solid #eee; }
        tr:hover { background:#f2f2f2; }
        .medal-1 { color:#FFD700; font-weight:bold; }
        .medal-2 { color:#C0C0C0; }
        .medal-3 { color:#CD7F32; }
        .total-points { margin-top:20px; font-size:18px; color:#2c3e50; font-weight:bold; }
        .back-btn { display:inline-block; margin-top:25px; padding:10px 20px; background:#34495e; color:white; text-decoration:none; border-radius:20px; }
        .back-btn:hover { background:#2c3e50; }
        .empty-msg { text-align:center; padding:2rem; color:#888; }
        footer { background:#1e2a38; color:white; padding:50px 40px 0; direction:rtl; margin-top:40px; }
        .footer-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:32px; padding-bottom:40px; border-bottom:1px solid rgba(255,255,255,0.1); }
        .footer-col h3 { font-size:15px; font-weight:500; color:#e2e8f0; margin-bottom:14px; }
        .footer-col.brand h3 { font-size:16px; color:#81b3f7; border-right:3px solid #4a90e2; padding-right:10px; }
        .footer-col p { font-size:13px; color:#94a3b8; line-height:1.8; margin:0; }
        .footer-col ul { list-style:none; display:flex; flex-direction:column; gap:10px; }
        .footer-col ul li a { color:#94a3b8; text-decoration:none; font-size:13px; }
        .footer-col ul li a:hover { color:#81b3f7; }
        .social-links { display:flex; gap:10px; margin-top:16px; }
        .social-links a { width:34px; height:34px; border-radius:50%; background:rgba(74,144,226,0.15); border:1px solid rgba(74,144,226,0.3); display:flex; align-items:center; justify-content:center; text-decoration:none; color:#81b3f7; font-size:14px; }
        .contact-item { display:flex; align-items:center; gap:10px; margin-bottom:12px; }
        .contact-icon { width:28px; height:28px; border-radius:6px; background:rgba(74,144,226,0.15); display:flex; align-items:center; justify-content:center; font-size:13px; }
        .contact-item span { color:#94a3b8; font-size:13px; }
        .footer-bottom { display:flex; justify-content:center; align-items:center; padding:20px 0; }
        .footer-bottom p { color:#475569; font-size:12px; margin:0; }
        @@media(max-width:768px) { nav ul { display:none; } .hamburger { display:flex; } }
    </style>
</head>
<body>
    <nav>
        <div class="nav-header">
            <h1>منصة الكاراتيه الفلسطينية</h1>
            <h2>اصنع تاريخك ...وكن بطلاً</h2>
        </div>
        <a href="/Home/Index">
            @await Html.PartialAsync("_NavLogo")
        </a>
        <ul>
            <li><a href="/Home/Index">الرئيسية</a></li>
            <li><a href="/Tour/Index">الاندية</a></li>
            <li><a href="/Tournament/Index">البطولات</a></li>
            <li><a href="/Account/Logout" class="login-btn">تسجيل خروج</a></li>
        </ul>
        <div class="hamburger" id="hamburger">
            <span></span><span></span><span></span>
        </div>

        <button onclick="toggleLang()" id="langBtn"
                style="position:absolute;left:20px;top:50%;transform:translateY(-50%);background:rgba(74,144,226,0.2);border:1px solid rgba(74,144,226,0.4);color:#81b3f7;padding:6px 16px;border-radius:20px;cursor:pointer;font-size:13px;font-weight:bold;font-family:inherit;">
            EN
        </button>
    </nav>
    <div class="mobile-menu" id="mobileMenu">
        <a href="/Home/Index">الرئيسية</a>
        <a href="/Tour/Index">الاندية</a>
        <a href="/Tournament/Index">البطولات</a>
        <a href="/Account/Logout">تسجيل خروج</a>
    </div>

    <div class="content">
        <h2 class="title">🏅 مشاركاتي في البطولات</h2>

        <!-- ملخص -->
        <div class="summary-bar">
            <div class="summary-card">
                <div class="num">@ViewBag.Total</div>
                <div class="lbl">إجمالي البطولات</div>
            </div>
            <div class="summary-card">
                <div class="num" style="color:#FFD700">@ViewBag.Gold</div>
                <div class="lbl">ذهبيات</div>
            </div>
            <div class="summary-card">
                <div class="num" style="color:#2c3e50">@ViewBag.TotalPoints</div>
                <div class="lbl">مجموع النقاط</div>
            </div>
        </div>

        <div class="table-container">
            @if (participations != null && participations.Any())
            {
                <table>
                    <thead>
                        <tr><th>البطولة</th><th>التاريخ</th><th>النتيجة</th><th>المركز</th><th>النقاط</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in participations)
                        {
                            var cls = p.Rank == 1 ? "medal-1" : p.Rank == 2 ? "medal-2" : p.Rank == 3 ? "medal-3" : "";
                            var medal = p.Rank == 1 ? "🥇" : p.Rank == 2 ? "🥈" : p.Rank == 3 ? "🥉" : "";
                            <tr>
                                <td>@(p.Tournament?.Title ?? "—")</td>
                                <td>@(p.Tournament?.Date.ToString("yyyy/MM/dd") ?? "—")</td>
                                <td class="@cls">@p.Result</td>
                                <td class="@cls">@medal المركز @p.Rank</td>
                                <td>@p.Points ⭐</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="total-points">مجموع النقاط: @ViewBag.TotalPoints ⭐</div>
            }
            else
            {
                <div class="empty-msg">لا توجد مشاركات مسجّلة بعد 🏆</div>
            }
            <a href="/Club/Dashboard" class="back-btn">← العودة</a>
        </div>
    </div>

    <footer>
        <div class="footer-grid">
            <div class="footer-col brand">
                <h3>منصة الكاراتيه الفلسطينية</h3>
                <p>بناء أبطال المستقبل وتطوير رياضة الكاراتيه في فلسطين من خلال التدريب والمنافسة.</p>
                <div class="social-links">
                    <a href="#">f</a><a href="#">in</a><a href="#">ig</a>
                </div>
            </div>
            <div class="footer-col">
                <h3>روابط سريعة</h3>
                <ul>
                    <li><a href="/Home/Index">← الرئيسية</a></li>
                    <li><a href="/Tour/Index">← الأندية</a></li>
                    <li><a href="/Tournament/Index">← البطولات</a></li>
                    <li><a href="/Account/Login">← تسجيل دخول</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h3>خدماتنا</h3>
                <ul>
                    <li><a href="/Club/AddPlayer">تسجيل اللاعبين</a></li>
                    <li><a href="/Tournament/Index">إدارة البطولات</a></li>
                    <li><a href="/Club/Participation">متابعة النتائج</a></li>
                    <li><a href="/Club/Entitlements">الاستحقاقات</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h3>تواصل معنا</h3>
                <div class="contact-item">
                    <div class="contact-icon">📍</div>
                    <span>فلسطين، الضفة الغربية</span>
                </div>
                <div class="contact-item">
                    <div class="contact-icon">📞</div>
                    <span style="direction:ltr;">+970 59X XXX XXXX</span>
                </div>
                <div class="contact-item">
                    <div class="contact-icon">✉️</div>
                    <span>info@karate-ps.com</span>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>© 2025 منصة الكاراتيه الفلسطينية — جميع الحقوق محفوظة</p>
        </div>
    </footer>

    <script>
        document.getElementById('hamburger').addEventListener('click', function(){
            this.classList.toggle('open');
            document.getElementById('mobileMenu').classList.toggle('show');
        });
        const translations = {
            ar: {
                nav_home: "الرئيسية", nav_clubs: "الاندية", nav_tournaments: "البطولات", nav_logout: "تسجيل خروج",
                title: "منصة الكاراتيه الفلسطينية", slogan: "اصنع تاريخك ...وكن بطلاً",
                page_title: "🏅 مشاركاتي في البطولات",
                stat1: "إجمالي البطولات", stat2: "ذهبيات", stat3: "مجموع النقاط",
                th1: "البطولة", th2: "التاريخ", th3: "النتيجة", th4: "المركز", th5: "النقاط",
                back_btn: "← العودة",
                footer_title: "منصة الكاراتيه الفلسطينية",
                copyright: "© 2025 منصة الكاراتيه الفلسطينية — جميع الحقوق محفوظة"
            },
            en: {
                nav_home: "Home", nav_clubs: "Clubs", nav_tournaments: "Tournaments", nav_logout: "Logout",
                title: "Palestinian Karate Platform", slogan: "Make your history... Be a champion",
                page_title: "🏅 My Tournament Participations",
                stat1: "Total Tournaments", stat2: "Gold Medals", stat3: "Total Points",
                th1: "Tournament", th2: "Date", th3: "Result", th4: "Rank", th5: "Points",
                back_btn: "← Back",
                footer_title: "Palestinian Karate Platform",
                copyright: "© 2025 Palestinian Karate Platform — All Rights Reserved"
            }
        };

        let currentLang = localStorage.getItem("lang") || "ar";

        function applyLang(lang) {
            const t = translations[lang];
            const isAr = lang === "ar";
            document.documentElement.lang = lang;
            document.documentElement.dir = isAr ? "rtl" : "ltr";
            document.getElementById("langBtn").textContent = isAr ? "EN" : "عر";
            document.querySelector(".nav-header h1").textContent = t.title;
            document.querySelector(".nav-header h2").textContent = t.slogan;
            document.querySelectorAll("nav ul li a")[0].textContent = t.nav_home;
            document.querySelectorAll("nav ul li a")[1].textContent = t.nav_clubs;
            document.querySelectorAll("nav ul li a")[2].textContent = t.nav_tournaments;
            document.querySelectorAll("nav ul li a")[3].textContent = t.nav_logout;
            document.querySelector(".title").textContent = t.page_title;
            document.querySelector(".back-btn").textContent = t.back_btn;
            const lbls = document.querySelectorAll(".summary-card .lbl");
            if (lbls[0]) lbls[0].textContent = t.stat1;
            if (lbls[1]) lbls[1].textContent = t.stat2;
            if (lbls[2]) lbls[2].textContent = t.stat3;
            const ths = document.querySelectorAll("th");
            if (ths[0]) ths[0].textContent = t.th1;
            if (ths[1]) ths[1].textContent = t.th2;
            if (ths[2]) ths[2].textContent = t.th3;
            if (ths[3]) ths[3].textContent = t.th4;
            if (ths[4]) ths[4].textContent = t.th5;
            document.querySelector(".footer-col.brand h3").textContent = t.footer_title;
            document.querySelector(".footer-bottom p").textContent = t.copyright;
            localStorage.setItem("lang", lang);
        }

        function toggleLang() {
            currentLang = currentLang === "ar" ? "en" : "ar";
            applyLang(currentLang);
        }

        document.addEventListener("DOMContentLoaded", () => applyLang(currentLang));
    </script>
</body>
</html>