@{
    Layout = null;

    var player = ViewBag.Player as KarateFinal.Models.Player;

    var participations = ViewBag.Participations as IEnumerable<KarateFinal.Models.Participation>;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>بطاقة اللاعب — @player?.Name</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI',Tahoma,sans-serif;
        }

        body {
            background: #eef3f8;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        nav {
            background: #1e2a38;
            color: white;
            padding: 20px 50px;
            display: flex;
            justify-content: center;
            align-items: center;
            border-bottom: 4px solid #4a90e2;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .nav-header {
            text-align: center;
        }

            .nav-header h1 {
                font-size: 26px;
                color: #fff;
                letter-spacing: 1px;
            }

            .nav-header h2 {
                font-size: 14px;
                color: #d1d5db;
                font-weight: normal;
                margin-top: 5px;
            }

        nav ul {
            position: absolute;
            left: 50px;
            display: flex;
            list-style: none;
            align-items: center;
        }

            nav ul li {
                margin-left: 25px;
            }

                nav ul li a {
                    text-decoration: none;
                    color: white;
                    font-weight: bold;
                    transition: 0.3s;
                    font-size: 15px;
                }

                    nav ul li a:hover {
                        color: #81b3f7;
                    }

        .login-btn {
            background: #2c3e50;
            padding: 8px 25px;
            border-radius: 5px;
            border: 2px solid transparent;
        }

        .hamburger {
            display: none;
            flex-direction: column;
            gap: 5px;
            cursor: pointer;
            position: absolute;
            right: 20px;
        }

            .hamburger span {
                width: 25px;
                height: 2px;
                background: white;
                border-radius: 2px;
                transition: 0.3s;
            }

        .mobile-menu {
            display: none;
            flex-direction: column;
            background: #1e2a38;
            padding: 10px 20px;
            gap: 10px;
        }

            .mobile-menu a {
                color: white;
                text-decoration: none;
                font-size: 15px;
                padding: 8px 0;
                border-bottom: 1px solid #2c3e50;
            }

            .mobile-menu.show {
                display: flex;
            }

        .card-wrapper {
            max-width: 700px;
            margin: 40px auto;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 24px;
            align-items: center;
            flex: 1;
        }

        .player-card {
            width: 100%;
            max-width: 280px;
            background: #0d1117;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        }

        .flag-bg {
            width: 100%;
            height: 160px;
            position: relative;
        }

        .player-photo-circle {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: linear-gradient(135deg,#1e2a38,#4a90e2);
            position: absolute;
            bottom: -36px;
            left: 20px;
            border: 4px solid #0d1117;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            color: white;
        }

        .player-info {
            padding: 50px 20px 20px;
            color: white;
        }

        .player-name {
            font-size: 22px;
            font-weight: 700;
            line-height: 1.3;
            margin-bottom: 10px;
        }

        .player-meta {
            font-size: 12px;
            color: #bbb;
            line-height: 1.8;
        }

        .category-label {
            width: 100%;
            max-width: 600px;
            font-size: 13px;
            font-weight: 600;
            color: #555;
            text-transform: uppercase;
            border-bottom: 1px solid #ddd;
            padding-bottom: 6px;
        }

        .stats-grid, .stats-row2, .stats-row3 {
            width: 100%;
            max-width: 600px;
            display: grid;
            gap: 14px;
        }

        .stats-grid {
            grid-template-columns: repeat(4,1fr);
        }

        .stats-row2 {
            grid-template-columns: repeat(2,1fr);
        }

        .stats-row3 {
            grid-template-columns: repeat(3,1fr);
        }

        .stat-card {
            background: white;
            border: 1px solid #e0e6ed;
            border-radius: 10px;
            padding: 14px;
            text-align: center;
            transition: 0.2s;
        }

            .stat-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 10px rgba(0,0,0,0.08);
            }

        .stat-value {
            font-size: 22px;
            font-weight: 600;
            color: #111;
        }

        .stat-label {
            font-size: 11px;
            color: #777;
            margin-top: 5px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .highlight {
            border-color: #3b82f6;
        }

            .highlight .stat-value {
                color: #3b82f6;
            }

        .gold {
            border-color: #FFD700;
        }

            .gold .stat-value {
                color: #b8860b;
            }

        .silver {
            border-color: #C0C0C0;
        }

            .silver .stat-value {
                color: #666;
            }

        .bronze {
            border-color: #CD7F32;
        }

            .bronze .stat-value {
                color: #8b4513;
            }

        .footer-tag {
            font-size: 13px;
            color: #888;
            border: 1px solid #ddd;
            border-radius: 20px;
            padding: 6px 16px;
            background: white;
        }

        .back-btn {
            display: inline-block;
            padding: 10px 20px;
            background: #34495e;
            color: white;
            text-decoration: none;
            border-radius: 20px;
            margin-top: 10px;
            transition: 0.3s;
        }

            .back-btn:hover {
                background: #4a90e2;
            }

        .print-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 22px;
            background: #27ae60;
            color: white;
            border: none;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            font-family: inherit;
            margin-top: 10px;
            transition: 0.3s;
        }

            .print-btn:hover {
                background: #219a52;
            }

        .creds-box {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 20px;
            width: 100%;
            max-width: 600px;
        }

        .creds-title {
            font-size: 13px;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 14px;
            text-align: center;
        }

        .cred-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid #f0f0f0;
        }

            .cred-row:last-child {
                border-bottom: none;
            }

        .cred-label {
            color: #888;
            font-size: 13px;
        }

        .cred-value {
            font-weight: 700;
            color: #2c3e50;
            font-family: monospace;
            font-size: 15px;
            background: #e8f4fd;
            padding: 4px 10px;
            border-radius: 6px;
        }

        .reset-btn {
            width: 100%;
            max-width: 600px;
            padding: 12px;
            background: linear-gradient(135deg,#e74c3c,#c0392b);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            font-family: inherit;
            transition: 0.3s;
            margin-top: 4px;
        }

            .reset-btn:hover {
                background: linear-gradient(135deg,#c0392b,#a93226);
                transform: translateY(-2px);
            }

        .new-pass-box {
            width: 100%;
            max-width: 600px;
            background: #e8f5e9;
            border: 1px solid #27ae60;
            border-radius: 10px;
            padding: 16px;
            text-align: center;
            display: none;
        }

            .new-pass-box .np-title {
                font-size: 13px;
                color: #27ae60;
                font-weight: 700;
                margin-bottom: 8px;
            }

            .new-pass-box .np-val {
                font-size: 20px;
                font-weight: 700;
                color: #1e2a38;
                font-family: monospace;
                background: white;
                padding: 8px 16px;
                border-radius: 8px;
                display: inline-block;
            }

            .new-pass-box .np-hint {
                font-size: 11px;
                color: #888;
                margin-top: 8px;
            }

        footer {
            background: #1e2a38;
            color: white;
            padding: 50px 40px 0;
            direction: rtl;
            margin-top: 40px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit,minmax(180px,1fr));
            gap: 32px;
            padding-bottom: 40px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .footer-col h3 {
            font-size: 15px;
            font-weight: 500;
            color: #e2e8f0;
            margin-bottom: 14px;
        }

        .footer-col.brand h3 {
            font-size: 16px;
            color: #81b3f7;
            border-right: 3px solid #4a90e2;
            padding-right: 10px;
        }

        .footer-col p {
            font-size: 13px;
            color: #94a3b8;
            line-height: 1.8;
            margin: 0;
        }

        .footer-col ul {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

            .footer-col ul li a {
                color: #94a3b8;
                text-decoration: none;
                font-size: 13px;
            }

                .footer-col ul li a:hover {
                    color: #81b3f7;
                }

        .footer-bottom {
            display: flex;
            justify-content: center;
            padding: 20px 0;
        }

            .footer-bottom p {
                color: #475569;
                font-size: 12px;
                margin: 0;
            }

        @@media(max-width:768px) {
            nav ul {
                display: none;
            }

            .hamburger {
                display: flex;
            }

            .stats-grid {
                grid-template-columns: repeat(2,1fr);
            }
        }

        @@media print {
            nav, footer, .back-btn, .print-btn, .reset-btn, .new-pass-box,
            button, form, .creds-box, #injuryForm {
                display: none !important;
            }

            body {
                background: white;
            }

            .card-wrapper {
                margin: 0;
                padding: 10px;
            }

            .player-card {
                box-shadow: none;
                border: 1px solid #ddd;
                max-width: 280px;
                margin: 0 auto 20px;
            }

            .stats-grid, .stats-row2, .stats-row3 {
                break-inside: avoid;
            }

            .category-label {
                color: #2c3e50;
            }

            .stat-card {
                box-shadow: none;
            }
        }
    </style>
</head>
<body>
    <nav>
        <div class="nav-header">
            <h1>منصة الكاراتيه الفلسطينية</h1>
            <h2>اصنع تاريخك ...وكن بطلاً</h2>
        </div>
        <@await Html.PartialAsync("_NavLogo")="لوغو" style="position:absolute;right:260px;height:55px;">
        <ul>
            <li><a href="/Club/Dashboard">← الرئيسية</a></li>
            <li><a href="/Tournament/Index">← البطولات</a></li>
            <li><a href="/Account/Logout" class="login-btn">تسجيل خروج</a></li>
        </ul>
        <div class="hamburger" id="hamburger"><span></span><span></span><span></span></div>
    </nav>
    <div class="mobile-menu" id="mobileMenu">
        <a href="/Club/Dashboard">← الرئيسية</a>
        <a href="/Tour/Index">← الأندية</a>
        <a href="/Tournament/Index">← البطولات</a>
        <a href="/Account/Logout">تسجيل خروج</a>
    </div>

    <div class="card-wrapper">
        <!-- بطاقة اللاعب -->
        <div class="player-card">
            <div class="flag-bg">
                <svg width="100%" height="160" viewBox="0 0 260 160">
                    <rect width="260" height="53" fill="#000" />
                    <rect y="53" width="260" height="54" fill="#fff" />
                    <rect y="107" width="260" height="53" fill="#007a3d" />
                    <polygon points="0,0 100,80 0,160" fill="#ce1126" />
                </svg>
                <div class="player-photo-circle">@(player?.Gender == "أنثى" ? "👩" : "👨")</div>
            </div>
            <div class="player-info">
                <div class="player-name">@player?.Name</div>
                <div class="player-meta">
                    الجنس: @player?.Gender<br>
                    العمر: @player?.Age سنة<br>
                    الحزام: @player?.Belt<br>
                    @if (player?.Weight != null && player.Weight > 0)
                    {
                        <text>الوزن: @player.Weight كغ</text>
                    }
                </div>
            </div>
        </div>

        <!-- حالة اللاعب -->
        <div style="width:100%;max-width:600px;display:flex;gap:12px;">
            <div style="flex:1;background:@(player?.HealthStatus=="مصاب"?"#fee2e2":"#e8f5e9");border:1px solid @(player?.HealthStatus=="مصاب"?"#da3633":"#27ae60");border-radius:12px;padding:16px;text-align:center;">
                <div style="font-size:22px;">@(player?.HealthStatus == "مصاب" ? "🤕" : "💪")</div>
                <div style="font-size:13px;font-weight:700;color:@(player?.HealthStatus=="مصاب"?"#da3633":"#27ae60");margin:6px 0;">@player?.HealthStatus</div>
                <div style="font-size:11px;color:#888;">الحالة الصحية</div>
            </div>
            <div style="flex:1;background:@(player?.PlayerStatus=="موقوف"?"#fff3cd":"#e8f5e9");border:1px solid @(player?.PlayerStatus=="موقوف"?"#d29922":"#27ae60");border-radius:12px;padding:16px;text-align:center;">
                <div style="font-size:22px;">@(player?.PlayerStatus == "موقوف" ? "🚫" : "✅")</div>
                <div style="font-size:13px;font-weight:700;color:@(player?.PlayerStatus=="موقوف"?"#d29922":"#27ae60");margin:6px 0;">@player?.PlayerStatus</div>
                <div style="font-size:11px;color:#888;">حالة الانضباط</div>
            </div>
        </div>

        <!-- أزرار التحكم -->
        <div style="width:100%;max-width:600px;display:flex;gap:10px;">
            <button onclick="toggleSuspend(@player?.Id, '@player?.PlayerStatus')"
                    style="flex:1;padding:10px;border:none;border-radius:8px;cursor:pointer;font-family:inherit;font-size:13px;font-weight:700;background:@(player?.PlayerStatus=="موقوف"?"#e8f5e9":"#fff3cd");color:@(player?.PlayerStatus=="موقوف"?"#27ae60":"#d29922");">
                @(player?.PlayerStatus == "موقوف" ? "✅ رفع الإيقاف" : "🚫 إيقاف اللاعب")
            </button>
        </div>

        <!-- بيانات الدخول -->
        <div class="creds-box">
            <div class="creds-title">🔐 بيانات دخول اللاعب</div>
            <div class="cred-row">
                <span class="cred-label">اسم المستخدم</span>
                <span class="cred-value">@player?.Username</span>
            </div>
        </div>

        <button class="reset-btn" onclick="resetPassword(@player?.Id)">🔄 إعادة تعيين كلمة المرور تلقائياً</button>

        <div class="new-pass-box" id="newPassBox">
            <div class="np-title">✅ تم توليد كلمة مرور جديدة</div>
            <div class="np-val" id="newPassVal"></div>
            <div class="np-hint">أعطِ هذه الكلمة للاعب — سيُطلب منه تغييرها عند أول دخول</div>
        </div>

        <!-- الإحصائيات -->
        <div class="category-label">الإحصائيات الرئيسية</div>
        <div class="stats-grid">
            <div class="stat-card"><div class="stat-value">@(participations?.Count() ?? 0)</div><div class="stat-label">البطولات</div></div>
            <div class="stat-card gold"><div class="stat-value">🥇 @ViewBag.Gold</div><div class="stat-label">ذهب</div></div>
            <div class="stat-card silver"><div class="stat-value">🥈 @ViewBag.Silver</div><div class="stat-label">فضة</div></div>
            <div class="stat-card bronze"><div class="stat-value">🥉 @ViewBag.Bronze</div><div class="stat-label">برونز</div></div>
        </div>
        <div class="category-label">النقاط</div>
        <div class="stats-row2">
            <div class="stat-card highlight"><div class="stat-value">@ViewBag.TotalPoints ⭐</div><div class="stat-label">مجموع النقاط</div></div>
            <div class="stat-card"><div class="stat-value">@player?.Belt</div><div class="stat-label">درجة الحزام</div></div>
        </div>
        @if (participations != null && participations.Any())

        {
            <div class="category-label">آخر المشاركات</div>
            <div class="stats-row3">
                @foreach (var p in participations.Take(3))

                {

                    var medal = p.Rank == 1 ? "🥇" : p.Rank == 2 ? "🥈" : p.Rank == 3 ? "🥉" : "🏅";
                    <div class="stat-card"><div class="stat-value">@medal</div><div class="stat-label">@(p.Tournament?.Title ?? "—")</div></div>
                }
            </div>
        }

        <!-- سجل الإصابات -->
        <div class="category-label">🤕 سجل الإصابات</div>
        <div style="width:100%;max-width:600px;background:white;border-radius:12px;padding:20px;box-shadow:0 2px 8px rgba(0,0,0,0.06);">
            <form id="injuryForm" onsubmit="addInjury(event)">
                <input type="hidden" name="PlayerId" value="@player?.Id">
                <div style="display:grid;gap:10px;margin-bottom:16px;">
                    <div>
                        <div style="font-size:11px;color:#888;margin-bottom:4px;">وصف الإصابة *</div>
                        <input type="text" name="InjuryNote" placeholder="مثال: كسر في الرسغ الأيمن" required style="width:100%;padding:8px 10px;border:1px solid #ddd;border-radius:8px;font-family:inherit;font-size:13px;">
                    </div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
                        <div>
                            <div style="font-size:11px;color:#888;margin-bottom:4px;">تاريخ البداية *</div>
                            <input type="date" name="InjuryStart" required style="width:100%;padding:8px 10px;border:1px solid #ddd;border-radius:8px;font-family:inherit;font-size:13px;">
                        </div>
                        <div>
                            <div style="font-size:11px;color:#888;margin-bottom:4px;">تاريخ العودة المتوقع</div>
                            <input type="date" name="InjuryEnd" style="width:100%;padding:8px 10px;border:1px solid #ddd;border-radius:8px;font-family:inherit;font-size:13px;">
                        </div>
                    </div>
                    <div>
                        <div style="font-size:11px;color:#888;margin-bottom:4px;">إرفاق تقرير طبي</div>
                        <input type="file" name="Attachment" accept="image/*,.pdf" style="width:100%;padding:8px;border:1px dashed #ddd;border-radius:8px;font-size:12px;">
                    </div>
                    <button type="submit" style="padding:10px;background:#e74c3c;color:white;border:none;border-radius:8px;cursor:pointer;font-family:inherit;font-size:13px;font-weight:700;">➕ تسجيل إصابة</button>
                </div>
            </form>
            @if (ViewBag.InjuryRecords != null)
            {

                foreach (var inj in ViewBag.InjuryRecords)

                {
                    <div style="background:#fff5f5;border:1px solid #fca5a5;border-radius:10px;padding:14px;margin-bottom:10px;" id="injury-@inj.Id">
                        <div style="display:flex;justify-content:space-between;align-items:start;">
                            <div>
                                <div style="font-size:13px;font-weight:700;color:#da3633;">🤕 @inj.InjuryNote</div>
                                <div style="font-size:11px;color:#888;margin-top:4px;">من: @inj.InjuryStart.ToString("yyyy/MM/dd") @if (inj.InjuryEnd != null)
                                    {
                                        <text> — حتى: @inj.InjuryEnd.Value.ToString("yyyy/MM/dd")</text>
                                    }</div>
                                @if (!string.IsNullOrEmpty(inj.AttachmentPath))
                                {
                                    <a href="@inj.AttachmentPath" target="_blank" style="font-size:11px;color:#4a90e2;text-decoration:none;margin-top:4px;display:inline-block;">📎 عرض التقرير</a>
                                }
                            </div>
                            <button onclick="deleteInjury(@inj.Id)" style="padding:4px 10px;background:#fee2e2;color:#da3633;border:none;border-radius:6px;cursor:pointer;font-size:11px;">🗑️</button>
                        </div>
                    </div>
                }
            }
            else
            {
                <div style="text-align:center;color:#888;font-size:13px;padding:10px;">لا توجد إصابات مسجلة ✅</div>
            }
        </div>

        <!-- نتائج البطولات -->
        <div class="category-label">🏆 نتائج البطولات</div>
        <div style="width:100%;max-width:600px;background:white;border-radius:12px;padding:20px;box-shadow:0 2px 8px rgba(0,0,0,0.06);">
            <div style="display:grid;grid-template-columns:1fr 80px 80px auto;gap:8px;margin-bottom:16px;align-items:end;">
                <div>
                    <div style="font-size:11px;color:#888;margin-bottom:4px;">البطولة</div>
                    <select id="tournamentNameInput" style="width:100%;padding:8px 10px;border:1px solid #ddd;border-radius:8px;font-family:inherit;font-size:13px;">
                        <option value="">-- اختر البطولة --</option>
                        @if (ViewBag.PlayerTournaments != null)
                        {
                            foreach (var t in ViewBag.PlayerTournaments)
                            {
                                <option value="@t.Title">@t.Title</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <div style="font-size:11px;color:#888;margin-bottom:4px;">المركز</div>
                    <input type="number" id="rankInput" min="1" max="100" placeholder="1" style="width:100%;padding:8px 10px;border:1px solid #ddd;border-radius:8px;font-family:inherit;font-size:13px;">
                </div>
                <div>
                    <div style="font-size:11px;color:#888;margin-bottom:4px;">النقاط</div>
                    <input type="number" id="pointsInput" min="0" placeholder="10" style="width:100%;padding:8px 10px;border:1px solid #ddd;border-radius:8px;font-family:inherit;font-size:13px;">
                </div>
                <button onclick="addPlayerResult(@player?.Id)" style="padding:8px 16px;background:#34495e;color:white;border:none;border-radius:8px;cursor:pointer;font-family:inherit;font-size:13px;font-weight:700;">➕</button>
            </div>
            <div id="resultsTable">
                @if (ViewBag.PlayerResults != null)

                {
                    foreach (var r in ViewBag.PlayerResults)
                    {

                        var medal = r.Rank == 1 ? "🥇" : r.Rank == 2 ? "🥈" : r.Rank == 3 ? "🥉" : "🏅";
                        <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid #f5f5f5;" id="result-@r.Id">
                            <span style="font-size:13px;">@medal @r.TournamentName</span>
                            <span style="font-size:12px;color:#888;">المركز @r.Rank · @r.Points ⭐</span>
                            <button onclick="deleteResult(@r.Id)" style="padding:3px 10px;background:#fee2e2;color:#da3633;border:none;border-radius:6px;cursor:pointer;font-size:11px;">🗑️</button>
                        </div>
                    }

                }
            </div>
        </div>

        <!-- ملاحظات اللاعب -->
        <div class="category-label">📝 ملاحظات</div>
        <div style="width:100%;max-width:600px;background:white;border-radius:12px;padding:20px;box-shadow:0 2px 8px rgba(0,0,0,0.06);">
            <textarea id="playerNotes" rows="4" placeholder="أضف ملاحظاتك حول هذا اللاعب..." style="width:100%;padding:10px;border:1px solid #ddd;border-radius:8px;font-family:inherit;font-size:13px;resize:vertical;">@player?.Notes</textarea>
            <button onclick="saveNotes(@player?.Id)" style="margin-top:10px;padding:8px 20px;background:#34495e;color:white;border:none;border-radius:8px;cursor:pointer;font-family:inherit;font-size:13px;font-weight:700;">💾 حفظ الملاحظات</button>
        </div>

        <div class="footer-tag">@(player?.Gender == "أنثى" ? "Female" : "Male") Karate — @player?.Belt Belt</div>

        <!-- أزرار الطباعة والعودة -->
        <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center;">
            <button class="print-btn" onclick="window.print()">🖨️ طباعة البطاقة</button>
            <a href="/Club/Best" class="back-btn">← العودة لأفضل اللاعبين</a>
        </div>
        @if (player?.NationalTeamStatus == null || player?.NationalTeamStatus == "مرفوض")

        {
            <button onclick="requestNationalTeam(@player?.Id)" style="padding:10px 20px;background:#4a90e2;color:white;border:none;border-radius:20px;cursor:pointer;font-family:inherit;font-size:13px;font-weight:700;margin-top:10px;">🏅 طلب انضمام للمنتخب</button>
        }

        else if (player?.NationalTeamStatus == "بانتظار الموافقة")

        {
            <div style="padding:10px 20px;background:#fff3cd;color:#856404;border-radius:20px;font-size:13px;font-weight:700;margin-top:10px;">⏳ بانتظار موافقة الأدمن</div>
        }

        else if (player?.NationalTeamStatus == "موافق")

        {
            <div style="padding:10px 20px;background:#d4edda;color:#155724;border-radius:20px;font-size:13px;font-weight:700;margin-top:10px;">✅ لاعب منتخب وطني</div>
        }
    </div>

    <footer>
        <div class="footer-grid">
            <div class="footer-col brand">
                <h3>منصة الكاراتيه الفلسطينية</h3>
                <p>بناء أبطال المستقبل وتطوير رياضة الكاراتيه في فلسطين.</p>
            </div>
            <div class="footer-col">
                <h3>روابط سريعة</h3>
                <ul>
                    <li><a href="/Club/Dashboard">← الرئيسية</a></li>
                    <li><a href="/Club/Tournaments">← الأندية</a></li>
                    <li><a href="/Tournament/Index">← البطولات</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h3>تواصل معنا</h3>
                <p>📍 فلسطين، الضفة الغربية</p>
                <p style="margin-top:8px;">✉️ info@karate-ps.com</p>
            </div>
        </div>
        <div class="footer-bottom"><p>© 2025 منصة الكاراتيه الفلسطينية — جميع الحقوق محفوظة</p></div>
    </footer>

    <script>
        document.getElementById('hamburger').addEventListener('click', function () { this.classList.toggle('open'); document.getElementById('mobileMenu').classList.toggle('show'); });
        function resetPassword(playerId) {
            if (!confirm('هل أنت متأكد من إعادة تعيين كلمة المرور؟')) return;
            fetch('/Club/ResetPlayerPassword', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ playerId }) })
                .then(r => r.json()).then(data => {
                    if (data.success) {
                        document.getElementById('newPassBox').style.display = 'block';
                        document.getElementById('newPassVal').textContent = '✅ تم إرسال كلمة المرور الجديدة على إيميل اللاعب';
                    }
                });
        }
        function addPlayerResult(playerId) {
            const name = document.getElementById('tournamentNameInput').value.trim();
            const rank = parseInt(document.getElementById('rankInput').value);
            const points = parseInt(document.getElementById('pointsInput').value);
            if (!name || !rank || isNaN(points)) { alert('أدخل جميع البيانات'); return; }
            fetch('/Club/AddPlayerResult', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ playerId, tournamentName: name, rank, points }) })
                .then(r => r.json()).then(data => { if (data.success) location.reload(); else alert('حدث خطأ'); });
        }
        function deleteResult(id) {
            if (!confirm('هل أنت متأكد؟')) return;
            fetch('/Club/DeletePlayerResult?id=' + id).then(r => r.json()).then(data => { if (data.success) document.getElementById('result-' + id).remove(); });
        }
        function toggleSuspend(playerId, currentStatus) {
            const newStatus = currentStatus === 'موقوف' ? 'ملتزم' : 'موقوف';
            if (!confirm(newStatus === 'موقوف' ? 'هل أنت متأكد من إيقاف اللاعب؟' : 'هل تريد رفع الإيقاف؟')) return;
            fetch('/Club/UpdatePlayerStatus', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ playerId, playerStatus: newStatus }) })
                .then(r => r.json()).then(data => { if (data.success) location.reload(); });
        }
        function addInjury(e) {
            e.preventDefault();
            fetch('/Club/AddInjury', { method: 'POST', body: new FormData(document.getElementById('injuryForm')) })
                .then(r => r.json()).then(data => { if (data.success) location.reload(); else alert('حدث خطأ'); });
        }
        function deleteInjury(id) {
            if (!confirm('هل أنت متأكد؟')) return;
            fetch('/Club/DeleteInjury?id=' + id, { method: 'POST' }).then(r => r.json()).then(data => { if (data.success) location.reload(); });
        }
        function togglePassView(id) {
            const el = document.getElementById(id);
            el.textContent = el.textContent === '••••••••' ? el.dataset.pass : '••••••••';
        }
        function requestNationalTeam(playerId) {
            if (!confirm('هل تريد إرسال طلب انضمام هذا اللاعب للمنتخب الوطني؟')) return;
            fetch('/Club/RequestNationalTeam', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ playerId }) })
                .then(r => r.json()).then(data => { if (data.success) { alert('✅ تم إرسال الطلب للإدارة'); location.reload(); } });
        }
        function saveNotes(playerId) {
            const notes = document.getElementById('playerNotes').value;
            fetch('/Club/UpdatePlayerNotes', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ playerId, notes }) })
                .then(r => r.json()).then(data => {
                    if (data.success) { const t = document.createElement('div'); t.style.cssText = 'position:fixed;top:20px;left:50%;transform:translateX(-50%);background:#e8f5e9;border:1px solid #27ae60;color:#27ae60;padding:12px 24px;border-radius:10px;font-weight:700;z-index:9999;'; t.textContent = '✅ تم حفظ الملاحظات'; document.body.appendChild(t); setTimeout(() => t.remove(), 2500); }
                });
        }
    </script>
</body>
</html>
