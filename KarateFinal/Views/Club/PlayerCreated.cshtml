@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/png" href="/image/www.png">
    <title>تم إضافة اللاعب</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; font-family:'Segoe UI',sans-serif; }
        body { background:#eef3f8; display:flex; align-items:center; justify-content:center; min-height:100vh; }
        .card { background:white; border-radius:16px; padding:40px 36px; max-width:440px; width:90%; text-align:center; box-shadow:0 10px 30px rgba(0,0,0,0.1); }
        .icon { font-size:60px; margin-bottom:16px; }
        h2 { color:#2c3e50; font-size:22px; margin-bottom:8px; }
        .sub { color:#888; font-size:14px; margin-bottom:28px; }
        .creds-box { background:#f8fafc; border:1px solid #e2e8f0; border-radius:12px; padding:20px; margin-bottom:24px; text-align:right; }
        .creds-title { font-size:13px; font-weight:700; color:#2c3e50; margin-bottom:14px; text-align:center; }
        .cred-row { display:flex; justify-content:space-between; align-items:center; padding:10px 0; border-bottom:1px solid #f0f0f0; }
        .cred-row:last-child { border-bottom:none; }
        .cred-label { color:#888; font-size:13px; }
        .cred-value { font-weight:700; color:#2c3e50; font-family:monospace; font-size:15px; background:#e8f4fd; padding:4px 10px; border-radius:6px; }
        .warning { background:#fff8e1; border:1px solid #ffd54f; border-radius:8px; padding:12px; font-size:13px; color:#8b6914; margin-bottom:24px; }
        .btn { display:inline-block; padding:12px 30px; background:#34495e; color:white; text-decoration:none; border-radius:25px; font-size:14px; font-weight:bold; transition:0.3s; }
        .btn:hover { background:#4a90e2; }
    </style>
<link rel="stylesheet" href="/css/dark.css"><script src="/js/site.js"></script></head>
<body>
    <div class="card">
        <div class="icon">✅</div>
        <h2>تم إضافة اللاعب بنجاح!</h2>
        <p class="sub">بيانات دخول اللاعب <strong>@ViewBag.PlayerName</strong></p>

        <div class="creds-box">
            <div class="creds-title">🔐 بيانات الدخول</div>
            <div class="cred-row">
                <span class="cred-label">اسم المستخدم</span>
                <span class="cred-value">@ViewBag.PlayerUsername</span>
            </div>
            <div class="cred-row">
                <span class="cred-label">كلمة المرور</span>
                <span class="cred-value">@ViewBag.PlayerPassword</span>
            </div>
        </div>

        <div class="warning">
            ⚠️ احفظ هاي البيانات الآن — سيُطلب من اللاعب تغيير كلمة المرور عند أول دخول
        </div>

        <a href="/Club/Dashboard" class="btn">← العودة للوحة النادي</a>
    </div>
</body>
</html>