@{
    var db = ViewContext.HttpContext.RequestServices.GetRequiredService<KarateFinal.Data.KarateContext>();
    var site = db.SiteSettings.FirstOrDefault();
    var siteName = site?.SiteName ?? "منصة الكاراتيه الفلسطينية";
}
<style>
    footer {
        background: linear-gradient(135deg, #0d1117, #1a2535) !important;
        color: #e6edf3 !important;
        padding: 48px 40px 24px;
        border-top: 3px solid #4a90e2;
        margin-top: auto;
    }

    .footer-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr;
        gap: 32px;
        max-width: 1200px;
        margin: 0 auto 32px;
    }

    .footer-col h3 {
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 14px;
        color: #4a90e2 !important;
    }

    .footer-col.brand h3 {
        color: white !important;
        font-size: 18px;
    }

    .footer-col p {
        font-size: 13px;
        color: #8b949e !important;
        line-height: 1.7;
        margin-bottom: 16px;
    }

    .footer-col ul {
        list-style: none;
    }

        .footer-col ul li {
            margin-bottom: 8px;
        }

            .footer-col ul li a {
                color: #8b949e !important;
                text-decoration: none;
                font-size: 13px;
                transition: 0.2s;
            }

                .footer-col ul li a:hover {
                    color: #4a90e2 !important;
                }

    .social-links {
        display: flex;
        gap: 10px;
    }

        .social-links a {
            width: 36px;
            height: 36px;
            background: rgba(74,144,226,0.15);
            border: 1px solid rgba(74,144,226,0.3);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #4a90e2 !important;
            text-decoration: none;
            font-size: 13px;
            font-weight: 700;
            transition: 0.2s;
        }

            .social-links a:hover {
                background: #4a90e2 !important;
                color: white !important;
            }

    .contact-item {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
        font-size: 13px;
        color: #8b949e !important;
    }

    .contact-icon {
        width: 32px;
        height: 32px;
        background: rgba(74,144,226,0.15);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }

    .footer-bottom {
        border-top: 1px solid #21262d;
        padding-top: 20px;
        text-align: center;
    }

        .footer-bottom p {
            color: #6b7280 !important;
            font-size: 12px;
            margin: 0;
        }

    footer span {
        color: #8b949e !important;
    }

    @@media(max-width:768px) {
        .footer-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media(max-width:480px) {
        .footer-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
<footer>
    <div class="footer-grid">
        <div class="footer-col brand">
            <h3>@siteName</h3>
            <p>بناء أبطال المستقبل وتطوير رياضة الكاراتيه في فلسطين من خلال التدريب والمنافسة.</p>
            <div class="social-links">
                <a href="#">f</a><a href="#">in</a><a href="#">ig</a>
            </div>
        </div>
        <div class="footer-col">
            <h3>روابط سريعة</h3>
            <ul>
                <li><a href="/Home/Index">← الرئيسية</a></li>
                <li><a href="/Club/Index">← الأندية</a></li>
                <li><a href="/Account/Login">← تسجيل دخول</a></li>
            </ul>
        </div>
        <div class="footer-col">
            <h3>خدماتنا</h3>
            <ul>
                <li><a href="/Account/Login">تسجيل اللاعبين</a></li>
                <li><a href="/Account/Login">إدارة البطولات</a></li>
                <li><a href="/Account/Login">متابعة النتائج</a></li>
                <li><a href="/Account/Login">الاستحقاقات</a></li>
            </ul>
        </div>
        <div class="footer-col">
            <h3>تواصل معنا</h3>
            <div class="contact-item"><div class="contact-icon">📍</div><span>فلسطين، الضفة الغربية</span></div>
            <div class="contact-item"><div class="contact-icon">📞</div><span style="direction:ltr;">+970 59X XXX XXXX</span></div>
            <div class="contact-item"><div class="contact-icon">✉️</div><span>info@karate-ps.com</span></div>
        </div>
    </div>
    <div class="footer-bottom"><p>© 2026 @siteName — جميع الحقوق محفوظة</p></div>
</footer>