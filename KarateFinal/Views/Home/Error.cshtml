@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>خطأ — منصة الكاراتيه</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; font-family:'Segoe UI',Tahoma,sans-serif; }
        body { background:#0f1923; color:white; display:flex; align-items:center; justify-content:center; min-height:100vh; }
        .box { text-align:center; padding:40px; }
        .icon { font-size:80px; margin-bottom:20px; }
        h2 { font-size:28px; font-weight:900; margin-bottom:12px; }
        p { color:#94a3b8; font-size:15px; margin-bottom:30px; line-height:1.7; }
        .btn { padding:12px 28px; background:#3b82f6; color:white; text-decoration:none; border-radius:8px; font-weight:700; font-size:15px; transition:0.3s; }
        .btn:hover { background:#2563eb; }
    </style>
<link rel="stylesheet" href="/css/dark.css"><script>function applyTheme(t){const l=t==='light';document.body.style.setProperty('background',l?'#f0f4f8':'#0f1923','important');document.body.style.setProperty('color',l?'#1e2a38':'#f1f5f9','important');document.querySelectorAll('.theme-btn').forEach(b=>b.textContent=l?'☀️':'🌙');localStorage.setItem('theme',t);}<script>
<body>
    <div class="box">
        <div class="icon">⚠️</div>
        <h2>حدث خطأ غير متوقع</h2>
        <p>نعمل على إصلاح المشكلة<br>حاول مرة أخرى لاحقاً</p>
        <a href="/Home/Index" class="btn">🏠 العودة للرئيسية</a>
    </div>
</body>
</html>