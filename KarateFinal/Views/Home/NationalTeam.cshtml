@{
    Layout = null;
    var players = ViewBag.Players as List<KarateFinal.Models.Player>;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لاعبو المنتخب — منصة الكاراتيه الفلسطينية</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Cairo',sans-serif;
        }

        body {
            background: #0f1923;
            color: #f1f5f9;
            min-height: 100vh;
        }

        nav {
            background: #1e2a38;
            padding: 14px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 3px solid #4a90e2;
        }

            nav a {
                color: white;
                text-decoration: none;
                font-size: 14px;
                font-weight: 700;
            }

        .page-title {
            text-align: center;
            padding: 40px 20px 10px;
            font-size: 28px;
            font-weight: 800;
        }

        .page-sub {
            text-align: center;
            color: #94a3b8;
            font-size: 14px;
            margin-bottom: 32px;
        }

        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill,minmax(200px,1fr));
            gap: 20px;
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 20px 40px;
        }

        .player-card {
            background: #1a2535;
            border: 1px solid #2d3f55;
            border-radius: 16px;
            padding: 20px;
            text-align: center;
            transition: 0.2s;
            cursor: pointer;
        }

            .player-card:hover {
                border-color: #4a90e2;
                transform: translateY(-3px);
            }

        .player-img {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid #4a90e2;
            margin: 0 auto 12px;
            display: block;
        }

        .player-placeholder {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            border: 3px solid #4a90e2;
            margin: 0 auto 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            background: #223044;
        }

        .player-name {
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .player-club {
            font-size: 12px;
            color: #94a3b8;
            margin-bottom: 12px;
        }

        .details-btn {
            display: block;
            width: 100%;
            padding: 8px;
            background: #4a90e2;
            color: white;
            border: none;
            border-radius: 8px;
            font-family: inherit;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
        }

        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.8);
            z-index: 1000;
            align-items: center;
            justify-content: center;
            padding: 16px;
        }

            .modal-overlay.show {
                display: flex;
            }

        .modal {
            background: #1a2535;
            border: 1px solid #2d3f55;
            border-radius: 16px;
            width: 480px;
            max-width: 95%;
            max-height: 85vh;
            overflow-y: auto;
            padding: 24px;
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }

        .modal-close {
            background: none;
            border: none;
            color: #94a3b8;
            cursor: pointer;
            font-size: 22px;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid #2d3f55;
            font-size: 13px;
        }

        .info-label {
            color: #94a3b8;
        }

        .results-title {
            font-size: 13px;
            font-weight: 700;
            color: #4a90e2;
            margin: 16px 0 8px;
        }

        .result-item {
            background: #223044;
            border-radius: 8px;
            padding: 10px 12px;
            margin-bottom: 8px;
            font-size: 12px;
        }

        .empty {
            grid-column: 1/-1;
            text-align: center;
            color: #94a3b8;
            padding: 60px;
        }
    </style>
</head>
<body>
    <nav>
        <a href="/Home/Index">🏠 الرئيسية</a>
        <span style="color:#4a90e2;font-weight:800;">🥋 المنتخب الوطني</span>
        <a href="/Account/Login">تسجيل دخول</a>
    </nav>
    <div class="page-title">🥋 لاعبو المنتخب الفلسطيني للكاراتيه</div>
    <div class="page-sub">أبطال فلسطين في رياضة الكاراتيه 🇵🇸</div>
    <div class="cards-grid">
        @if (players != null && players.Any())
        {
            foreach (var p in players)
            {
                <div class="player-card" onclick="showDetails(@p.Id)">
                    @if (!string.IsNullOrEmpty(p.ProfileImage))
                    {
                        <img src="data:image/jpeg;base64,@p.ProfileImage" class="player-img">
                    }
                    else
                    {
                        <div class="player-placeholder">👤</div>
                    }
                    <div class="player-name">@p.Name</div>
                    <div class="player-club">🏟️ @(p.Club?.Name ?? "—")</div>
                    <button class="details-btn">تفاصيل اللاعب</button>
                </div>
            }
        }
        else
        {
            <div class="empty">لا يوجد لاعبون في المنتخب حالياً</div>
        }
    </div>
    <div class="modal-overlay" id="detailsModal" onclick="if(event.target===this)closeModal()">
        <div class="modal">
            <div class="modal-header">
                <h3 style="font-size:16px;font-weight:700;" id="modalName">...</h3>
                <button class="modal-close" onclick="closeModal()">×</button>
            </div>
            <div id="modalBody"></div>
        </div>
    </div>
    @await Html.PartialAsync("_Footer")
    <script>
        function showDetails(id) {
            document.getElementById('modalName').textContent = '...';
            document.getElementById('modalBody').innerHTML = '<div style="text-align:center;padding:20px;">⏳ جاري التحميل...</div>';
            document.getElementById('detailsModal').classList.add('show');
            fetch('/Home/PlayerDetails?id=' + id)
                .then(r => r.json()).then(data => {
                    document.getElementById('modalName').textContent = data.name;
                    let html = `
                                <div class="info-row"><span class="info-label">النادي</span><span style="font-weight:700;">${data.club}</span></div>
                                <div class="info-row"><span class="info-label">الفئة العمرية</span><span style="font-weight:700;">${data.category}</span></div>
                                <div class="info-row"><span class="info-label">الحزام</span><span style="font-weight:700;">${data.belt}</span></div>
                                <div class="info-row"><span class="info-label">إجمالي النقاط</span><span style="font-weight:700;color:#f59e0b;">${data.totalPoints} ⭐</span></div>
                                <div class="results-title">🏆 البطولات المشارك فيها</div>
                            `;
                    if (data.results && data.results.length > 0) {
                        data.results.forEach(r => {
                            html += `<div class="result-item"><strong>${r.tournament}</strong><br><span style="color:#94a3b8;">المركز: ${r.rank} — النقاط: ${r.points} ⭐</span></div>`;
                        });
                    } else {
                        html += '<div style="color:#94a3b8;text-align:center;padding:20px;">لا توجد نتائج مسجّلة بعد</div>';
                    }
                    document.getElementById('modalBody').innerHTML = html;
                });
        }
        function closeModal() {
            document.getElementById('detailsModal').classList.remove('show');
        }
    </script>
</body>
</html>