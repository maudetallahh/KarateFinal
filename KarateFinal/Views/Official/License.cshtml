@{
    Layout = null;
    var official = ViewBag.Official as KarateFinal.Models.Official;
    var officialRole = Context.Session.GetString("OfficialRole");
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الترخيص</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; font-family:'Segoe UI',Tahoma,sans-serif; }
        body { background:#eef3f8; min-height:100vh; }
        nav { background:#1e2a38; color:white; padding:14px 24px; display:flex; justify-content:center; align-items:center; border-bottom:4px solid #4a90e2; position:sticky; top:0; z-index:100; }
        .nav-header { text-align:center; }
        .nav-header h1 { font-size:20px; color:#fff; }
        nav ul { position:absolute; left:24px; display:flex; list-style:none; gap:16px; }
        nav ul li a { color:white; text-decoration:none; font-size:13px; font-weight:bold; }
        .logout-btn { background:#2c3e50; padding:7px 18px; border-radius:5px; }
        .container { max-width:600px; margin:30px auto; padding:0 20px; }
        .card { background:white; border-radius:16px; padding:28px; box-shadow:0 2px 8px rgba(0,0,0,0.06); }
        .card-title { font-size:18px; font-weight:800; color:#1e2a38; margin-bottom:20px; }
        .license-status { text-align:center; padding:20px; margin-bottom:20px; border-radius:12px; }
        .status-valid { background:#d4edda; border:1px solid #28a745; }
        .status-expired { background:#f8d7da; border:1px solid #dc3545; }
        .status-unknown { background:#fff3cd; border:1px solid #ffc107; }
        .status-icon { font-size:40px; margin-bottom:8px; }
        .status-text { font-size:16px; font-weight:700; }
        .status-date { font-size:13px; color:#666; margin-top:4px; }
        .form-group { margin-bottom:16px; }
        .form-group label { font-size:12px; font-weight:700; color:#666; display:block; margin-bottom:4px; }
        .form-group input { width:100%; padding:10px; border:1px solid #ddd; border-radius:8px; font-family:inherit; font-size:13px; }
        .submit-btn { width:100%; padding:12px; background:#4a90e2; color:white; border:none; border-radius:10px; font-family:inherit; font-size:14px; font-weight:700; cursor:pointer; margin-top:8px; }
        .submit-btn:hover { background:#1e6fc4; }
        .alert { padding:12px 16px; border-radius:8px; margin-bottom:16px; font-size:13px; }
        .alert-success { background:#d4edda; color:#155724; border:1px solid #28a745; }
    </style>
<link rel="stylesheet" href="/css/dark.css"><script>function applyTheme(t){const l=t==='light';document.body.style.setProperty('background',l?'#f0f4f8':'#0f1923','important');document.body.style.setProperty('color',l?'#1e2a38':'#f1f5f9','important');document.querySelectorAll('.theme-btn').forEach(b=>b.textContent=l?'☀️':'🌙');localStorage.setItem('theme',t);}function toggleTheme(){applyTheme(localStorage.getItem('theme')==='light'?'dark':'light');}document.addEventListener('DOMContentLoaded',()=>applyTheme(localStorage.getItem('theme')||'dark'));</script></head>
<body>
    <nav>
        <div class="nav-header"><h1>منصة الكاراتيه الفلسطينية</h1></div>
        <ul>
            <li><a href="/Official/Dashboard">← الرئيسية</a></li>
            
            <li><a href="/Account/Logout" class="logout-btn">تسجيل خروج</a></li>
        </ul>
    </nav>
    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">✅ @TempData["Success"]</div>
        }
        <div class="card">
            <div class="card-title">📜 شهادة @(officialRole == "حكم" ? "التحكيم" : "التدريب")</div>
            @{
                var expiry = official?.LicenseExpiry;
                var isValid = expiry.HasValue && expiry.Value > DateTime.UtcNow;
                var isUnknown = !expiry.HasValue;
            }
            <div class="license-status @(isUnknown ? "status-unknown" : isValid ? "status-valid" : "status-expired")">
                <div class="status-icon">@(isUnknown ? "⚠️" : isValid ? "✅" : "❌")</div>
                <div class="status-text">@(isUnknown ? "لم يتم تحديد تاريخ الترخيص" : isValid ? "الترخيص ساري" : "الترخيص منتهي")</div>
                @if (expiry.HasValue)
                {
                    <div class="status-date">تاريخ الانتهاء: @expiry.Value.ToString("yyyy/MM/dd")</div>
                }
            </div>
            <form method="post" action="/Official/UpdateLicense" enctype="multipart/form-data">
                <div class="form-group">
                    <label>تاريخ انتهاء الترخيص الجديد *</label>
                    <input type="date" name="LicenseExpiry" required>
                </div>
                <div class="form-group">
                    <label>رفع نسخة الشهادة (PDF أو صورة)</label>
                    <input type="file" name="LicenseFile" accept="image/*,.pdf">
                </div>
                <button type="submit" class="submit-btn">💾 تجديد الترخيص</button>
            </form>
        </div>
    </div>
@await Html.PartialAsync("_Footer")</body>
</html>