@{
    Layout = null;
    var officials = ViewBag.Officials as IEnumerable<dynamic>;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة المسؤولين</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; font-family:'Segoe UI',Tahoma,sans-serif; }
        body { background:#0f1923; color:#f1f5f9; min-height:100vh; padding:24px; }
        h1 { font-size:20px; font-weight:800; margin-bottom:20px; }
        .back-btn { display:inline-block; background:#1a2535; color:#94a3b8; border:1px solid #2d3f55; padding:8px 16px; border-radius:8px; text-decoration:none; font-size:12px; margin-bottom:20px; }
        table { width:100%; border-collapse:collapse; background:#1a2535; border-radius:12px; overflow:hidden; }
        thead th { padding:12px 16px; font-size:11px; color:#94a3b8; text-align:right; background:#223044; border-bottom:1px solid #2d3f55; }
        tbody tr { border-bottom:1px solid #2d3f55; }
        tbody tr:hover { background:rgba(255,255,255,0.03); }
        tbody td { padding:12px 16px; font-size:12px; }
        .badge { display:inline-block; padding:2px 8px; border-radius:20px; font-size:10px; font-weight:700; }
        .pending { background:rgba(245,158,11,0.15); color:#f59e0b; border:1px solid rgba(245,158,11,0.3); }
        .approved { background:rgba(16,185,129,0.15); color:#10b981; border:1px solid rgba(16,185,129,0.3); }
        .rejected { background:rgba(239,68,68,0.15); color:#ef4444; border:1px solid rgba(239,68,68,0.3); }
        .btn { padding:5px 12px; border:none; border-radius:6px; cursor:pointer; font-size:11px; font-weight:700; font-family:inherit; }
        .btn-approve { background:rgba(16,185,129,0.2); color:#10b981; }
        .btn-reject { background:rgba(239,68,68,0.2); color:#ef4444; }
    </style>
</head>
<body>
    <a href="/Admin/Index" class="back-btn">← العودة للأدمن</a>
    <h1>👤 إدارة المسؤولين والكوادر الفنية</h1>
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>الاسم</th>
                <th>النادي</th>
                <th>الدور</th>
                <th>العمر</th>
                <th>الجنس</th>
                <th>التصنيف</th>
                <th>التخصص</th>
                <th>الدرجة</th>
                <th>الحالة</th>
                <th>إجراءات</th>
            </tr>
        </thead>
        <tbody>
            @if (officials != null)
            {
                int i = 1;
                foreach (var o in officials)
                {
                    <tr>
                        <td>@i</td>
                        <td>@o.Name</td>
                        <td>@o.ClubName</td>
                        <td>@o.Role</td>
                        <td>@o.Age</td>
                        <td>@o.Gender</td>
                        <td>@(o.Classification ?? "—")</td>
                        <td>@(o.Specialty ?? "—")</td>
                        <td>@(o.Degree ?? "—")</td>
                        <td><span class="badge @(o.Status == "موافق" ? "approved" : o.Status == "مرفوض" ? "rejected" : "pending")">@o.Status</span></td>
                        <td style="display:flex;gap:6px;">
                            @if (o.Status == "بانتظار الموافقة")
                            {
                                <button class="btn btn-approve" onclick="approve(@o.Id)">✅ موافقة</button>
                                <button class="btn btn-reject" onclick="reject(@o.Id)">❌ رفض</button>
                            }
                        </td>
                    </tr>
                    i++;
                }
            }
        </tbody>
    </table>
    <script>
        function approve(id) {
            fetch('/Official/Approve', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({id, status:'موافق', note:''}) })
                .then(r => r.json()).then(d => { if(d.success) location.reload(); });
        }
        function reject(id) {
            const note = prompt('سبب الرفض:');
            if (note === null) return;
            fetch('/Official/Approve', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({id, status:'مرفوض', note}) })
                .then(r => r.json()).then(d => { if(d.success) location.reload(); });
        }
    </script>
</body>
</html>