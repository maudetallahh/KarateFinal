@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/png" href="/image/www.png">
    <title>تغيير كلمة المرور</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body { font-family:'Segoe UI',sans-serif; background:#0d1117; min-height:100vh; display:flex; align-items:center; justify-content:center; }
        .card { background:#161b22; border:1px solid #2a2f3a; border-radius:16px; padding:36px 32px; width:100%; max-width:420px; }
        .brand { text-align:center; margin-bottom:28px; }
        .brand span { font-size:3rem; display:block; margin-bottom:10px; }
        .brand h1 { color:white; font-size:1.3rem; }
        .brand p { color:#666; font-size:0.85rem; margin-top:6px; }
        .field { display:flex; flex-direction:column; gap:7px; margin-bottom:18px; }
        .field label { color:#ccc; font-size:0.85rem; font-weight:600; }
        .input-wrap { position:relative; }
        .input-wrap input { width:100%; padding:12px 14px 12px 40px; background:#0d1117; border:1.5px solid #2a2f3a; border-radius:9px; color:white; font-size:0.92rem; }
        .input-wrap input:focus { outline:none; border-color:#4a90e2; }
        .toggle-pass { position:absolute; left:13px; top:50%; transform:translateY(-50%); cursor:pointer; font-size:1rem; user-select:none; opacity:0.6; transition:0.2s; }
        .toggle-pass:hover { opacity:1; }
        .btn { width:100%; padding:13px; background:#34495e; color:white; border:none; border-radius:9px; font-size:1rem; font-weight:bold; cursor:pointer; margin-top:8px; }
        .btn:hover { background:#4a90e2; }
        .error { background:#2d1a1a; color:#f85149; border:1px solid #6e2020; border-radius:8px; padding:10px; margin-bottom:16px; font-size:0.85rem; }
        .info-box { background:rgba(74,144,226,0.1); border:1px solid rgba(74,144,226,0.3); color:#81b3f7; border-radius:8px; padding:12px; margin-bottom:20px; font-size:13px; }
        .strength-bar-wrap { height:5px; background:#2a2f3a; border-radius:4px; margin-top:6px; overflow:hidden; }
        .strength-bar { height:100%; width:0; border-radius:4px; transition:0.3s; }
        .strength-text { font-size:11px; margin-top:4px; }
        .req-list { margin-top:8px; display:flex; flex-direction:column; gap:4px; }
        .req-item { font-size:12px; color:#666; transition:0.2s; }
        .req-item.ok { color:#3fb950; }
    </style>
</head>
<body>
    <div class="card">
        <div class="brand">
            <span>🔐</span>
            <h1>تغيير كلمة المرور</h1>
            <p>يجب تغيير كلمة المرور قبل المتابعة</p>
        </div>
        <div class="info-box">
            ⚠️ هذه أول مرة تسجل دخولك. يرجى تعيين كلمة مرور جديدة خاصة بك.
        </div>
        @if(ViewBag.Error != null){
            <div class="error">❌ @ViewBag.Error</div>
        }
        <form method="post">
            <div class="field">
                <label>كلمة المرور الجديدة</label>
                <div class="input-wrap">
                    <input type="password" name="newPassword" id="pass1"
                           placeholder="أدخل كلمة مرور جديدة" required
                           oninput="checkPassword(this.value)">
                    <span class="toggle-pass" onclick="togglePass('pass1', this)">👁️</span>
                </div>
                <div class="strength-bar-wrap">
                    <div class="strength-bar" id="strengthBar"></div>
                </div>
                <div class="strength-text" id="strengthText"></div>
                <div class="req-list">
                    <div class="req-item" id="req1">❌ 8 أحرف على الأقل</div>
                    <div class="req-item" id="req2">❌ حرف كبير واحد على الأقل</div>
                    <div class="req-item" id="req3">❌ رقم واحد على الأقل</div>
                    <div class="req-item" id="req4">❌ رمز خاص واحد على الأقل (!@@#$%^&*)</div>
                </div>
            </div>
            <div class="field">
                <label>تأكيد كلمة المرور</label>
                <div class="input-wrap">
                    <input type="password" name="confirmPassword" id="pass2"
                           placeholder="أعد إدخال كلمة المرور" required>
                    <span class="toggle-pass" onclick="togglePass('pass2', this)">👁️</span>
                </div>
            </div>
            <button type="submit" class="btn">✅ حفظ وتسجيل الدخول</button>
        </form>
    </div>
    <script>
        function togglePass(inputId, icon) {
            const input = document.getElementById(inputId);
            if (input.type === 'password') {
                input.type = 'text'; icon.textContent = '🙈'; icon.style.opacity = '1';
            } else {
                input.type = 'password'; icon.textContent = '👁️'; icon.style.opacity = '0.6';
            }
        }

        function checkPassword(val) {
            const r1 = val.length >= 8;
            const r2 = /[A-Z]/.test(val);
            const r3 = /[0-9]/.test(val);
            const r4 = /[!@@#$%^&*]/.test(val);
            setReq('req1', r1, '8 أحرف على الأقل');
            setReq('req2', r2, 'حرف كبير واحد على الأقل');
            setReq('req3', r3, 'رقم واحد على الأقل');
            setReq('req4', r4, 'رمز خاص واحد على الأقل');
            const score = [r1, r2, r3, r4].filter(Boolean).length;
            const bar = document.getElementById('strengthBar');
            const text = document.getElementById('strengthText');
            const colors = ['#da3633', '#e67e22', '#f1c40f', '#2ea043'];
            const labels = ['ضعيفة', 'متوسطة', 'جيدة', 'قوية'];
            bar.style.width = (score * 25) + '%';
            bar.style.background = score > 0 ? colors[score - 1] : '#2a2f3a';
            text.style.color = score > 0 ? colors[score - 1] : '#666';
            text.textContent = score > 0 ? 'قوة كلمة المرور: ' + labels[score - 1] : '';
        }

        function setReq(id, ok, text) {
            const el = document.getElementById(id);
            el.textContent = (ok ? '✅' : '❌') + ' ' + text;
            el.className = 'req-item' + (ok ? ' ok' : '');
        }
    </script>
</body>
</html>
