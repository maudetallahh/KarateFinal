@{
    Layout = null;
    var messages = ViewBag.Messages as List<KarateFinal.Models.Message>;
    var player = ViewBag.Player as KarateFinal.Models.Player;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>المراسلات</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; font-family:'Segoe UI',Tahoma,sans-serif; }
        body { background:#eef3f8; min-height:100vh; display:flex; flex-direction:column; }
        nav { background:#1e2a38; color:white; padding:14px 24px; display:flex; justify-content:center; align-items:center; border-bottom:4px solid #4a90e2; position:sticky; top:0; z-index:100; }
        .nav-header { text-align:center; }
        .nav-header h1 { font-size:20px; color:#fff; }
        nav ul { position:absolute; left:24px; display:flex; list-style:none; gap:16px; }
        nav ul li a { color:white; text-decoration:none; font-size:13px; font-weight:bold; }
        .logout-btn { background:#2c3e50; padding:7px 18px; border-radius:5px; }
        .chat-container { max-width:700px; margin:24px auto; padding:0 20px; flex:1; display:flex; flex-direction:column; width:100%; }
        .chat-title { font-size:20px; font-weight:800; color:#1e2a38; margin-bottom:16px; }
        .messages-box { background:white; border-radius:16px; padding:20px; flex:1; min-height:400px; max-height:500px; overflow-y:auto; margin-bottom:16px; box-shadow:0 2px 8px rgba(0,0,0,0.06); display:flex; flex-direction:column; gap:12px; }
        .msg { max-width:75%; padding:12px 16px; border-radius:12px; font-size:13px; line-height:1.5; }
        .msg.player { background:#4a90e2; color:white; align-self:flex-end; border-radius:12px 12px 4px 12px; }
        .msg.other { background:#f0f4f8; color:#1e2a38; align-self:flex-start; border-radius:12px 12px 12px 4px; }
        .msg-time { font-size:10px; opacity:0.7; margin-top:4px; }
        .msg-sender { font-size:10px; font-weight:700; margin-bottom:4px; opacity:0.8; }
        .input-area { background:white; border-radius:16px; padding:16px; box-shadow:0 2px 8px rgba(0,0,0,0.06); display:flex; gap:10px; }
        .input-area textarea { flex:1; padding:10px; border:1px solid #ddd; border-radius:8px; font-family:inherit; font-size:13px; resize:none; height:60px; }
        .send-btn { padding:10px 20px; background:#4a90e2; color:white; border:none; border-radius:8px; cursor:pointer; font-family:inherit; font-size:13px; font-weight:700; }
        .empty { text-align:center; color:#888; padding:40px; font-size:14px; }
    </style>
<link rel="stylesheet" href="/css/dark.css"><script>function applyTheme(t){const l=t==='light';document.body.style.setProperty('background',l?'#f0f4f8':'#0f1923','important');document.body.style.setProperty('color',l?'#1e2a38':'#f1f5f9','important');document.querySelectorAll('.theme-btn').forEach(b=>b.textContent=l?'☀️':'🌙');localStorage.setItem('theme',t);}function toggleTheme(){applyTheme(localStorage.getItem('theme')==='light'?'dark':'light');}document.addEventListener('DOMContentLoaded',()=>applyTheme(localStorage.getItem('theme')||'dark'));</script></head>
<body>
    <nav>
        <div class="nav-header"><h1>منصة الكاراتيه الفلسطينية</h1></div>
        <ul>
            <li><a href="/Player/Dashboard">← الرئيسية</a></li>
            <button onclick="toggleTheme()" class="theme-btn" style="background:rgba(255,255,255,0.1);border:none;color:white;padding:6px 12px;border-radius:8px;cursor:pointer;font-size:16px;">🌙</button>
            <li><a href="/Account/Logout" class="logout-btn">تسجيل خروج</a></li>
        </ul>
    </nav>
    <div class="chat-container">
        <div class="chat-title">💬 المراسلات مع النادي</div>
        <div class="messages-box" id="messagesBox">
            @if (messages != null && messages.Any())
            {
                foreach (var m in messages)
                {
                    var isPlayer = m.SenderRole == "Player";
                    var senderName = isPlayer ? "أنت" : m.SenderRole == "Admin" ? "الإدارة" : "النادي";
                    <div class="msg @(isPlayer ? "player" : "other")">
                        <div class="msg-sender">@senderName</div>
                        @m.Content
                        <div class="msg-time">@m.SentAt.ToString("yyyy/MM/dd HH:mm")</div>
                    </div>
                }
            }
            else
            {
                <div class="empty">لا توجد رسائل بعد</div>
            }
        </div>
        <div class="input-area">
            <textarea id="msgInput" placeholder="اكتب رسالتك للنادي..."></textarea>
            <button class="send-btn" onclick="sendMessage()">إرسال ✉️</button>
        </div>
    </div>
    <script>
        document.getElementById('messagesBox').scrollTop = document.getElementById('messagesBox').scrollHeight;
        function sendMessage() {
            const content = document.getElementById('msgInput').value.trim();
            if (!content) return;
            fetch('/Player/SendMessage', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ content }) })
                .then(r => r.json()).then(data => { if (data.success) { document.getElementById('msgInput').value = ''; location.reload(); } });
        }
        document.getElementById('msgInput').addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
        });
    </script>
@await Html.PartialAsync("_Footer")</body>
</html>